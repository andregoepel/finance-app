<Project>
  <PropertyGroup>
    <Authors>André Göpel</Authors>
    <Copyright>© André Göpel</Copyright>
    <RepositoryUrl>https://github.com/andregoepel/finance-app</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Generate and honour packages.lock.json so restores are reproducible and
         tamper-evident; CI restores in locked mode to fail on any drift. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
</Project>
