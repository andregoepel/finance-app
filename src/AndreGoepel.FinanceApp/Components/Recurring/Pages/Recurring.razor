@page "/recurring"
@attribute [Authorize]
@rendermode InteractiveServer
@using AndreGoepel.FinanceApp.Domain.Recurring
@using AndreGoepel.FinanceApp.Insights

@inject IRecurringService RecurringService
@inject IMessageBus MessageBus
@inject NotificationService NotificationService

<PageTitle>Recurring – Finance</PageTitle>

<div class="rz-p-4 rz-p-md-6">
    <RadzenStack Gap="1.5rem">

        <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1">Recurring</RadzenText>
        <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color);">
            Detected subscriptions and other regular payments or income, based on repeating
            counterparties with a consistent interval and amount.
        </RadzenText>

        @if (series is null)
        {
            <RadzenText>Loading…</RadzenText>
        }
        else if (series.Count == 0)
        {
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                    No recurring payments detected yet — this needs a few months of transactions.
                </RadzenText>
            </RadzenCard>
        }
        else
        {
            <RadzenCard>
                <RadzenDataGrid TItem="RecurringSeries" Data=@series Density="Density.Compact"
                                AllowSorting="true" AllowPaging="true" PageSize="20">
                    <Columns>
                        <RadzenDataGridColumn TItem="RecurringSeries" Property="Counterparty" Title="Counterparty" />
                        <RadzenDataGridColumn TItem="RecurringSeries" Property="Interval" Title="Interval" Width="110px" />
                        <RadzenDataGridColumn TItem="RecurringSeries" Property="TypicalAmount" Title="Typical amount" Width="140px" TextAlign="TextAlign.Right">
                            <Template Context="row">
                                <span style="@(row.TypicalAmount < 0 ? "color: var(--rz-danger);" : "color: var(--rz-success);")">
                                    @($"{row.TypicalAmount:N2} €")
                                </span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="RecurringSeries" Property="Occurrences" Title="Seen" Width="70px" TextAlign="TextAlign.Right" />
                        <RadzenDataGridColumn TItem="RecurringSeries" Property="LastSeen" Title="Last" Width="120px">
                            <Template Context="row">@row.LastSeen.ToString("dd.MM.yyyy")</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="RecurringSeries" Property="NextExpected" Title="Next expected" Width="130px">
                            <Template Context="row">@row.NextExpected.ToString("dd.MM.yyyy")</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="RecurringSeries" Title="" Width="140px" TextAlign="TextAlign.End">
                            <Template Context="row">
                                <RadzenButton Text="Add as planned" Icon="event_note" Size="ButtonSize.ExtraSmall"
                                              ButtonStyle="ButtonStyle.Secondary" Click=@(() => AddAsPlannedAsync(row)) />
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </RadzenCard>
        }

    </RadzenStack>
</div>

@code {
    private IReadOnlyList<RecurringSeries>? series;

    protected override async Task OnInitializedAsync() => series = await RecurringService.GetAsync();

    private async Task AddAsPlannedAsync(RecurringSeries s)
    {
        // Weekly/biweekly cadences map to Monthly (planning steps by whole months) —
        // the user can fine-tune on the Planning page.
        var frequency = s.Interval switch
        {
            RecurrenceInterval.Quarterly => PlannedFrequency.Quarterly,
            RecurrenceInterval.Yearly => PlannedFrequency.Yearly,
            _ => PlannedFrequency.Monthly,
        };

        var result = await MessageBus.InvokeAsync<Result<PlannedItem>>(
            new CreatePlannedItemCommand(
                s.Counterparty,
                s.TypicalAmount,
                CategoryId: null,
                frequency,
                s.NextExpected,
                EndDate: null,
                ExpectedAccountId: null,
                CounterpartyPattern: s.Counterparty,
                AmountTolerance: 0.1m,
                DateWindowDays: 7
            )
        );

        if (result.IsFailure)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Could not add", result.Error);
            return;
        }
        NotificationService.Notify(
            NotificationSeverity.Success,
            "Added to planning",
            $"“{s.Counterparty}” — adjust it on the Planning page."
        );
    }
}
