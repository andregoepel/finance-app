@page "/recurring"
@attribute [Authorize]
@rendermode InteractiveServer
@using AndreGoepel.FinanceApp.Domain.Recurring
@using AndreGoepel.FinanceApp.Insights

@inject IRecurringService RecurringService
@inject IMessageBus MessageBus
@inject NotificationService NotificationService
@inject IStringLocalizer<Strings> L

<AppPageTitle Title="@L["Nav.Recurring"]" />

<PageBody>

    <PageHeader Title="@L["Nav.Recurring"]" Subtitle="@L["Recurring.Subtitle"]" />

    @if (series is null)
    {
        <RadzenText>@L["Common.Loading"]</RadzenText>
    }
    else if (series.Count == 0)
    {
        <EmptyState Icon="@("🔁")" Title="@L["Recurring.EmptyTitle"]" Text="@L["Recurring.EmptyText"]" />
    }
    else
    {
        <DataCard>
            <RadzenDataGrid TItem="RecurringSeries" Data=@series Density="Density.Compact"
                            AllowSorting="true" AllowPaging="true" PageSize="20">
                <Columns>
                    <RadzenDataGridColumn TItem="RecurringSeries" Property="Counterparty" Title="@L["Common.Counterparty"]" />
                    <RadzenDataGridColumn TItem="RecurringSeries" Property="Interval" Title="@L["Recurring.ColInterval"]" Width="150px">
                        <Template Context="row">@L[$"Enum.RecurrenceInterval.{row.Interval}"]</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RecurringSeries" Property="TypicalAmount" Title="@L["Recurring.ColTypicalAmount"]" Width="140px" TextAlign="TextAlign.Right">
                        <Template Context="row">
                            <AmountText Amount="row.TypicalAmount" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RecurringSeries" Property="Occurrences" Title="@L["Recurring.ColSeen"]" Width="110px" TextAlign="TextAlign.Right" />
                    <RadzenDataGridColumn TItem="RecurringSeries" Property="LastSeen" Title="@L["Recurring.ColLast"]" Width="120px">
                        <Template Context="row">@Dates.Short(row.LastSeen)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RecurringSeries" Property="NextExpected" Title="@L["Recurring.ColNextExpected"]" Width="150px">
                        <Template Context="row">@Dates.Short(row.NextExpected)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="RecurringSeries" Title="" Width="140px" TextAlign="TextAlign.End" Sortable="false">
                        <Template Context="row">
                            <RowActions>
                                <RadzenButton Text="@L["Recurring.AddAsPlanned"]" Icon="event_note" Size="ButtonSize.ExtraSmall"
                                              ButtonStyle="ButtonStyle.Secondary" Click=@(() => AddAsPlannedAsync(row)) />
                            </RowActions>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </DataCard>
    }

</PageBody>

@code {
    private IReadOnlyList<RecurringSeries>? series;

    protected override async Task OnInitializedAsync() => series = await RecurringService.GetAsync();

    private async Task AddAsPlannedAsync(RecurringSeries s)
    {
        // Weekly/biweekly cadences map to Monthly (planning steps by whole months) —
        // the user can fine-tune on the Planning page.
        var frequency = s.Interval switch
        {
            RecurrenceInterval.Quarterly => PlannedFrequency.Quarterly,
            RecurrenceInterval.Yearly => PlannedFrequency.Yearly,
            _ => PlannedFrequency.Monthly,
        };

        var result = await MessageBus.InvokeAsync<Result<PlannedItem>>(
            new CreatePlannedItemCommand(
                s.Counterparty,
                s.TypicalAmount,
                CategoryId: null,
                frequency,
                s.NextExpected,
                EndDate: null,
                ExpectedAccountId: null,
                CounterpartyPattern: s.Counterparty,
                AmountTolerance: 0.1m,
                DateWindowDays: 7
            )
        );

        if (result.IsFailure)
        {
            NotificationService.Error(L["Recurring.CouldNotAddTitle"], result.Error);
            return;
        }
        NotificationService.Success(
            L["Recurring.AddedToPlanningTitle"],
            L["Recurring.AddedToPlanningMessage", s.Counterparty]
        );
    }
}
