@page "/planning"
@attribute [Authorize]
@rendermode InteractiveServer
@using AndreGoepel.FinanceApp.Planning

@inject IQuerySession QuerySession
@inject IPlanningService PlanningService
@inject IMessageBus MessageBus
@inject NotificationService NotificationService

<PageTitle>Planning – Finance</PageTitle>

<div class="rz-p-4 rz-p-md-6">
    <RadzenStack Gap="1.5rem">

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween">
            <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1">Planning</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                <RadzenButton Icon="chevron_left" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click=@(() => ShiftMonthAsync(-1)) />
                <RadzenText TextStyle="TextStyle.Subtitle1" Style="min-width: 9rem; text-align: center;">@monthStart.ToString("MMMM yyyy")</RadzenText>
                <RadzenButton Icon="chevron_right" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click=@(() => ShiftMonthAsync(1)) />
            </RadzenStack>
        </RadzenStack>

        @* ---------- Plan vs actual for the month ---------- *@
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMd="4">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Planned income</RadzenText>
                    <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-success);">@Eur(plan?.PlannedIncome ?? 0)</RadzenText>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMd="4">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Planned expenses</RadzenText>
                    <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-danger);">@Eur(plan?.PlannedExpenses ?? 0)</RadzenText>
                </RadzenCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMd="4">
                <RadzenCard>
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Planned net</RadzenText>
                    <RadzenText TextStyle="TextStyle.H6">@Eur((plan?.PlannedIncome ?? 0) - (plan?.PlannedExpenses ?? 0))</RadzenText>
                </RadzenCard>
            </RadzenColumn>
        </RadzenRow>

        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">This month's plan</RadzenText>
                @if (plan is null || plan.Occurrences.Count == 0)
                {
                    <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                        Nothing planned for this month. Add planned items below.
                    </RadzenText>
                }
                else
                {
                    <RadzenDataGrid TItem="PlannedOccurrence" Data=@plan.Occurrences Density="Density.Compact" AllowPaging="false">
                        <Columns>
                            <RadzenDataGridColumn TItem="PlannedOccurrence" Property="DueDate" Title="Due" Width="110px">
                                <Template Context="o">@o.DueDate.ToString("dd.MM.yyyy")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PlannedOccurrence" Property="Description" Title="Description" />
                            <RadzenDataGridColumn TItem="PlannedOccurrence" Title="Category" Width="150px">
                                <Template Context="o">@CategoryName(o.CategoryId)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PlannedOccurrence" Property="Amount" Title="Amount" Width="120px" TextAlign="TextAlign.Right">
                                <Template Context="o">
                                    <span style="@(o.Amount < 0 ? "color: var(--rz-danger);" : "color: var(--rz-success);")">@Eur(o.Amount)</span>
                                </Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PlannedOccurrence" Property="Status" Title="Status" Width="110px">
                                <Template Context="o">
                                    <RadzenBadge BadgeStyle="@StatusStyle(o.Status)" Text="@o.Status.ToString()" />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </RadzenStack>
        </RadzenCard>

        @* ---------- Manage planned items ---------- *@
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">@(editingId is null ? "Add planned item" : "Edit planned item")</RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                    <RadzenFormField Text="Description">
                        <RadzenTextBox @bind-Value=@form.Description Style="min-width: 14rem;" />
                    </RadzenFormField>
                    <RadzenFormField Text="Type">
                        <RadzenDropDown TValue="bool" @bind-Value=@form.IsExpense Data=@TypeChoices
                                        TextProperty="Label" ValueProperty="IsExpense" Style="min-width: 8rem;" />
                    </RadzenFormField>
                    <RadzenFormField Text="Amount (€)">
                        <RadzenNumeric TValue="decimal" @bind-Value=@form.Amount Min="0" Style="width: 9rem;" />
                    </RadzenFormField>
                    <RadzenFormField Text="Category">
                        <RadzenDropDown TValue="Guid?" @bind-Value=@form.CategoryId Data=@categoryOptions
                                        ValueProperty="Id" TextProperty="Path" AllowClear="true" AllowFiltering="true"
                                        Placeholder="(none)" Style="min-width: 15rem;" />
                    </RadzenFormField>
                    <RadzenFormField Text="Frequency">
                        <RadzenDropDown TValue="PlannedFrequency" @bind-Value=@form.Frequency Data=@Frequencies Style="min-width: 9rem;" />
                    </RadzenFormField>
                    <RadzenFormField Text="Start date">
                        <RadzenDatePicker TValue="DateTime" @bind-Value=@form.StartDate DateFormat="dd.MM.yyyy" Style="width: 11rem;" />
                    </RadzenFormField>
                    @if (form.Frequency != PlannedFrequency.OneTime)
                    {
                        <RadzenFormField Text="End date (optional)">
                            <RadzenDatePicker TValue="DateTime?" @bind-Value=@form.EndDate DateFormat="dd.MM.yyyy" AllowClear="true" Style="width: 11rem;" />
                        </RadzenFormField>
                    }
                    <RadzenFormField Text="Expected account">
                        <RadzenDropDown TValue="Guid?" @bind-Value=@form.ExpectedAccountId Data=@accounts
                                        ValueProperty="Id" TextProperty="Name" AllowClear="true"
                                        Placeholder="(any)" Style="min-width: 12rem;" />
                    </RadzenFormField>
                    <RadzenFormField Text="Counterparty contains">
                        <RadzenTextBox @bind-Value=@form.CounterpartyPattern Placeholder="match hint" Style="min-width: 12rem;" />
                    </RadzenFormField>
                    <RadzenFormField Text="Amount tolerance (%)">
                        <RadzenNumeric TValue="decimal" @bind-Value=@form.TolerancePercent Min="0" Max="100" Style="width: 8rem;" />
                    </RadzenFormField>
                    <RadzenFormField Text="Date window (± days)">
                        <RadzenNumeric TValue="int" @bind-Value=@form.DateWindowDays Min="0" Style="width: 8rem;" />
                    </RadzenFormField>
                    @if (editingId is not null)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                            <RadzenSwitch @bind-Value=@form.Active />
                            <RadzenLabel Text="Active" />
                        </RadzenStack>
                    }
                    <RadzenButton Text="@(editingId is null ? "Add" : "Save")" Icon="save" ButtonStyle="ButtonStyle.Primary"
                                  Disabled=@(string.IsNullOrWhiteSpace(form.Description) || form.Amount <= 0) Click=@SaveAsync />
                    @if (editingId is not null)
                    {
                        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click=@ResetForm />
                    }
                </RadzenStack>

                @if (items.Count > 0)
                {
                    <RadzenDataGrid TItem="PlannedItem" Data=@items Density="Density.Compact" AllowPaging="true" PageSize="15">
                        <Columns>
                            <RadzenDataGridColumn TItem="PlannedItem" Property="Description" Title="Description" />
                            <RadzenDataGridColumn TItem="PlannedItem" Title="Amount" Width="120px" TextAlign="TextAlign.Right">
                                <Template Context="i"><span style="@(i.Amount < 0 ? "color: var(--rz-danger);" : "color: var(--rz-success);")">@Eur(i.Amount)</span></Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PlannedItem" Title="Schedule" Width="150px">
                                <Template Context="i">@ScheduleLabel(i)</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PlannedItem" Property="Active" Title="Active" Width="80px">
                                <Template Context="i">@(i.Active ? "yes" : "no")</Template>
                            </RadzenDataGridColumn>
                            <RadzenDataGridColumn TItem="PlannedItem" Title="" Width="90px" TextAlign="TextAlign.End">
                                <Template Context="i">
                                    <RadzenButton Icon="edit" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light" title="Edit" Click=@(() => StartEdit(i)) />
                                    <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Danger" title="Delete" Click=@(() => DeleteAsync(i)) />
                                </Template>
                            </RadzenDataGridColumn>
                        </Columns>
                    </RadzenDataGrid>
                }
            </RadzenStack>
        </RadzenCard>

    </RadzenStack>
</div>

@code {
    private sealed record CategoryOption(Guid Id, string Path);
    private sealed record AccountOption(Guid Id, string Name);
    private sealed record TypeChoice(string Label, bool IsExpense);

    private static readonly PlannedFrequency[] Frequencies = Enum.GetValues<PlannedFrequency>();
    private static readonly TypeChoice[] TypeChoices = [new("Expense", true), new("Income", false)];

    private DateOnly monthStart = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private PlanMonth? plan;
    private List<PlannedItem> items = [];
    private List<CategoryOption> categoryOptions = [];
    private Dictionary<Guid, string> categoryNames = [];
    private List<AccountOption> accounts = [];
    private Guid? editingId;
    private ItemForm form = new();

    protected override async Task OnInitializedAsync()
    {
        var categories = await QuerySession.Query<Category>().ToListAsync();
        var byId = categories.ToDictionary(c => c.Id);
        string Path(Category c)
        {
            var parts = new List<string>();
            var current = c;
            var guard = 0;
            while (current is not null && guard++ < 64)
            {
                parts.Insert(0, current.Name);
                current = current.ParentId is Guid p && byId.TryGetValue(p, out var parent) ? parent : null;
            }
            return string.Join(" › ", parts);
        }
        categoryOptions = categories.Select(c => new CategoryOption(c.Id, Path(c))).OrderBy(o => o.Path).ToList();
        categoryNames = categories.ToDictionary(c => c.Id, c => c.Name);
        accounts = (await QuerySession.Query<Account>().Where(a => a.Status == AccountStatus.Active).ToListAsync())
            .OrderBy(a => a.Name).Select(a => new AccountOption(a.Id, a.Name)).ToList();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        items = (await PlanningService.GetItemsAsync()).OrderBy(i => i.Description).ToList();
        plan = await PlanningService.GetMonthAsync(monthStart.Year, monthStart.Month);
    }

    private async Task ShiftMonthAsync(int months)
    {
        monthStart = monthStart.AddMonths(months);
        plan = null;
        plan = await PlanningService.GetMonthAsync(monthStart.Year, monthStart.Month);
    }

    private void StartEdit(PlannedItem item)
    {
        editingId = item.Id;
        form = new ItemForm
        {
            Description = item.Description,
            IsExpense = item.Amount < 0,
            Amount = Math.Abs(item.Amount),
            CategoryId = item.CategoryId,
            Frequency = item.Schedule.Frequency,
            StartDate = item.Schedule.StartDate.ToDateTime(TimeOnly.MinValue),
            EndDate = item.Schedule.EndDate?.ToDateTime(TimeOnly.MinValue),
            ExpectedAccountId = item.ExpectedAccountId,
            CounterpartyPattern = item.CounterpartyPattern ?? "",
            TolerancePercent = item.AmountTolerance * 100,
            DateWindowDays = item.DateWindowDays,
            Active = item.Active,
        };
    }

    private void ResetForm()
    {
        editingId = null;
        form = new ItemForm();
    }

    private async Task SaveAsync()
    {
        var amount = form.IsExpense ? -form.Amount : form.Amount;
        var start = DateOnly.FromDateTime(form.StartDate);
        DateOnly? end = form.Frequency != PlannedFrequency.OneTime && form.EndDate is DateTime e
            ? DateOnly.FromDateTime(e)
            : null;
        var pattern = form.CounterpartyPattern;
        var tolerance = form.TolerancePercent / 100m;

        Result result = editingId is Guid id
            ? await MessageBus.InvokeAsync<Result<PlannedItem>>(new UpdatePlannedItemCommand(
                id, form.Description, amount, form.CategoryId, form.Frequency, start, end,
                form.ExpectedAccountId, pattern, tolerance, form.DateWindowDays, form.Active))
            : await MessageBus.InvokeAsync<Result<PlannedItem>>(new CreatePlannedItemCommand(
                form.Description, amount, form.CategoryId, form.Frequency, start, end,
                form.ExpectedAccountId, pattern, tolerance, form.DateWindowDays));

        if (result.IsFailure)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Saving failed", result.Error);
            return;
        }
        ResetForm();
        await LoadAsync();
        NotificationService.Notify(NotificationSeverity.Success, "Planned item saved");
    }

    private async Task DeleteAsync(PlannedItem item)
    {
        var result = await MessageBus.InvokeAsync<Result>(new DeletePlannedItemCommand(item.Id));
        if (result.IsFailure)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Delete failed", result.Error);
            return;
        }
        if (editingId == item.Id)
        {
            ResetForm();
        }
        await LoadAsync();
        NotificationService.Notify(NotificationSeverity.Success, "Planned item removed");
    }

    private string CategoryName(Guid? categoryId) =>
        categoryId is Guid id && categoryNames.TryGetValue(id, out var name) ? name : "—";

    private static string ScheduleLabel(PlannedItem item) =>
        item.Schedule.Frequency == PlannedFrequency.OneTime
            ? $"Once, {item.Schedule.StartDate:dd.MM.yyyy}"
            : $"{item.Schedule.Frequency} from {item.Schedule.StartDate:dd.MM.yyyy}";

    private static BadgeStyle StatusStyle(PlannedOccurrenceStatus status) => status switch
    {
        PlannedOccurrenceStatus.Matched => BadgeStyle.Success,
        PlannedOccurrenceStatus.Overdue => BadgeStyle.Danger,
        PlannedOccurrenceStatus.Skipped => BadgeStyle.Light,
        _ => BadgeStyle.Info,
    };

    private static string Eur(decimal amount) => $"{amount:N2} €";

    private sealed class ItemForm
    {
        public string Description { get; set; } = "";
        public bool IsExpense { get; set; } = true;
        public decimal Amount { get; set; }
        public Guid? CategoryId { get; set; }
        public PlannedFrequency Frequency { get; set; } = PlannedFrequency.Monthly;
        public DateTime StartDate { get; set; } = DateTime.Today;
        public DateTime? EndDate { get; set; }
        public Guid? ExpectedAccountId { get; set; }
        public string CounterpartyPattern { get; set; } = "";
        public decimal TolerancePercent { get; set; } = 10;
        public int DateWindowDays { get; set; } = 7;
        public bool Active { get; set; } = true;
    }
}
