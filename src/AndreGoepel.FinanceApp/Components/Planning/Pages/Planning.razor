@page "/planning"
@attribute [Authorize]
@rendermode InteractiveServer
@using AndreGoepel.FinanceApp.Components.Planning.Dialogs
@using AndreGoepel.FinanceApp.Components.Settings.Dialogs
@using AndreGoepel.FinanceApp.Domain.Budgets
@using AndreGoepel.FinanceApp.Planning

@inject IQuerySession QuerySession
@inject IPlanningService PlanningService
@inject IMonthlyCategoryPlanService MonthlyCategoryPlanService
@inject IMessageBus MessageBus
@inject NotificationService NotificationService
@inject ConfirmService ConfirmService
@inject DialogService DialogService
@inject IStringLocalizer<Strings> L
@implements IDisposable

<AppPageTitle Title="@L["Nav.Planning"]" />

<PageBody>

    <PageHeader Title="@L["Nav.Planning"]">
        <Actions>
            <RadzenButton Text="@L["Planning.MatchNow"]" Icon="join_inner" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                          IsBusy=@matching Disabled=@matching Click=@MatchNowAsync />
            <MonthNavigator Month="monthStart" MonthChanged="OnMonthChangedAsync" />
        </Actions>
    </PageHeader>

    @* ---------- Plan vs actual ---------- *@
    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMd="4">
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">@L["Planning.ExpensesPlannedVsActual"]</RadzenText>
                <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-danger);">
                    @Money.Eur(plan?.ActualExpenses ?? 0) <span style="color: var(--rz-text-secondary-color); font-weight: 400;">/ @Money.Eur(plan?.PlannedExpenses ?? 0)</span>
                </RadzenText>
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMd="4">
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">@L["Planning.IncomePlannedVsActual"]</RadzenText>
                <RadzenText TextStyle="TextStyle.H6" Style="color: var(--rz-success);">
                    @Money.Eur(plan?.ActualIncome ?? 0) <span style="color: var(--rz-text-secondary-color); font-weight: 400;">/ @Money.Eur(plan?.PlannedIncome ?? 0)</span>
                </RadzenText>
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMd="4">
            <RadzenCard>
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">@L["Planning.EstimatedEndOfMonthValue"]</RadzenText>
                <RadzenText TextStyle="TextStyle.H6">
                    @(plan?.EstimatedEndOfMonthValue is decimal value ? Money.Eur(value) : "—")
                </RadzenText>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>

    <SectionCard Title="@L["Planning.MonthlyCategoryPlan"]">
        <Actions>
            <RadzenButton Text="@L["Budgets.AddTitle"]" Icon="add" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                          Click=@AddBudgetAsync />
        </Actions>
        <ChildContent>
            @if (categoryPlans.Count == 0)
            {
                <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                    @L["Planning.NoCategoryPlan"]
                </RadzenText>
            }
            else
            {
            <RadzenDataGrid TItem="MonthlyCategoryPlan" Data=@categoryPlans Density="Density.Compact" AllowPaging="false">
                <Columns>
                    <RadzenDataGridColumn TItem="MonthlyCategoryPlan" Property="Category" Title="@L["Dashboard.ColCategory"]">
                        <Template Context="row">@(row.Category ?? L["Planning.Unallocated"])</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MonthlyCategoryPlan" Title="@L["Planning.ColBudget"]" Width="125px" TextAlign="TextAlign.Right">
                        <Template Context="row">@(row.BudgetLimit is decimal amount ? Money.Eur(amount) : "—")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MonthlyCategoryPlan" Property="ActualSpent" Title="@L["Planning.ColActual"]" Width="125px" TextAlign="TextAlign.Right">
                        <Template Context="row">@Money.Eur(row.ActualSpent)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MonthlyCategoryPlan" Property="PlannedRemaining" Title="@L["Planning.ColFixedRemaining"]" Width="145px" TextAlign="TextAlign.Right">
                        <Template Context="row">@Money.Eur(row.PlannedRemaining)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MonthlyCategoryPlan" Property="ForecastSpent" Title="@L["Planning.ColForecast"]" Width="125px" TextAlign="TextAlign.Right">
                        <Template Context="row">@Money.Eur(row.ForecastSpent)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MonthlyCategoryPlan" Title="@L["Planning.ColFlexibleRemaining"]" Width="155px" TextAlign="TextAlign.Right">
                        <Template Context="row">@(row.FlexibleRemaining is decimal amount ? Money.Eur(amount) : "—")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MonthlyCategoryPlan" Title="" Width="70px" TextAlign="TextAlign.End" Sortable="false">
                        <Template Context="row">
                            @if (row.CategoryId is not null)
                            {
                                <IconButton Icon="@(row.BudgetLimit is null ? "add" : "edit")"
                                            Title="@(row.BudgetLimit is null ? L["Planning.SetBudget"] : L["Planning.EditBudget"] )"
                                            Click=@(_ => EditBudgetAsync(row)) />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
            }
        </ChildContent>
    </SectionCard>

    <SectionCard Title="@L["Planning.ThisMonthsPlan"]">
        <RadzenStack Gap="1rem">
            @if (plan is null || plan.Occurrences.Count == 0)
            {
                <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                    @L["Planning.NothingPlanned"]
                </RadzenText>
            }
            else
            {
                <RadzenDataGrid TItem="PlannedOccurrence" Data=@plan.Occurrences Density="Density.Compact" AllowPaging="false">
                    <Columns>
                        <RadzenDataGridColumn TItem="PlannedOccurrence" Property="DueDate" Title="@L["Planning.ColDue"]" Width="105px">
                            <Template Context="o">@Dates.Short(o.DueDate)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PlannedOccurrence" Property="Description" Title="@L["Common.Description"]" />
                        <RadzenDataGridColumn TItem="PlannedOccurrence" Title="@L["Dashboard.ColCategory"]" Width="130px">
                            <Template Context="o">@CategoryName(o.CategoryId)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PlannedOccurrence" Property="Amount" Title="@L["Planning.ColPlanned"]" Width="110px" TextAlign="TextAlign.Right">
                            <Template Context="o"><AmountText Amount="o.Amount" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PlannedOccurrence" Title="@L["Planning.ColActual"]" Width="110px" TextAlign="TextAlign.Right">
                            <Template Context="o">@(o.MatchedAmount is decimal a ? Money.Eur(a) : "—")</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PlannedOccurrence" Property="Status" Title="@L["Common.Status"]" Width="100px">
                            <Template Context="o"><StatusBadge Variant="@StatusVariant(o.Status)" Text="@L[$"Enum.PlannedOccurrenceStatus.{o.Status}"]" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PlannedOccurrence" Title="" Width="140px" TextAlign="TextAlign.End">
                            <Template Context="o">
                                <RadzenStack Gap="0.25rem" AlignItems="AlignItems.End">
                                    @foreach (var m in o.Matches)
                                    {
                                        <RadzenButton Text="@L["Planning.Unmatch"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                                      Click=@(() => UnmatchAsync(o, m.TransactionId)) />
                                    }
                                    <RadzenButton Text="@L["Planning.Match"]" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.ExtraSmall" Click=@(() => StartMatchAsync(o)) />
                                </RadzenStack>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }

            @if (matchingOccurrence is not null)
            {
                <RadzenCard Style="background: var(--rz-base-200);">
                    <RadzenStack Gap="0.75rem">
                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                            <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">
                                @L["Planning.MatchHeading", matchingOccurrence.Description, Dates.Short(matchingOccurrence.DueDate)]
                            </RadzenText>
                            <RadzenButton Text="@L["Common.Cancel"]" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" Click=@(() => matchingOccurrence = null) />
                        </RadzenStack>
                        @if (candidates.Count == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">@L["Planning.NoCandidates"]</RadzenText>
                        }
                        else
                        {
                            <RadzenDataGrid TItem="TransactionView" Data=@candidates Density="Density.Compact" AllowPaging="true" PageSize="8">
                                <Columns>
                                    <RadzenDataGridColumn TItem="TransactionView" Property="BookingDate" Title="@L["Common.Date"]" Width="105px">
                                        <Template Context="t">@Dates.Short(t.BookingDate)</Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="TransactionView" Property="Counterparty" Title="@L["Common.Counterparty"]" Width="160px" />
                                    <RadzenDataGridColumn TItem="TransactionView" Property="Description" Title="@L["Common.Description"]" />
                                    <RadzenDataGridColumn TItem="TransactionView" Property="AmountEur" Title="EUR" Width="110px" TextAlign="TextAlign.Right">
                                        <Template Context="t">@(t.AmountEur is decimal a ? Money.Eur(a) : "—")</Template>
                                    </RadzenDataGridColumn>
                                    <RadzenDataGridColumn TItem="TransactionView" Title="" Width="70px" TextAlign="TextAlign.End">
                                        <Template Context="t"><RadzenButton Text="@L["Planning.Use"]" Size="ButtonSize.ExtraSmall" Click=@(() => UseMatchAsync(t)) /></Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        }
                    </RadzenStack>
                </RadzenCard>
            }
        </RadzenStack>
    </SectionCard>

    @* ---------- Manage planned items ---------- *@
    <SectionCard Title="@L["Planning.ManageItemsTitle"]">
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton Text="@L["Planning.AddItemTitle"]" Icon="add" ButtonStyle="ButtonStyle.Primary" Click=@AddAsync />
            </RadzenStack>

            @if (items.Count > 0)
            {
                <RadzenDataGrid TItem="PlannedItem" Data=@items Density="Density.Compact" AllowPaging="true" PageSize="15">
                    <Columns>
                        <RadzenDataGridColumn TItem="PlannedItem" Property="Description" Title="@L["Common.Description"]" />
                        <RadzenDataGridColumn TItem="PlannedItem" Title="@L["Common.Amount"]" Width="120px" TextAlign="TextAlign.Right">
                            <Template Context="i"><AmountText Amount="i.Amount" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PlannedItem" Title="@L["Planning.ColSchedule"]" Width="150px">
                            <Template Context="i">@ScheduleLabel(i)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PlannedItem" Property="Active" Title="@L["Planning.ActiveLabel"]" Width="80px">
                            <Template Context="i">@(i.Active ? L["Common.Yes"] : L["Common.No"])</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="PlannedItem" Title="" Width="110px" TextAlign="TextAlign.End" Sortable="false">
                            <Template Context="i">
                                <RowActions>
                                    <IconButton Icon="edit" Title="@L["Common.Edit"]" Click=@(_ => EditAsync(i)) />
                                    <IconButton Icon="delete" Title="@L["Common.Delete"]" Danger="true" Click=@(_ => DeleteAsync(i)) />
                                </RowActions>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        </RadzenStack>
    </SectionCard>

</PageBody>

@code {
    private readonly CancellationTokenSource _cts = new();

    private DateOnly monthStart = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private PlanMonth? plan;
    private List<PlannedItem> items = [];
    private List<MonthlyCategoryPlan> categoryPlans = [];
    private List<Budget> budgets = [];
    private List<CategoryOption> categoryOptions = [];
    private Dictionary<Guid, string> categoryNames = [];
    private List<Account> accounts = [];
    private bool matching;

    private PlannedOccurrence? matchingOccurrence;
    private List<TransactionView> candidates = [];

    protected override async Task OnInitializedAsync()
    {
        var categories = await QuerySession.Query<Category>().ToListAsync(_cts.Token);
        categoryOptions = CategoryPaths.Build(categories.ToList());
        categoryNames = categories.ToDictionary(c => c.Id, c => c.Name);
        accounts = (
            await QuerySession
                .Query<Account>()
                .Where(a => a.Status == AccountStatus.Active)
                .ToListAsync(_cts.Token)
        )
            .OrderBy(a => a.Name)
            .ToList();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        items = (await PlanningService.GetItemsAsync(_cts.Token)).OrderBy(i => i.Description).ToList();
        plan = await PlanningService.GetMonthAsync(monthStart.Year, monthStart.Month, _cts.Token);
        categoryPlans = (await MonthlyCategoryPlanService.GetAsync(monthStart.Year, monthStart.Month, _cts.Token)).ToList();
        budgets = (await QuerySession.Query<Budget>().ToListAsync(_cts.Token)).ToList();
    }

    private async Task OnMonthChangedAsync(DateOnly month)
    {
        monthStart = month;
        matchingOccurrence = null;
        plan = null;
        await LoadAsync();
    }

    private async Task EditBudgetAsync(MonthlyCategoryPlan row)
    {
        if (row.CategoryId is not Guid categoryId)
        {
            return;
        }
        var budget = budgets.FirstOrDefault(candidate =>
            candidate.CategoryId == categoryId
            && monthStart >= candidate.StartMonth
            && (candidate.EndMonth is null || monthStart <= candidate.EndMonth)
        );
        await OpenBudgetAsync(budget, categoryId);
    }

    private Task AddBudgetAsync() => OpenBudgetAsync(null, null);

    private async Task OpenBudgetAsync(Budget? budget, Guid? categoryId)
    {
        var result = await DialogService.OpenAsync(
            titleContent: _ => @<DialogHeader Title="@(budget is null ? L["Budgets.AddTitle"] : L["Budgets.EditTitle"] )" />,
            childContent: _ => @<BudgetFormDialog Budget="@budget" InitialCategoryId="@categoryId" InitialStartMonth="@monthStart" CategoryOptions="@categoryOptions" />
        );
        if (result is true)
        {
            await LoadAsync();
            NotificationService.Success(L["Budgets.SavedTitle"]);
        }
    }

    private async Task MatchNowAsync()
    {
        matching = true;
        try
        {
            await MessageBus.InvokeAsync(new MatchPlannedTransactionsCommand(), _cts.Token);
            await LoadAsync();
            NotificationService.Success(L["Planning.MatchingCompleteTitle"]);
        }
        finally
        {
            matching = false;
        }
    }

    private async Task StartMatchAsync(PlannedOccurrence occurrence)
    {
        matchingOccurrence = occurrence;
        var alreadyLinked = occurrence.Matches.Select(m => m.TransactionId).ToHashSet();
        candidates = (
            await PlanningService.GetMatchCandidatesAsync(
                occurrence.DueDate,
                occurrence.Amount,
                _cts.Token
            )
        )
            .Where(t => !alreadyLinked.Contains(t.Id))
            .ToList();
    }

    private async Task UseMatchAsync(TransactionView transaction)
    {
        if (matchingOccurrence is not PlannedOccurrence o)
        {
            return;
        }
        var result = await MessageBus.InvokeAsync<Result>(
            new SetPlannedMatchCommand(o.PlannedItemId, o.DueDate, transaction.Id),
            _cts.Token
        );
        if (result.IsFailure)
        {
            NotificationService.Error(L["Planning.MatchFailedTitle"], result.Error);
            return;
        }
        matchingOccurrence = null;
        await LoadAsync();
        NotificationService.Success(L["Planning.MatchedTitle"]);
    }

    private async Task UnmatchAsync(PlannedOccurrence occurrence, Guid transactionId)
    {
        var result = await MessageBus.InvokeAsync<Result>(
            new ClearPlannedMatchCommand(occurrence.PlannedItemId, occurrence.DueDate, transactionId),
            _cts.Token
        );
        if (result.IsFailure)
        {
            NotificationService.Error(L["Planning.UnmatchFailedTitle"], result.Error);
            return;
        }
        await LoadAsync();
    }

    private Task AddAsync() => OpenFormAsync(null);

    private Task EditAsync(PlannedItem item) => OpenFormAsync(item);

    private async Task OpenFormAsync(PlannedItem? item)
    {
        var result = await DialogService.OpenAsync(
            titleContent: _ => @<DialogHeader Title="@(item is null ? L["Planning.AddItemTitle"] : L["Planning.EditItemTitle"])" />,
            childContent: _ => @<PlannedItemFormDialog Item="@item" CategoryOptions="@categoryOptions" Accounts="@accounts" />
        );
        if (result is true)
        {
            await LoadAsync();
            NotificationService.Success(L["Planning.ItemSavedTitle"]);
        }
    }

    private async Task DeleteAsync(PlannedItem item)
    {
        // Parameterized rather than interpolated: the shared confirm template wraps this in
        // "Delete {0}? …" / "{0} löschen? …", so an English article baked into the argument
        // would read as broken German.
        if (
            !await ConfirmService.ConfirmDeleteAsync(
                L["Planning.DeleteConfirmSubject", item.Description]
            )
        )
        {
            return;
        }
        var result = await MessageBus.InvokeAsync<Result>(new DeletePlannedItemCommand(item.Id), _cts.Token);
        if (result.IsFailure)
        {
            NotificationService.Error(L["Common.DeleteFailedTitle"], result.Error);
            return;
        }
        await LoadAsync();
        NotificationService.Success(L["Planning.ItemRemovedTitle"]);
    }

    private string CategoryName(Guid? categoryId) =>
        categoryId is Guid id && categoryNames.TryGetValue(id, out var name) ? name : "—";

    // Instance (not static) so it can localize: both branches interpolate English words around a
    // date, and the date itself goes through Dates rather than an inline format string.
    private string ScheduleLabel(PlannedItem item) =>
        item.Schedule.Frequency == PlannedFrequency.OneTime
            ? L["Planning.ScheduleOnce", Dates.Short(item.Schedule.StartDate)]
            : L[
                "Planning.ScheduleRecurring",
                L[$"Enum.PlannedFrequency.{item.Schedule.Frequency}"],
                Dates.Short(item.Schedule.StartDate)
            ];

    private static BadgeVariant StatusVariant(PlannedOccurrenceStatus status) => status switch
    {
        PlannedOccurrenceStatus.Matched => BadgeVariant.Success,
        PlannedOccurrenceStatus.Overdue => BadgeVariant.Danger,
        PlannedOccurrenceStatus.Skipped => BadgeVariant.Neutral,
        _ => BadgeVariant.Info,
    };

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
