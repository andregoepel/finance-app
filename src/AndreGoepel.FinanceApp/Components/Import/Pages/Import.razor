@page "/import"
@attribute [Authorize]

@using System.Text
@using Microsoft.AspNetCore.Components.Authorization

@inject IQuerySession QuerySession
@inject IMessageBus MessageBus
@inject IStatementParserRegistry ParserRegistry
@inject NotificationService NotificationService
@inject IStringLocalizer<Strings> L
@implements IDisposable

<AppPageTitle Title="@L["Nav.Import"]" />

<PageBody>

    <PageHeader Title="@L["Nav.Import"]" />

    <RadzenCard>
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                <FormField Label="@L["Common.Account"]" For="Account">
                    <RadzenDropDown TValue="Guid?"
                                    @bind-Value=@selectedAccountId Name="Account"
                                    Data=@accounts
                                    TextProperty="Name"
                                    ValueProperty="Id"
                                    Placeholder="@L["Import.SelectAccountPlaceholder"]"
                                    Style="min-width: 14rem;"
                                    Change=@(_ => OnAccountChangedAsync()) />
                </FormField>
                <div>
                    <InputFile class="import-file-input" OnChange="OnFileSelectedAsync" accept=".csv,.xlsx" disabled=@(selectedAccountId is null) />
                </div>
            </RadzenStack>
            @if (SelectedAccount is not null)
            {
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                    @L["Import.ProviderCaption", SelectedAccount.Provider]
                </RadzenText>
            }
        </RadzenStack>
    </RadzenCard>

    @if (parseFailure is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" AllowClose="false">@parseFailure</RadzenAlert>
    }

    @if (preview is not null)
    {
        <SectionCard Title="@L["Import.PreviewTitle", fileName, preview.ParserId]">
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1.5rem">
                    <StatusBadge Variant="BadgeVariant.Success" Text="@L["Import.NewCount", NewRowCount]" />
                    <StatusBadge Variant="BadgeVariant.Warning" Text="@L["Import.DuplicatesCount", SkippedDuplicateCount]" />
                    <StatusBadge Variant="BadgeVariant.Danger" Text="@L["Import.ProblemRowsCount", preview.Errors.Count]" />
                </RadzenStack>

                <RadzenDataGrid TItem="NormalizedTransaction" Data=@preview.Rows AllowPaging="true" PageSize="15" Density="Density.Compact">
                    <Columns>
                        <RadzenDataGridColumn TItem="NormalizedTransaction" Property="SourceRow" Title="@L["Import.ColRow"]" Width="70px" />
                        <RadzenDataGridColumn TItem="NormalizedTransaction" Property="BookingDate" Title="@L["Common.Date"]" Width="110px">
                            <Template Context="row">@Dates.Short(row.BookingDate)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="NormalizedTransaction" Property="Counterparty" Title="@L["Common.Counterparty"]" Width="170px" />
                        <RadzenDataGridColumn TItem="NormalizedTransaction" Property="Description" Title="@L["Common.Description"]" />
                        <RadzenDataGridColumn TItem="NormalizedTransaction" Property="Amount" Title="@L["Common.Amount"]" Width="120px" TextAlign="TextAlign.Right">
                            <Template Context="row">@row.Amount.ToString("N2") @row.Currency</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="NormalizedTransaction" Title="@L["Common.Status"]" Width="230px">
                            <Template Context="row">
                                @if (IsDuplicate(row))
                                {
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                                        <StatusBadge Variant="BadgeVariant.Warning" Text="@L["Import.DuplicateBadge"]" />
                                        <RadzenSwitch Value="@forceImportRows.Contains(row.SourceRow)"
                                                       ValueChanged="@(v => ToggleForceImport(row.SourceRow, v))"
                                                       Name="@($"force-{row.SourceRow}")" />
                                        <RadzenLabel Text="@L["Import.ImportAnywayLabel"]" Component="@($"force-{row.SourceRow}")"
                                                      Style="font-size: 0.8rem; color: var(--rz-text-secondary-color);" />
                                    </RadzenStack>
                                }
                                else
                                {
                                    <StatusBadge Variant="BadgeVariant.Success" Text="@L["Import.NewBadge"]" />
                                }
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>

                @if (preview.Errors.Count > 0)
                {
                    <RadzenText TextStyle="TextStyle.H6">@L["Import.ProblemRowsHeading"]</RadzenText>
                    <RadzenDataGrid TItem="ImportRowError" Data=@preview.Errors AllowPaging="true" PageSize="10" Density="Density.Compact">
                        <Columns>
                            <RadzenDataGridColumn TItem="ImportRowError" Property="RowNumber" Title="@L["Import.ColRow"]" Width="70px" />
                            <RadzenDataGridColumn TItem="ImportRowError" Property="Message" Title="@L["Import.ColProblem"]" Width="320px" />
                            <RadzenDataGridColumn TItem="ImportRowError" Property="RawLine" Title="@L["Import.ColRawLine"]" />
                        </Columns>
                    </RadzenDataGrid>
                }

                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                    <RadzenButton Text="@L["Import.ImportButton", NewRowCount]"
                                  Icon="download_done"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Disabled=@(isImporting || NewRowCount == 0)
                                  IsBusy=@isImporting
                                  BusyText="@L["Import.ImportingBusyText"]"
                                  Click=@RunImportAsync />
                </RadzenStack>
            </RadzenStack>
        </SectionCard>
    }

    @if (selectedAccountId is not null)
    {
        <SectionCard Title="@L["Import.HistoryTitle"]">
            <RadzenDataGrid TItem="ImportBatch"
                            @ref="historyGrid"
                            Data=@history
                            Count=@historyCount
                            LoadData=@LoadHistoryDataAsync
                            Density="Density.Compact"
                            AllowPaging="true"
                            PageSize=@DefaultHistoryPageSize
                            PageSizeOptions=@HistoryPageSizeOptions
                            PageNumbersCount="5"
                            ShowPagingSummary="true"
                            PageSizeText="@L["Import.PageSizeText"]"
                            EmptyText="@L["Import.NoHistory"]"
                            KeyProperty="Id">
                    <Columns>
                        <RadzenDataGridColumn TItem="ImportBatch" Property="ImportedAt" Title="@L["Import.ColWhen"]" Width="160px">
                            <Template Context="batch">@Dates.ShortTime(batch.ImportedAt.ToLocalTime())</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ImportBatch" Property="Source" Title="@L["Import.ColFile"]" />
                        <RadzenDataGridColumn TItem="ImportBatch" Property="ParserId" Title="@L["Import.ColFormat"]" Width="140px" />
                        <RadzenDataGridColumn TItem="ImportBatch" Property="ImportedCount" Title="@L["Import.ColImported"]" Width="90px" TextAlign="TextAlign.Right" />
                        <RadzenDataGridColumn TItem="ImportBatch" Property="DuplicateCount" Title="@L["Import.ColDuplicates"]" Width="100px" TextAlign="TextAlign.Right" />
                        <RadzenDataGridColumn TItem="ImportBatch" Title="@L["Import.ColErrors"]" Width="80px" TextAlign="TextAlign.Right">
                            <Template Context="batch">@batch.ErrorCount</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="ImportBatch" Property="ImportedBy" Title="@L["Import.ColImportedBy"]" Width="140px" />
                    </Columns>
                </RadzenDataGrid>
        </SectionCard>
    }

</PageBody>

@code {
    private const long MaxFileSize = 5 * 1024 * 1024;
    private const int DefaultHistoryPageSize = 10;
    private static readonly int[] HistoryPageSizeOptions = [10, 25, 50];

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private readonly CancellationTokenSource _cts = new();

    private List<Account> accounts = [];
    private Guid? selectedAccountId;
    private string fileName = "";
    private StatementParseResult? preview;
    private string? parseFailure;
    private Dictionary<int, bool> duplicateHashes = [];
    private Dictionary<int, string> rowHashes = [];
    private HashSet<int> forceImportRows = [];
    private List<ImportBatch> history = [];
    private RadzenDataGrid<ImportBatch>? historyGrid;
    private int historyCount;
    private bool isImporting;

    private Account? SelectedAccount =>
        accounts.FirstOrDefault(a => a.Id == selectedAccountId);

    private int NewRowCount =>
        preview is null
            ? 0
            : preview.Rows.Count(row => !IsDuplicate(row) || forceImportRows.Contains(row.SourceRow));

    private int SkippedDuplicateCount =>
        duplicateHashes.Count(kv => kv.Value && !forceImportRows.Contains(kv.Key));

    protected override async Task OnInitializedAsync()
    {
        accounts = (
            await QuerySession
                .Query<Account>()
                .Where(a => a.Status == AccountStatus.Active && a.SyncMethod != SyncMethod.Manual)
                .ToListAsync(_cts.Token)
        )
            .OrderBy(a => a.Name)
            .ToList();
    }

    private async Task OnAccountChangedAsync()
    {
        preview = null;
        parseFailure = null;
        await ReloadHistoryAsync(resetPage: true);
    }

    private Task LoadHistoryDataAsync(LoadDataArgs args) =>
        LoadHistoryPageAsync(args.Skip ?? 0, args.Top ?? DefaultHistoryPageSize);

    private async Task LoadHistoryPageAsync(int skip, int take)
    {
        if (selectedAccountId is not Guid accountId)
        {
            history = [];
            historyCount = 0;
            return;
        }

        var page = await ImportBatchPageQuery.LoadAsync(
            QuerySession,
            accountId,
            skip,
            take,
            _cts.Token
        );
        historyCount = page.TotalCount;
        history = page.Items.ToList();
    }

    private async Task ReloadHistoryAsync(bool resetPage = false)
    {
        if (historyGrid is null)
        {
            await LoadHistoryPageAsync(0, DefaultHistoryPageSize);
            return;
        }
        if (resetPage)
        {
            await historyGrid.FirstPage(true);
            return;
        }

        await historyGrid.Reload();
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs args)
    {
        if (SelectedAccount is not Account account)
        {
            return;
        }

        parseFailure = null;
        preview = null;
        forceImportRows = [];
        fileName = args.File.Name;

        StatementFile statementFile;
        try
        {
            await using var stream = args.File.OpenReadStream(MaxFileSize, _cts.Token);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer, _cts.Token);
            statementFile = new StatementFile(args.File.Name, buffer.ToArray());
        }
        catch (Exception ex)
        {
            parseFailure = L["Import.CouldNotReadFile", ex.Message];
            return;
        }

        var parsed = ParserRegistry.Parse(account.Provider, statementFile);
        if (parsed.IsFailure)
        {
            parseFailure = parsed.Error;
            return;
        }

        preview = parsed.Value;
        await ComputeDuplicateStatusAsync(account);
    }

    private async Task ComputeDuplicateStatusAsync(Account account)
    {
        rowHashes = preview!.Rows.ToDictionary(
            row => row.SourceRow,
            row => DedupHash.Compute(account.Id, row.BookingDate, row.Amount, row.Description)
        );
        var candidates = rowHashes.Values.Distinct().ToArray();
        var existing = (
            await QuerySession
                .Query<TransactionView>()
                .Where(t => t.AccountId == account.Id && t.DedupHash.IsOneOf(candidates))
                .Select(t => t.DedupHash)
                .ToListAsync(_cts.Token)
        ).ToHashSet();

        duplicateHashes = [];
        var seen = new HashSet<string>(existing);
        foreach (var row in preview.Rows)
        {
            duplicateHashes[row.SourceRow] = !seen.Add(rowHashes[row.SourceRow]);
        }
    }

    private bool IsDuplicate(NormalizedTransaction row) =>
        duplicateHashes.TryGetValue(row.SourceRow, out var duplicate) && duplicate;

    private void ToggleForceImport(int sourceRow, bool force)
    {
        if (force)
        {
            forceImportRows.Add(sourceRow);
        }
        else
        {
            forceImportRows.Remove(sourceRow);
        }
    }

    private async Task RunImportAsync()
    {
        if (preview is null || SelectedAccount is not Account account)
        {
            return;
        }

        isImporting = true;
        try
        {
            var user = AuthenticationState is null
                ? null
                : (await AuthenticationState).User.Identity?.Name;

            var result = await MessageBus.InvokeAsync<Result<ImportBatch>>(
                new ImportStatementCommand(
                    account.Id,
                    fileName,
                    preview.ParserId,
                    preview.Rows,
                    preview.Errors,
                    user,
                    forceImportRows.Count > 0 ? forceImportRows : null
                ),
                _cts.Token
            );

            if (result.IsFailure)
            {
                NotificationService.Error(L["Import.ImportFailedTitle"], result.Error);
                return;
            }

            // Kick off async EUR conversion + categorization (rules → Claude) as a
            // top-level publish from application code — the proven Wolverine delivery
            // path. Fire-and-forget: neither blocks or fails the import.
            if (result.Value!.ImportedCount > 0)
            {
                await MessageBus.PublishAsync(new ConvertPendingTransactionsToEurCommand());
                await MessageBus.PublishAsync(new MatchTransfersCommand());
                await MessageBus.PublishAsync(
                    new CategorizeImportedTransactionsCommand(result.Value.Id)
                );
                await MessageBus.PublishAsync(new MatchPlannedTransactionsCommand());
            }

            NotificationService.Success(
                L["Import.ImportCompleteTitle"],
                L["Import.ImportCompleteMessage", result.Value.ImportedCount, result.Value.DuplicateCount]
            );
            preview = null;
            forceImportRows = [];
            await ReloadHistoryAsync(resetPage: true);
        }
        finally
        {
            isImporting = false;
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
