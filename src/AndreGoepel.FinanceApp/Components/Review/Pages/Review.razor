@page "/review"
@attribute [Authorize]
@using AndreGoepel.FinanceApp.Domain.Credentials

@inject IQuerySession QuerySession
@inject IMessageBus MessageBus
@inject ICredentialStore CredentialStore
@inject NotificationService NotificationService
@inject IStringLocalizer<Strings> L

<AppPageTitle Title="@L["Nav.Review"]" />

<PageBody>

    <PageHeader Title="@L["Review.PageTitle"]" Subtitle="@L["Review.Subtitle"]" />

    <RadzenCard>
        <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="1rem" AlignItems="AlignItems.End">
            <RadzenButton Text="@L["Review.AcceptSuggestions"]"
                          Icon="check_circle"
                          ButtonStyle="ButtonStyle.Primary"
                          Disabled=@(!SelectedWithSuggestion.Any())
                          Click=@AcceptSelectedAsync />
            <RadzenButton Text="@L["Review.DismissSuggestions"]"
                          Icon="cancel"
                          ButtonStyle="ButtonStyle.Light"
                          Disabled=@(!SelectedWithSuggestion.Any())
                          Click=@DismissSelectedAsync />
            <FormField Label="@L["Review.SetCategoryLabel"]" For="BulkCategory">
                <CategoryPicker Options="@categoryOptions" Name="BulkCategory"
                                @bind-Value=@bulkCategoryId
                                Placeholder="@L["Common.ChooseCategoryPlaceholder"]" Style="min-width: 14rem;" />
            </FormField>
            <RadzenButton Text="@L["Review.ApplyToSelection"]"
                          Icon="done_all"
                          ButtonStyle="ButtonStyle.Secondary"
                          Disabled=@(bulkCategoryId is null || selected.Count == 0)
                          Click=@BulkCategorizeAsync />
            <RadzenButton Text="@L["Review.CategorizeWithAi"]"
                          Icon="auto_awesome"
                          ButtonStyle="ButtonStyle.Light"
                          Disabled=@(items.Count == 0)
                          Click=@CategorizeWithAiAsync />
            <IconButton Icon="refresh" Title="@L["Review.Refresh"]" Click=@(_ => ReloadAsync()) />
        </RadzenStack>
    </RadzenCard>

    <RadzenDataGrid TItem="TransactionView"
                    Data=@items
                    AllowPaging="true"
                    PageSize="25"
                    SelectionMode="DataGridSelectionMode.Multiple"
                    @bind-Value=@selected
                    Density="Density.Compact">
        <Columns>
            <RadzenDataGridColumn TItem="TransactionView" Property="BookingDate" Title="@L["Common.Date"]" Width="110px">
                <Template Context="transaction">@Dates.Short(transaction.BookingDate)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="TransactionView" Title="@L["Common.Account"]" Width="140px" Sortable="false">
                <Template Context="transaction">@AccountName(transaction.AccountId)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="TransactionView" Property="Counterparty" Title="@L["Common.Counterparty"]" Width="180px" />
            <RadzenDataGridColumn TItem="TransactionView" Property="Description" Title="@L["Common.Description"]" />
            <RadzenDataGridColumn TItem="TransactionView" Property="Amount" Title="@L["Common.Amount"]" Width="130px" TextAlign="TextAlign.Right">
                <Template Context="transaction">
                    <AmountText Amount="transaction.Amount" Currency="@transaction.Currency" />
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="TransactionView" Title="@L["Review.ColAiSuggestion"]" Width="240px" Sortable="false">
                <Template Context="transaction">
                    @if (suggestions.TryGetValue(transaction.Id, out var suggestion))
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                            <StatusBadge Variant="BadgeVariant.Info"
                                         Text="@($"{CategoryLabel(suggestion.CategoryId)} ({suggestion.Confidence:P0})")" />
                            <IconButton Icon="check" Title="@L["Review.AcceptSuggestionTooltip"]"
                                        Click=@(_ => AcceptOneAsync(transaction.Id)) />
                        </RadzenStack>
                    }
                    else
                    {
                        <span style="color: var(--rz-text-disabled-color);">—</span>
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

</PageBody>

@code {
    private const int MaxRows = 500;

    private List<TransactionView> items = [];
    private Dictionary<Guid, CategorySuggestion> suggestions = [];
    private List<Account> accounts = [];
    private List<CategoryOption> categoryOptions = [];
    private IList<TransactionView> selected = [];
    private Guid? bulkCategoryId;

    private IEnumerable<TransactionView> SelectedWithSuggestion =>
        selected.Where(transaction => suggestions.ContainsKey(transaction.Id));

    protected override async Task OnInitializedAsync()
    {
        accounts = (await QuerySession.Query<Account>().ToListAsync()).ToList();
        var categories = await QuerySession.Query<Category>().ToListAsync();
        categoryOptions = CategoryPaths.Build(categories.ToList());
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        items = (
            await QuerySession
                .Query<TransactionView>()
                .Where(t => t.CategoryId == null && t.TransferCounterpartId == null)
                .OrderByDescending(t => t.BookingDate)
                .Take(MaxRows)
                .ToListAsync()
        ).ToList();

        var ids = items.Select(t => t.Id).ToArray();
        suggestions = (
            await QuerySession.Query<CategorySuggestion>().Where(s => s.Id.IsOneOf(ids)).ToListAsync()
        ).ToDictionary(s => s.Id);
        selected = [];
    }

    private string AccountName(Guid accountId) =>
        accounts.FirstOrDefault(a => a.Id == accountId)?.Name ?? "?";

    private string CategoryLabel(Guid categoryId) =>
        categoryOptions.FirstOrDefault(c => c.Id == categoryId)?.Path ?? "?";

    private async Task AcceptOneAsync(Guid transactionId) =>
        await RunAsync(
            new ApplyCategorySuggestionsCommand([transactionId]),
            L["Review.SuggestionAcceptedMessage"]
        );

    private async Task AcceptSelectedAsync() =>
        await RunAsync(
            new ApplyCategorySuggestionsCommand(SelectedWithSuggestion.Select(t => t.Id).ToList()),
            L["Review.SuggestionsAcceptedMessage"]
        );

    private async Task DismissSelectedAsync() =>
        await RunAsync(
            new DismissCategorySuggestionsCommand(SelectedWithSuggestion.Select(t => t.Id).ToList()),
            L["Review.SuggestionsDismissedMessage"]
        );

    private async Task BulkCategorizeAsync()
    {
        if (bulkCategoryId is not Guid categoryId)
        {
            return;
        }

        foreach (var transaction in selected)
        {
            var result = await MessageBus.InvokeAsync<Result>(
                new CategorizeTransactionCommand(transaction.Id, categoryId)
            );
            if (result.IsFailure)
            {
                NotificationService.Error(L["Common.FailedTitle"], result.Error);
                break;
            }
        }
        await ReloadAsync();
    }

    /// <summary>
    /// Fire-and-forget backfill over everything still uncategorized — the same
    /// pipeline an import kicks off, so it can take a while for a large queue.
    /// Checked up front for the API key because the handler itself only logs
    /// when it is missing and the user would never learn why nothing happened.
    /// </summary>
    private async Task CategorizeWithAiAsync()
    {
        var apiKey = await CredentialStore.GetSecretAsync(CredentialKeys.ClaudeApiKey);
        if (string.IsNullOrWhiteSpace(apiKey))
        {
            NotificationService.Warning(
                L["Review.NoClaudeKeyTitle"],
                L["Review.NoClaudeKeyMessage", L["Nav.ApiKeys"]]
            );
            return;
        }

        await MessageBus.PublishAsync(new CategorizeUncategorizedTransactionsCommand());
        NotificationService.Success(L["Common.DoneTitle"], L["Review.CategorizeWithAiStartedMessage"]);
    }

    private async Task RunAsync(object command, string successMessage)
    {
        var result = await MessageBus.InvokeAsync<Result>(command);
        if (result.IsFailure)
        {
            NotificationService.Error(L["Common.FailedTitle"], result.Error);
        }
        else
        {
            NotificationService.Success(L["Common.DoneTitle"], successMessage);
        }
        await ReloadAsync();
    }
}
