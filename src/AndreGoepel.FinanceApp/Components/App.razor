@using System.Globalization
@inject NavigationManager NavigationManager
<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@NavigationManager.BaseUri" />

    <!-- Order-critical stylesheet stack (fonts -> Radzen material-base -> design tokens) plus
         theme.js, which applies the persisted theme before first paint. AppFoundation's own
         stylesheet loads as the "app-specific" slot here so the host's own bundle can still load
         — and override it — afterwards, preserving the original AppFoundation -> host cascade. -->
    <DesignBlazorHead AppStylesheetHref="_content/AndreGoepel.AppFoundation/app.css" />
    <link rel="stylesheet" href="@Assets["AndreGoepel.FinanceApp.styles.css"]" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <!-- Off-canvas nav toggle; not part of DesignBlazorHead's fixed tag set. -->
    <script src="_content/AndreGoepel.Design.Blazor/js/nav.js"></script>

    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="_content/Radzen.Blazor/Radzen.Blazor.js"></script>
</body>

</html>
