@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using AndreGoepel.FinanceApp.Insights
@using AndreGoepel.FinanceApp.Planning

@inject IDashboardService DashboardService
@inject INetWorthService NetWorthService
@inject IPlanningService PlanningService
@inject ICryptoService CryptoService
@inject IStringLocalizer<Strings> L
@implements IDisposable

<AppPageTitle Title="@L["Dashboard.Title"]" />

<PageBody>

    <PageHeader Title="@L["Dashboard.Title"]">
        <Actions>
            <MonthNavigator Month="MonthStart" DisableNext="IsCurrentMonth" MonthChanged="OnMonthChangedAsync" />
        </Actions>
    </PageHeader>

    @if (overview is null)
    {
        <RadzenText>@L["Common.Loading"]</RadzenText>
    }
    else
    {
        @if (overview.UnconvertedCount > 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
                @L["Dashboard.AwaitingConversion", overview.UnconvertedCount]
            </RadzenAlert>
        }

        @* ---------- Month totals ---------- *@
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMd="4">
                <StatTile Label="@L["Dashboard.Income"]" Value="@Money.Eur(overview.Income)" Variant="BadgeVariant.Success" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMd="4">
                <StatTile Label="@L["Dashboard.Expenses"]" Value="@Money.Eur(overview.Expenses)" Variant="BadgeVariant.Danger" />
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMd="4">
                <StatTile Label="@L["Dashboard.Net"]" Value="@Money.Eur(overview.Net)"
                          Variant="@(overview.Net >= 0 ? BadgeVariant.Success : BadgeVariant.Danger)" />
            </RadzenColumn>
        </RadzenRow>

        @* ---------- Spending by category ---------- *@
        <SectionCard Title="@L["Dashboard.SpendingByCategory"]">
            <RadzenStack Gap="1rem">
                @if (overview.SpendingByCategory.Count == 0)
                {
                    <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                        @L["Dashboard.NoExpensesThisMonth"]
                    </RadzenText>
                }
                else
                {
                    <RadzenRow Gap="1rem" AlignItems="AlignItems.Center">
                        <RadzenColumn Size="12" SizeMd="6">
                            <RadzenChart>
                                <RadzenDonutSeries Data="@overview.SpendingByCategory" CategoryProperty="Category" ValueProperty="Amount">
                                    <TitleTemplate>
                                        <div class="rz-donut-content">
                                            <RadzenText TextStyle="TextStyle.Caption">@L["Dashboard.Expenses"]</RadzenText>
                                        </div>
                                    </TitleTemplate>
                                </RadzenDonutSeries>
                                <RadzenLegend Position="LegendPosition.Bottom" />
                            </RadzenChart>
                        </RadzenColumn>
                        <RadzenColumn Size="12" SizeMd="6">
                            <RadzenDataGrid TItem="CategorySpend" Data="@overview.SpendingByCategory" Density="Density.Compact" AllowPaging="false">
                                <Columns>
                                    <RadzenDataGridColumn TItem="CategorySpend" Property="Category" Title="@L["Dashboard.ColCategory"]" />
                                    <RadzenDataGridColumn TItem="CategorySpend" Property="Amount" Title="@L["Common.Amount"]" TextAlign="TextAlign.Right" Width="120px">
                                        <Template Context="row">@Money.Eur(row.Amount)</Template>
                                    </RadzenDataGridColumn>
                                </Columns>
                            </RadzenDataGrid>
                        </RadzenColumn>
                    </RadzenRow>
                }
                @if (overview.UncategorizedCount > 0)
                {
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                        @L["Dashboard.UncategorizedCount", overview.UncategorizedCount]
                        <RadzenLink Path="review" Text="@L["Dashboard.ReviewThemLink"]" />.
                    </RadzenText>
                }
            </RadzenStack>
        </SectionCard>

        @* ---------- Placeholders for later Phase 4 slices ---------- *@
        <RadzenRow Gap="1rem">
            <RadzenColumn Size="12" SizeMd="6">
                <SectionCard Title="@L["Dashboard.NetWorth"]" FullHeight="true">
                    <RadzenStack Gap="0.5rem">
                        @if (netWorth is null)
                        {
                            <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">@L["Common.Loading"]</RadzenText>
                        }
                        else
                        {
                            <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">@Money.Eur(netWorth.Current)</RadzenText>
                            @if (netWorthChart.Count > 1)
                            {
                                <RadzenChart Style="height: 130px;">
                                    <RadzenAreaSeries Data="@netWorthChart" CategoryProperty="Label" ValueProperty="Amount" />
                                    <RadzenValueAxis Formatter="@(v => $"{v:N0} €")" />
                                </RadzenChart>
                            }
                            @if (netWorth.AccountsWithoutBalance > 0)
                            {
                                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                    @L["Dashboard.AccountsWithoutBalance", netWorth.AccountsWithoutBalance]
                                    @* No literal space before the trailing fragment: each culture
                                       owns its own leading separator, so German can attach a comma
                                       directly to the link without a space in front of it. *@
                                    <RadzenLink Path="settings/accounts" Text="@L["Dashboard.SetOneLink"]" />@L["Dashboard.ToIncludeThem"]
                                </RadzenText>
                            }
                        }
                    </RadzenStack>
                </SectionCard>
            </RadzenColumn>
            <RadzenColumn Size="12" SizeMd="6">
                <SectionCard Title="@L["Nav.Budgets"]" FullHeight="true">
                    <RadzenStack Gap="0.75rem">
                        @if (overview.Budgets.Count == 0)
                        {
                            <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                                @L["Dashboard.NoBudgetsSet"] <RadzenLink Path="settings/budgets" Text="@L["Dashboard.AddOneLink"]" />.
                            </RadzenText>
                        }
                        else
                        {
                            @foreach (var budget in overview.Budgets)
                            {
                                <div>
                                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                        <RadzenText TextStyle="TextStyle.Caption">@budget.Category</RadzenText>
                                        <RadzenText TextStyle="TextStyle.Caption" Style="@(budget.IsOver ? "color: var(--rz-danger);" : "")">
                                            @Money.Eur(budget.Spent) / @Money.Eur(budget.Limit)
                                        </RadzenText>
                                    </RadzenStack>
                                    <RadzenProgressBar Value="@((double)Math.Min(budget.Percent, 100))" ShowValue="false"
                                                       ProgressBarStyle="@(budget.IsOver ? ProgressBarStyle.Danger : ProgressBarStyle.Primary)"
                                                       Style="height: 0.5rem;" />
                                </div>
                            }
                        }
                    </RadzenStack>
                </SectionCard>
            </RadzenColumn>
        </RadzenRow>

        @* ---------- Crypto holdings ---------- *@
        @if (crypto is { Positions.Count: > 0 })
        {
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMd="6">
                    <SectionCard Title="@L["Nav.Crypto"]">
                        <Actions>
                            <RadzenLink Path="settings/crypto" Text="@L["Dashboard.HoldingsLink"]" />
                        </Actions>
                        <ChildContent>
                            <RadzenStack Gap="0.5rem">
                                <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">@Money.Eur(crypto.TotalEur)</RadzenText>
                                @foreach (var position in crypto.Positions)
                                {
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                                        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; flex: 1;">
                                            @position.Symbol · @position.Quantity.ToString("0.########")
                                        </RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
                                            @(position.EurValue is decimal value ? Money.Eur(value) : L["Common.NoPriceYet"])
                                        </RadzenText>
                                    </RadzenStack>
                                }
                                @if (crypto.OldestPriceAt is DateTimeOffset pricesAsOf
                                    && DateTimeOffset.UtcNow - pricesAsOf > TimeSpan.FromHours(48))
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                        @L["Dashboard.PricesFrom", Dates.Short(pricesAsOf.LocalDateTime)]
                                        <RadzenLink Path="settings/crypto" Text="@L["Dashboard.HoldingsPageLink"]" />.
                                    </RadzenText>
                                }
                            </RadzenStack>
                        </ChildContent>
                    </SectionCard>
                </RadzenColumn>
            </RadzenRow>
        }

        @* ---------- Upcoming & overdue planned items ---------- *@
        <SectionCard Title="@L["Dashboard.UpcomingOverdue"]">
            <Actions>
                <RadzenLink Path="planning" Text="@L["Nav.Planning"]" />
            </Actions>
            <ChildContent>
                <RadzenStack Gap="0.75rem">
                    @if (upcoming.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                            @L["Dashboard.NothingUpcoming"] <RadzenLink Path="planning" Text="@L["Dashboard.AddPlannedItemsLink"]" />.
                        </RadzenText>
                    }
                    else
                    {
                        @foreach (var o in upcoming)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                                <StatusBadge Variant="@(o.Status == PlannedOccurrenceStatus.Overdue ? BadgeVariant.Danger : BadgeVariant.Info)"
                                             Text="@Dates.DayMonth(o.DueDate)" />
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; flex: 1;">@o.Description</RadzenText>
                                <AmountText Amount="o.Amount" />
                            </RadzenStack>
                        }
                    }
                </RadzenStack>
            </ChildContent>
        </SectionCard>
    }

</PageBody>

@code {
    private sealed record ChartPoint(string Label, decimal Amount);

    private readonly CancellationTokenSource _cts = new();

    private DateOnly MonthStart = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private MonthlyOverview? overview;
    private NetWorthOverview? netWorth;
    private CryptoOverview? crypto;
    private IReadOnlyList<ChartPoint> netWorthChart = [];
    private IReadOnlyList<PlannedOccurrence> upcoming = [];

    private bool IsCurrentMonth =>
        MonthStart.Year == DateTime.Today.Year && MonthStart.Month == DateTime.Today.Month;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        netWorth = await NetWorthService.GetAsync(cancellationToken: _cts.Token);
        netWorthChart = netWorth
            .Series.Select(p => new ChartPoint(Dates.ChartMonth(p.Date), p.Amount))
            .ToList();
        upcoming = await PlanningService.GetUpcomingAsync(cancellationToken: _cts.Token);
        crypto = await CryptoService.GetOverviewAsync(_cts.Token);
    }

    private async Task LoadAsync() =>
        overview = await DashboardService.GetMonthlyOverviewAsync(
            MonthStart.Year,
            MonthStart.Month,
            _cts.Token
        );

    private async Task OnMonthChangedAsync(DateOnly month)
    {
        MonthStart = month;
        overview = null;
        await LoadAsync();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
