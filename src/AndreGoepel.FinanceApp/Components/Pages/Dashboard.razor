@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using AndreGoepel.FinanceApp.Insights
@using AndreGoepel.FinanceApp.Planning

@inject IDashboardService DashboardService
@inject INetWorthService NetWorthService
@inject IPlanningService PlanningService
@inject ICryptoService CryptoService

<AppPageTitle Title="Dashboard" />

<div class="rz-p-4 rz-p-md-6">
    <RadzenStack Gap="1.5rem">

        <PageHeader Title="Dashboard">
            <Actions>
                <MonthNavigator Month="MonthStart" DisableNext="IsCurrentMonth" MonthChanged="OnMonthChangedAsync" />
            </Actions>
        </PageHeader>

        @if (overview is null)
        {
            <RadzenText>Loading…</RadzenText>
        }
        else
        {
            @if (overview.UnconvertedCount > 0)
            {
                <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
                    @overview.UnconvertedCount transaction(s) this month are awaiting EUR conversion and
                    are not yet included in the totals.
                </RadzenAlert>
            }

            @* ---------- Month totals ---------- *@
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMd="4">
                    <StatTile Label="Income" Value="@Money.Eur(overview.Income)" Variant="BadgeVariant.Success" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMd="4">
                    <StatTile Label="Expenses" Value="@Money.Eur(overview.Expenses)" Variant="BadgeVariant.Danger" />
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMd="4">
                    <StatTile Label="Net" Value="@Money.Eur(overview.Net)"
                              Variant="@(overview.Net >= 0 ? BadgeVariant.Success : BadgeVariant.Danger)" />
                </RadzenColumn>
            </RadzenRow>

            @* ---------- Spending by category ---------- *@
            <RadzenCard>
                <RadzenStack Gap="1rem">
                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Spending by category</RadzenText>
                    @if (overview.SpendingByCategory.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                            No expenses recorded for this month.
                        </RadzenText>
                    }
                    else
                    {
                        <RadzenRow Gap="1rem" AlignItems="AlignItems.Center">
                            <RadzenColumn Size="12" SizeMd="6">
                                <RadzenChart>
                                    <RadzenDonutSeries Data="@overview.SpendingByCategory" CategoryProperty="Category" ValueProperty="Amount">
                                        <TitleTemplate>
                                            <div class="rz-donut-content">
                                                <RadzenText TextStyle="TextStyle.Caption">Expenses</RadzenText>
                                            </div>
                                        </TitleTemplate>
                                    </RadzenDonutSeries>
                                    <RadzenLegend Position="LegendPosition.Bottom" />
                                </RadzenChart>
                            </RadzenColumn>
                            <RadzenColumn Size="12" SizeMd="6">
                                <RadzenDataGrid TItem="CategorySpend" Data="@overview.SpendingByCategory" Density="Density.Compact" AllowPaging="false">
                                    <Columns>
                                        <RadzenDataGridColumn TItem="CategorySpend" Property="Category" Title="Category" />
                                        <RadzenDataGridColumn TItem="CategorySpend" Property="Amount" Title="Amount" TextAlign="TextAlign.Right" Width="120px">
                                            <Template Context="row">@Money.Eur(row.Amount)</Template>
                                        </RadzenDataGridColumn>
                                    </Columns>
                                </RadzenDataGrid>
                            </RadzenColumn>
                        </RadzenRow>
                    }
                    @if (overview.UncategorizedCount > 0)
                    {
                        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                            @overview.UncategorizedCount transaction(s) are uncategorized —
                            <RadzenLink Path="review" Text="review them" />.
                        </RadzenText>
                    }
                </RadzenStack>
            </RadzenCard>

            @* ---------- Placeholders for later Phase 4 slices ---------- *@
            <RadzenRow Gap="1rem">
                <RadzenColumn Size="12" SizeMd="6">
                    <RadzenCard>
                        <RadzenStack Gap="0.5rem">
                            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Net worth</RadzenText>
                            @if (netWorth is null)
                            {
                                <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">Loading…</RadzenText>
                            }
                            else
                            {
                                <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">@Money.Eur(netWorth.Current)</RadzenText>
                                @if (netWorthChart.Count > 1)
                                {
                                    <RadzenChart Style="height: 130px;">
                                        <RadzenAreaSeries Data="@netWorthChart" CategoryProperty="Label" ValueProperty="Amount" />
                                        <RadzenValueAxis Formatter="@(v => $"{v:N0} €")" />
                                    </RadzenChart>
                                }
                                @if (netWorth.AccountsWithoutBalance > 0)
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                        @netWorth.AccountsWithoutBalance account(s) have no balance set —
                                        <RadzenLink Path="settings/accounts" Text="set one" /> to include them.
                                    </RadzenText>
                                }
                            }
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
                <RadzenColumn Size="12" SizeMd="6">
                    <RadzenCard>
                        <RadzenStack Gap="0.75rem">
                            <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Budgets</RadzenText>
                            @if (overview.Budgets.Count == 0)
                            {
                                <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                                    No budgets set — <RadzenLink Path="settings/budgets" Text="add one" />.
                                </RadzenText>
                            }
                            else
                            {
                                @foreach (var budget in overview.Budgets)
                                {
                                    <div>
                                        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                                            <RadzenText TextStyle="TextStyle.Caption">@budget.Category</RadzenText>
                                            <RadzenText TextStyle="TextStyle.Caption" Style="@(budget.IsOver ? "color: var(--rz-danger);" : "")">
                                                @Money.Eur(budget.Spent) / @Money.Eur(budget.Limit)
                                            </RadzenText>
                                        </RadzenStack>
                                        <RadzenProgressBar Value="@((double)Math.Min(budget.Percent, 100))" ShowValue="false"
                                                           ProgressBarStyle="@(budget.IsOver ? ProgressBarStyle.Danger : ProgressBarStyle.Primary)"
                                                           Style="height: 0.5rem;" />
                                    </div>
                                }
                            }
                        </RadzenStack>
                    </RadzenCard>
                </RadzenColumn>
            </RadzenRow>

            @* ---------- Crypto holdings ---------- *@
            @if (crypto is { Positions.Count: > 0 })
            {
                <RadzenRow Gap="1rem">
                    <RadzenColumn Size="12" SizeMd="6">
                        <RadzenCard>
                            <RadzenStack Gap="0.5rem">
                                <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Crypto</RadzenText>
                                    <RadzenLink Path="settings/crypto" Text="Holdings" />
                                </RadzenStack>
                                <RadzenText TextStyle="TextStyle.H4" Style="margin: 0;">@Money.Eur(crypto.TotalEur)</RadzenText>
                                @foreach (var position in crypto.Positions)
                                {
                                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                                        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; flex: 1;">
                                            @position.Symbol · @position.Quantity.ToString("0.########")
                                        </RadzenText>
                                        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0;">
                                            @(position.EurValue is decimal value ? Money.Eur(value) : "no price yet")
                                        </RadzenText>
                                    </RadzenStack>
                                }
                                @if (crypto.OldestPriceAt is DateTimeOffset pricesAsOf
                                    && DateTimeOffset.UtcNow - pricesAsOf > TimeSpan.FromHours(48))
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                        Prices from @pricesAsOf.LocalDateTime.ToString("dd.MM.yyyy") — refresh on the
                                        <RadzenLink Path="settings/crypto" Text="holdings page" />.
                                    </RadzenText>
                                }
                            </RadzenStack>
                        </RadzenCard>
                    </RadzenColumn>
                </RadzenRow>
            }

            @* ---------- Upcoming & overdue planned items ---------- *@
            <RadzenCard>
                <RadzenStack Gap="0.75rem">
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
                        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Upcoming &amp; overdue</RadzenText>
                        <RadzenLink Path="planning" Text="Planning" />
                    </RadzenStack>
                    @if (upcoming.Count == 0)
                    {
                        <RadzenText TextStyle="TextStyle.Body2" Style="color: var(--rz-text-secondary-color);">
                            Nothing upcoming — <RadzenLink Path="planning" Text="add planned items" />.
                        </RadzenText>
                    }
                    else
                    {
                        @foreach (var o in upcoming)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                                <StatusBadge Variant="@(o.Status == PlannedOccurrenceStatus.Overdue ? BadgeVariant.Danger : BadgeVariant.Info)"
                                             Text="@o.DueDate.ToString("dd.MM")" />
                                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; flex: 1;">@o.Description</RadzenText>
                                <AmountText Amount="o.Amount" />
                            </RadzenStack>
                        }
                    }
                </RadzenStack>
            </RadzenCard>
        }

    </RadzenStack>
</div>

@code {
    private sealed record ChartPoint(string Label, decimal Amount);

    private DateOnly MonthStart = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private MonthlyOverview? overview;
    private NetWorthOverview? netWorth;
    private CryptoOverview? crypto;
    private IReadOnlyList<ChartPoint> netWorthChart = [];
    private IReadOnlyList<PlannedOccurrence> upcoming = [];

    private bool IsCurrentMonth =>
        MonthStart.Year == DateTime.Today.Year && MonthStart.Month == DateTime.Today.Month;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        netWorth = await NetWorthService.GetAsync();
        netWorthChart = netWorth
            .Series.Select(p => new ChartPoint(p.Date.ToString("MMM yy"), p.Amount))
            .ToList();
        upcoming = await PlanningService.GetUpcomingAsync();
        crypto = await CryptoService.GetOverviewAsync();
    }

    private async Task LoadAsync() =>
        overview = await DashboardService.GetMonthlyOverviewAsync(MonthStart.Year, MonthStart.Month);

    private async Task OnMonthChangedAsync(DateOnly month)
    {
        MonthStart = month;
        overview = null;
        await LoadAsync();
    }
}
