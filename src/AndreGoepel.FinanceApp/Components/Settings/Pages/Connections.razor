@page "/settings/connections"
@attribute [Authorize]
@rendermode InteractiveServer
@using AndreGoepel.FinanceApp.Connectors.Providers.Wise
@using AndreGoepel.Marten.Identity.Users
@using Microsoft.AspNetCore.Identity

@inject ICredentialStore CredentialStore
@inject IProviderConnectionService ConnectionService
@inject IWiseBalanceService WiseBalanceService
@inject IAccountSyncService SyncService
@inject IMessageBus MessageBus
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject UserManager<User> UserManager
@inject ConfirmService ConfirmService
@inject IStringLocalizer<Strings> L

<AppPageTitle Title="@L["Nav.Connections"]" Breadcrumb="@L["Common.SettingsBreadcrumb", L["Nav.Connections"]]" />

<PageBody>

    <PageHeader Title="@L["Nav.Connections"]" Subtitle="@L["Connections.Subtitle"]" />

    @* ---------- Enable Banking application (global) ---------- *@
    <SectionCard Title="@L["Connections.EbAppTitle"]">
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                @L["Connections.EbAppIntro"] <code>@CallbackUrl</code>
            </RadzenText>

            <RadzenRow Gap="0.5rem" AlignItems="AlignItems.Center">
                <RadzenColumn Size="4"><RadzenText>@L["Connections.ApplicationIdLabel"]</RadzenText></RadzenColumn>
                <RadzenColumn Size="8">@StateBadge(ebAppIdInfo)</RadzenColumn>
            </RadzenRow>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                <RadzenTextBox @bind-Value=@ebAppIdInput autocomplete="off"
                               Placeholder="@(ebAppIdInfo is null ? L["Connections.ApplicationIdPlaceholder"] : L["Connections.RotateIdPlaceholder"])"
                               Style="flex: 1;" />
                <RadzenButton Text="@L["Common.Save"]" Icon="save" ButtonStyle="ButtonStyle.Primary"
                              Disabled=@string.IsNullOrWhiteSpace(ebAppIdInput)
                              Click=@(() => SaveGlobalCredAsync(CredentialKeys.EnableBankingApplicationId, ebAppIdInput, () => ebAppIdInput = "")) />
            </RadzenStack>

            <RadzenRow Gap="0.5rem" AlignItems="AlignItems.Center">
                <RadzenColumn Size="4"><RadzenText>@L["Connections.PrivateKeyLabel"]</RadzenText></RadzenColumn>
                <RadzenColumn Size="8">@StateBadge(ebKeyInfo)</RadzenColumn>
            </RadzenRow>
            <RadzenTextArea @bind-Value=@ebKeyInput Rows="4" autocomplete="off"
                            Placeholder="-----BEGIN PRIVATE KEY-----" Style="width: 100%; font-family: monospace;" />
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton Text="@L["Connections.SaveKey"]" Icon="save" ButtonStyle="ButtonStyle.Primary"
                              Disabled=@string.IsNullOrWhiteSpace(ebKeyInput)
                              Click=@(() => SaveGlobalCredAsync(CredentialKeys.EnableBankingPrivateKey, ebKeyInput, () => ebKeyInput = "")) />
            </RadzenStack>
        </RadzenStack>
    </SectionCard>

    @* ---------- Add a connection ---------- *@
    <SectionCard Title="@L["Connections.AddTitle"]">
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.End">
                <FormField Label="@L["Common.Provider"]" For="Provider">
                    <RadzenDropDown @bind-Value=@newProvider Name="Provider" Data=@ConnectionProviders Style="min-width: 9rem;" />
                </FormField>
                <FormField Label="@L["Connections.LabelLabel"]" For="Label">
                    <RadzenTextBox @bind-Value=@newLabel Name="Label" Placeholder="@L["Connections.LabelPlaceholder"]" Style="min-width: 14rem;" />
                </FormField>
                <FormField Label="@L["Common.Owner"]" For="Owner">
                    <RadzenDropDown TValue="Guid?" @bind-Value=@newOwnerUserId Name="Owner" Data=@users
                                    ValueProperty="StreamId" TextProperty="UserName"
                                    AllowClear="true" Placeholder="@L["Accounts.SelectUserPlaceholder"]" Style="min-width: 13rem;" />
                </FormField>
                @if (newProvider == ProviderKind.Wise)
                {
                    <FormField Label="@L["Connections.EnvironmentLabel"]" For="Environment">
                        <RadzenDropDown @bind-Value=@newEnvironment Name="Environment" Data=@Environments Style="min-width: 9rem;">
                            <Template>@L[$"Enum.ProviderEnvironment.{context}"]</Template>
                        </RadzenDropDown>
                    </FormField>
                }
                else
                {
                    <FormField Label="@L["Connections.AspspLabel"]" For="Aspsp">
                        <RadzenTextBox @bind-Value=@newAspspName Name="Aspsp" Placeholder="Mock ASPSP / DKB" Style="min-width: 11rem;" />
                    </FormField>
                    <FormField Label="@L["Connections.CountryLabel"]" For="Country">
                        <RadzenTextBox @bind-Value=@newAspspCountry Name="Country" Placeholder="DE" Style="width: 5.5rem;" MaxLength="2" />
                    </FormField>
                }
                <RadzenButton Text="@L["Common.Add"]" Icon="add" ButtonStyle="ButtonStyle.Primary"
                              Disabled=@string.IsNullOrWhiteSpace(newLabel) Click=@AddConnectionAsync />
            </RadzenStack>
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                @L["Connections.SandboxHint"]
            </RadzenText>
        </RadzenStack>
    </SectionCard>

    @* ---------- Existing connections ---------- *@
    @if (connections.Count == 0)
    {
        <EmptyState Icon="@("🔗")" Title="@L["Connections.EmptyTitle"]"
                    Text="@L["Connections.EmptyText", L["Nav.Accounts"]]" />
    }
    else
    {
        foreach (var connection in connections)
        {
            <SectionCard Title="@connection.Label">
                <Actions>
                    <StatusBadge Variant="BadgeVariant.Neutral" Text="@connection.Provider.ToString()" />
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                        @OwnerName(connection.OwnerUserId)
                    </RadzenText>
                    <IconButton Icon="delete" Title="@L["Connections.DeleteTooltip"]" Danger="true"
                                Click=@(_ => DeleteConnectionAsync(connection)) />
                </Actions>
                <ChildContent>
                    <RadzenStack Gap="1rem">
                    @if (connection.Provider == ProviderKind.Wise)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                            @StateBadge(WiseTokenInfo(connection.Id))
                            <RadzenPassword Value=@WiseInput(connection.Id) ValueChanged=@(v => wiseInputs[connection.Id] = v)
                                            autocomplete="off"
                                            Placeholder="@(WiseTokenInfo(connection.Id) is null ? L["Connections.WiseTokenPlaceholder"] : L["Connections.RotateTokenPlaceholder"])"
                                            Style="flex: 1;" />
                            <RadzenButton Text="@L["Connections.SaveToken"]" Icon="save" ButtonStyle="ButtonStyle.Primary"
                                          Disabled=@string.IsNullOrWhiteSpace(WiseInput(connection.Id))
                                          Click=@(() => SaveWiseTokenAsync(connection.Id)) />
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                            <RadzenText TextStyle="TextStyle.Caption">@L["Connections.EnvironmentLabel"]</RadzenText>
                            <RadzenDropDown TValue="ProviderEnvironment" Value=@connection.Environment Data=@Environments
                                            Change=@(args => ChangeEnvironmentAsync(connection.Id, (ProviderEnvironment)args))
                                            Style="min-width: 9rem;">
                                <Template>@L[$"Enum.ProviderEnvironment.{context}"]</Template>
                            </RadzenDropDown>
                            <div style="flex: 1;"></div>
                            <RadzenButton Text="@L["Connections.ImportAccounts"]" Icon="library_add" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                                          title="@L["Connections.ImportAccountsTooltip"]"
                                          Disabled=@(WiseTokenInfo(connection.Id) is null || importingConnectionId == connection.Id || syncingConnectionId == connection.Id)
                                          IsBusy=@(importingConnectionId == connection.Id)
                                          Click=@(() => ImportAccountsAsync(connection.Id)) />
                            <RadzenButton Text="@L["Connections.SyncBalances"]" Icon="sync" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                                          Disabled=@(WiseTokenInfo(connection.Id) is null || syncingConnectionId == connection.Id || importingConnectionId == connection.Id || fullSyncingConnectionId == connection.Id)
                                          IsBusy=@(syncingConnectionId == connection.Id)
                                          Click=@(() => SyncBalancesAsync(connection.Id)) />
                            <RadzenButton Text="@L["Connections.FullSync"]" Icon="history" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                                          title="@L["Connections.FullSyncTooltip"]"
                                          Disabled=@(WiseTokenInfo(connection.Id) is null || syncingConnectionId == connection.Id || importingConnectionId == connection.Id || fullSyncingConnectionId == connection.Id)
                                          IsBusy=@(fullSyncingConnectionId == connection.Id)
                                          Click=@(() => FullSyncAsync(connection.Id)) />
                        </RadzenStack>
                        @if (balanceResults.TryGetValue(connection.Id, out var balances))
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                @string.Join(" · ", balances.Select(b => string.IsNullOrWhiteSpace(b.Name)
                                    ? L["Connections.BalanceEntry", $"{b.Amount:N2}", b.Currency, b.Id]
                                    : L["Connections.BalanceEntryNamed", b.Name, $"{b.Amount:N2}", b.Currency, b.Id]))
                            </RadzenText>
                        }
                    }
                    else
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                            @ConsentBadge(connection)
                            @if (connection.LinkedAccounts.Count > 0)
                            {
                                <RadzenText TextStyle="TextStyle.Caption">@L["Connections.LinkedAccountsCount", connection.LinkedAccounts.Count]</RadzenText>
                            }
                            <div style="flex: 1;"></div>
                            <RadzenButton Text="@(connection.ConsentStatus == ConsentStatus.Authorized ? L["Connections.Reconnect"] : L["Connections.Connect"])"
                                          Icon="link" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                                          Click=@(() => ConnectAsync(connection.Id)) />
                        </RadzenStack>
                    }
                    </RadzenStack>
                </ChildContent>
            </SectionCard>
        }
    }

</PageBody>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private static readonly ProviderKind[] ConnectionProviders =
        [ProviderKind.Wise, ProviderKind.Dkb, ProviderKind.Revolut];
    private static readonly ProviderEnvironment[] Environments = Enum.GetValues<ProviderEnvironment>();

    private IReadOnlyList<User> users = [];
    private IReadOnlyList<ProviderConnection> connections = [];

    private CredentialInfo? ebAppIdInfo;
    private CredentialInfo? ebKeyInfo;
    private string ebAppIdInput = "";
    private string ebKeyInput = "";

    private ProviderKind newProvider = ProviderKind.Wise;
    private string newLabel = "";
    private Guid? newOwnerUserId;
    private ProviderEnvironment newEnvironment = ProviderEnvironment.Sandbox;
    private string newAspspName = "";
    private string newAspspCountry = "DE";

    private readonly Dictionary<Guid, string> wiseInputs = [];
    private readonly Dictionary<Guid, CredentialInfo?> wiseTokenInfos = [];
    private readonly Dictionary<Guid, IReadOnlyList<WiseBalance>> balanceResults = [];
    private Guid? syncingConnectionId;
    private Guid? importingConnectionId;
    private Guid? fullSyncingConnectionId;

    private string CallbackUrl => new Uri(new Uri(Navigation.BaseUri), "enablebanking/callback").ToString();

    private async Task<string?> CurrentUserAsync() =>
        AuthenticationState is null ? null : (await AuthenticationState).User.Identity?.Name;

    protected override async Task OnInitializedAsync()
    {
        users = await UserManager.Users.Where(u => !u.Deleted).OrderBy(u => u.UserName).ToListAsync();
        await LoadAsync();
        ShowCallbackFeedback();
    }

    private async Task LoadAsync()
    {
        ebAppIdInfo = await CredentialStore.GetInfoAsync(CredentialKeys.EnableBankingApplicationId);
        ebKeyInfo = await CredentialStore.GetInfoAsync(CredentialKeys.EnableBankingPrivateKey);
        connections = (await ConnectionService.GetAllAsync())
            .OrderBy(c => c.Provider).ThenBy(c => c.Label).ToList();

        wiseTokenInfos.Clear();
        foreach (var connection in connections.Where(c => c.Provider == ProviderKind.Wise))
        {
            wiseTokenInfos[connection.Id] =
                await CredentialStore.GetInfoAsync(CredentialKeys.WiseApiToken(connection.Id));
        }
    }

    private string OwnerName(Guid? ownerUserId) =>
        ownerUserId is Guid id
            ? users.FirstOrDefault(u => u.StreamId == id)?.UserName ?? L["Connections.UnknownUser"]
            : L["Connections.NoOwner"];

    private CredentialInfo? WiseTokenInfo(Guid connectionId) =>
        wiseTokenInfos.TryGetValue(connectionId, out var info) ? info : null;

    private string WiseInput(Guid connectionId) =>
        wiseInputs.TryGetValue(connectionId, out var value) ? value : "";

    private async Task SaveGlobalCredAsync(string key, string value, Action clearInput)
    {
        var result = await MessageBus.InvokeAsync<Result>(new SaveProviderCredentialCommand(key, value));
        if (result.IsFailure)
        {
            NotificationService.Error("Saving failed", result.Error);
            return;
        }
        clearInput();
        await LoadAsync();
        NotificationService.Success(L["Common.Saved"], L["Connections.StoredEncrypted"]);
    }

    private async Task AddConnectionAsync()
    {
        var result = await ConnectionService.CreateAsync(
            newProvider, newLabel, newOwnerUserId, newEnvironment, newAspspName, newAspspCountry);
        if (result.IsFailure)
        {
            NotificationService.Error(L["Connections.CouldNotAddTitle"], result.Error);
            return;
        }
        newLabel = "";
        newOwnerUserId = null;
        newEnvironment = ProviderEnvironment.Sandbox;
        newAspspName = "";
        newAspspCountry = "DE";
        await LoadAsync();
        NotificationService.Success(L["Connections.AddedTitle"], result.Value!.Label);
    }

    private async Task ChangeEnvironmentAsync(Guid connectionId, ProviderEnvironment environment)
    {
        var result = await ConnectionService.SetEnvironmentAsync(connectionId, environment);
        if (result.IsFailure)
        {
            NotificationService.Error(L["Connections.CouldNotChangeEnvTitle"], result.Error);
            return;
        }
        await LoadAsync();
    }

    private async Task SyncBalancesAsync(Guid connectionId)
    {
        syncingConnectionId = connectionId;
        try
        {
            var result = await WiseBalanceService.SyncConnectionAsync(connectionId);
            if (result.IsFailure)
            {
                NotificationService.Error(L["Connections.BalanceSyncFailedTitle"], result.Error);
                return;
            }
            balanceResults[connectionId] = result.Value!.Balances;
            NotificationService.Success(
                "Balances synced",
                $"{result.Value.Balances.Count} balance(s) fetched, {result.Value.AccountsUpdated} account(s) updated."
            );
        }
        finally
        {
            syncingConnectionId = null;
        }
    }

    private async Task ImportAccountsAsync(Guid connectionId)
    {
        importingConnectionId = connectionId;
        try
        {
            var result = await WiseBalanceService.ImportAccountsAsync(connectionId);
            if (result.IsFailure)
            {
                NotificationService.Error(L["Connections.ImportFailedTitle"], result.Error);
                return;
            }
            var created = result.Value!.CreatedAccountNames;
            NotificationService.Notify(
                created.Count > 0 ? NotificationSeverity.Success : NotificationSeverity.Info,
                created.Count > 0 ? "Accounts created" : "Nothing to import",
                created.Count > 0
                    ? $"{string.Join(", ", created)} — {result.Value.AlreadyLinked} balance(s) were already linked."
                    : $"All {result.Value.AlreadyLinked} balance(s) are already linked to accounts."
            );
        }
        finally
        {
            importingConnectionId = null;
        }
    }

    private async Task FullSyncAsync(Guid connectionId)
    {
        var confirmed = await ConfirmService.ConfirmAsync(
            L["Connections.FullSyncConfirm"],
            title: L["Connections.FullSyncConfirmTitle"],
            okText: L["Connections.FullSyncConfirmAction"]
        );
        if (!confirmed)
        {
            return;
        }

        fullSyncingConnectionId = connectionId;
        try
        {
            var summaries = await SyncService.SyncAllAsync(
                await CurrentUserAsync(),
                fullHistory: true,
                connectionId: connectionId
            );
            var failures = summaries.Where(s => s.IsFailure).ToList();
            if (failures.Count > 0)
            {
                NotificationService.Warning(
                    L["Connections.FullSyncPartialTitle"],
                    string.Join(" · ", failures.Select(f => $"{f.AccountName}: {f.Error}"))
                );
            }
            else
            {
                NotificationService.Success(
                    L["Connections.FullSyncDoneTitle"],
                    $"{summaries.Sum(s => s.Imported)} imported, {summaries.Sum(s => s.Duplicates)} duplicate(s), across {summaries.Count} account(s)."
                );
            }
        }
        finally
        {
            fullSyncingConnectionId = null;
        }
    }

    private async Task DeleteConnectionAsync(ProviderConnection connection)
    {
        if (!await ConfirmService.ConfirmDeleteAsync(L["Connections.DeleteConfirmSubject", connection.Label]))
        {
            return;
        }
        var result = await ConnectionService.DeleteAsync(connection.Id);
        if (result.IsFailure)
        {
            NotificationService.Error(L["Common.DeleteFailedTitle"], result.Error);
            return;
        }
        await LoadAsync();
        NotificationService.Success(L["Connections.DeletedTitle"], connection.Label);
    }

    private async Task SaveWiseTokenAsync(Guid connectionId)
    {
        var result = await ConnectionService.SaveWiseTokenAsync(connectionId, WiseInput(connectionId));
        if (result.IsFailure)
        {
            NotificationService.Error("Saving failed", result.Error);
            return;
        }
        wiseInputs[connectionId] = "";
        await LoadAsync();
        NotificationService.Success(L["Common.Saved"], L["Connections.WiseTokenStored"]);
    }

    private async Task ConnectAsync(Guid connectionId)
    {
        var result = await ConnectionService.StartConsentAsync(connectionId, CallbackUrl);
        if (result.IsFailure)
        {
            NotificationService.Error(L["Connections.CannotConnectTitle"], result.Error);
            return;
        }
        Navigation.NavigateTo(result.Value!, forceLoad: true); // leave for the bank's authorization page
    }

    private void ShowCallbackFeedback()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (!query.TryGetValue("consent", out var consent))
        {
            return;
        }
        switch (consent.ToString())
        {
            case "ok":
                NotificationService.Success(L["Connections.ConsentOkTitle"], L["Connections.ConsentOkMessage"]);
                break;
            case "failed":
            case "denied":
                NotificationService.Error(L["Connections.ConsentFailedTitle"], query["reason"].ToString());
                break;
            case "invalid":
                NotificationService.Warning(L["Connections.ConsentInvalidTitle"], L["Connections.ConsentInvalidMessage"]);
                break;
        }
    }

    // Instance (not static) so these can localize: both branches render user-facing text, and the
    // dates go through Dates rather than an inline format string. These two were the last inline
    // date formats in the Components tree — they hid from earlier sweeps because they are built
    // with RenderTreeBuilder rather than markup.
    private RenderFragment StateBadge(CredentialInfo? info) => builder =>
    {
        builder.OpenComponent<StatusBadge>(0);
        builder.AddAttribute(1, nameof(StatusBadge.Variant), info is null ? BadgeVariant.Warning : BadgeVariant.Success);
        builder.AddAttribute(
            2,
            nameof(StatusBadge.Text),
            info is null
                ? L["ApiKeys.NotConfigured"].Value
                : L[
                    "ApiKeys.ConfiguredOn",
                    Dates.Short((info.RotatedAt ?? info.CreatedAt).ToLocalTime())
                ].Value
        );
        builder.CloseComponent();
    };

    private RenderFragment ConsentBadge(ProviderConnection connection) => builder =>
    {
        var (variant, text) = connection switch
        {
            { ConsentStatus: ConsentStatus.Pending } => (BadgeVariant.Info, L["Connections.ConsentPending"].Value),
            { ConsentExpired: true } => (BadgeVariant.Danger, L["Sync.ConsentExpired"].Value),
            { ConsentStatus: ConsentStatus.Authorized } c => (
                BadgeVariant.Success,
                // ?? "" preserves the original behaviour: an Authorized consent with no recorded
                // expiry rendered an empty date rather than throwing.
                L[
                    "Connections.ConsentActiveUntil",
                    Dates.Short(c.ConsentExpiresAt?.ToLocalTime()) ?? ""
                ].Value
            ),
            _ => (BadgeVariant.Neutral, L["Connections.ConsentNotConnected"].Value),
        };
        builder.OpenComponent<StatusBadge>(0);
        builder.AddAttribute(1, nameof(StatusBadge.Variant), variant);
        builder.AddAttribute(2, nameof(StatusBadge.Text), text);
        builder.CloseComponent();
    };
}
