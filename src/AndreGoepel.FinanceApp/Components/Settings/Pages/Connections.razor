@page "/settings/connections"
@attribute [Authorize]
@rendermode InteractiveServer
@using AndreGoepel.FinanceApp.Connectors.Providers.Wise
@using AndreGoepel.Marten.Identity.Users
@using Microsoft.AspNetCore.Identity

@inject ICredentialStore CredentialStore
@inject IProviderConnectionService ConnectionService
@inject IWiseBalanceService WiseBalanceService
@inject IMessageBus MessageBus
@inject NavigationManager Navigation
@inject NotificationService NotificationService
@inject UserManager<User> UserManager
@inject ConfirmService ConfirmService

<AppPageTitle Title="Connections" Breadcrumb="Settings / Connections" />

<PageBody>

    <PageHeader Title="Connections"
                Subtitle="A connection is one login at a provider — a Wise profile or a bank consent — owned by a household user. One connection feeds several accounts, and each of you can have your own. Secrets are stored encrypted and never shown again after saving." />

    @* ---------- Enable Banking application (global) ---------- *@
    <SectionCard Title="Enable Banking application">
        <RadzenStack Gap="1rem">
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                One registered application for the whole app (shared by every DKB/Revolut
                connection). Set its redirect URI to <code>@CallbackUrl</code>.
            </RadzenText>

            <RadzenRow Gap="0.5rem" AlignItems="AlignItems.Center">
                <RadzenColumn Size="4"><RadzenText>Application id</RadzenText></RadzenColumn>
                <RadzenColumn Size="8">@StateBadge(ebAppIdInfo)</RadzenColumn>
            </RadzenRow>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                <RadzenTextBox @bind-Value=@ebAppIdInput autocomplete="off"
                               Placeholder="@(ebAppIdInfo is null ? "Application id (UUID)" : "Enter new id to rotate")"
                               Style="flex: 1;" />
                <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary"
                              Disabled=@string.IsNullOrWhiteSpace(ebAppIdInput)
                              Click=@(() => SaveGlobalCredAsync(CredentialKeys.EnableBankingApplicationId, ebAppIdInput, () => ebAppIdInput = "")) />
            </RadzenStack>

            <RadzenRow Gap="0.5rem" AlignItems="AlignItems.Center">
                <RadzenColumn Size="4"><RadzenText>Private key (PEM)</RadzenText></RadzenColumn>
                <RadzenColumn Size="8">@StateBadge(ebKeyInfo)</RadzenColumn>
            </RadzenRow>
            <RadzenTextArea @bind-Value=@ebKeyInput Rows="4" autocomplete="off"
                            Placeholder="-----BEGIN PRIVATE KEY-----" Style="width: 100%; font-family: monospace;" />
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenButton Text="Save key" Icon="save" ButtonStyle="ButtonStyle.Primary"
                              Disabled=@string.IsNullOrWhiteSpace(ebKeyInput)
                              Click=@(() => SaveGlobalCredAsync(CredentialKeys.EnableBankingPrivateKey, ebKeyInput, () => ebKeyInput = "")) />
            </RadzenStack>
        </RadzenStack>
    </SectionCard>

    @* ---------- Add a connection ---------- *@
    <SectionCard Title="Add connection">
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.End">
                <FormField Label="Provider" For="Provider">
                    <RadzenDropDown @bind-Value=@newProvider Name="Provider" Data=@ConnectionProviders Style="min-width: 9rem;" />
                </FormField>
                <FormField Label="Label" For="Label">
                    <RadzenTextBox @bind-Value=@newLabel Name="Label" Placeholder="e.g. André – Wise" Style="min-width: 14rem;" />
                </FormField>
                <FormField Label="Owner" For="Owner">
                    <RadzenDropDown TValue="Guid?" @bind-Value=@newOwnerUserId Name="Owner" Data=@users
                                    ValueProperty="StreamId" TextProperty="UserName"
                                    AllowClear="true" Placeholder="Select user" Style="min-width: 13rem;" />
                </FormField>
                @if (newProvider == ProviderKind.Wise)
                {
                    <FormField Label="Environment" For="Environment">
                        <RadzenDropDown @bind-Value=@newEnvironment Name="Environment" Data=@Environments Style="min-width: 9rem;" />
                    </FormField>
                }
                else
                {
                    <FormField Label="ASPSP (bank)" For="Aspsp">
                        <RadzenTextBox @bind-Value=@newAspspName Name="Aspsp" Placeholder="Mock ASPSP / DKB" Style="min-width: 11rem;" />
                    </FormField>
                    <FormField Label="Country" For="Country">
                        <RadzenTextBox @bind-Value=@newAspspCountry Name="Country" Placeholder="DE" Style="width: 5.5rem;" MaxLength="2" />
                    </FormField>
                }
                <RadzenButton Text="Add" Icon="add" ButtonStyle="ButtonStyle.Primary"
                              Disabled=@string.IsNullOrWhiteSpace(newLabel) Click=@AddConnectionAsync />
            </RadzenStack>
            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                Enable Banking sandbox uses <strong>Mock ASPSP</strong> (country DE); for production
                use the real bank name (e.g. <strong>DKB</strong>).
            </RadzenText>
        </RadzenStack>
    </SectionCard>

    @* ---------- Existing connections ---------- *@
    @if (connections.Count == 0)
    {
        <EmptyState Icon="@("🔗")" Title="No connections yet"
                    Text="Add one above, then link accounts to it under Accounts." />
    }
    else
    {
        foreach (var connection in connections)
        {
            <SectionCard Title="@connection.Label">
                <Actions>
                    <StatusBadge Variant="BadgeVariant.Neutral" Text="@connection.Provider.ToString()" />
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                        @OwnerName(connection.OwnerUserId)
                    </RadzenText>
                    <IconButton Icon="delete" Title="Delete connection" Danger="true"
                                Click=@(_ => DeleteConnectionAsync(connection)) />
                </Actions>
                <ChildContent>
                    <RadzenStack Gap="1rem">
                    @if (connection.Provider == ProviderKind.Wise)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                            @StateBadge(WiseTokenInfo(connection.Id))
                            <RadzenPassword Value=@WiseInput(connection.Id) ValueChanged=@(v => wiseInputs[connection.Id] = v)
                                            autocomplete="off"
                                            Placeholder="@(WiseTokenInfo(connection.Id) is null ? "Wise API token" : "Enter new token to rotate")"
                                            Style="flex: 1;" />
                            <RadzenButton Text="Save token" Icon="save" ButtonStyle="ButtonStyle.Primary"
                                          Disabled=@string.IsNullOrWhiteSpace(WiseInput(connection.Id))
                                          Click=@(() => SaveWiseTokenAsync(connection.Id)) />
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                            <RadzenText TextStyle="TextStyle.Caption">Environment</RadzenText>
                            <RadzenDropDown TValue="ProviderEnvironment" Value=@connection.Environment Data=@Environments
                                            Change=@(args => ChangeEnvironmentAsync(connection.Id, (ProviderEnvironment)args))
                                            Style="min-width: 9rem;" />
                            <div style="flex: 1;"></div>
                            <RadzenButton Text="Sync balances" Icon="sync" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                                          Disabled=@(WiseTokenInfo(connection.Id) is null || syncingConnectionId == connection.Id)
                                          IsBusy=@(syncingConnectionId == connection.Id)
                                          Click=@(() => SyncBalancesAsync(connection.Id)) />
                        </RadzenStack>
                        @if (balanceResults.TryGetValue(connection.Id, out var balances))
                        {
                            <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                                @string.Join(" · ", balances.Select(b => $"{b.Amount:N2} {b.Currency} (id {b.Id})"))
                            </RadzenText>
                        }
                    }
                    else
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                            @ConsentBadge(connection)
                            @if (connection.LinkedAccounts.Count > 0)
                            {
                                <RadzenText TextStyle="TextStyle.Caption">@connection.LinkedAccounts.Count linked account(s)</RadzenText>
                            }
                            <div style="flex: 1;"></div>
                            <RadzenButton Text="@(connection.ConsentStatus == ConsentStatus.Authorized ? "Reconnect" : "Connect")"
                                          Icon="link" ButtonStyle="ButtonStyle.Secondary" Size="ButtonSize.Small"
                                          Click=@(() => ConnectAsync(connection.Id)) />
                        </RadzenStack>
                    }
                    </RadzenStack>
                </ChildContent>
            </SectionCard>
        }
    }

</PageBody>

@code {
    private static readonly ProviderKind[] ConnectionProviders =
        [ProviderKind.Wise, ProviderKind.Dkb, ProviderKind.Revolut];
    private static readonly ProviderEnvironment[] Environments = Enum.GetValues<ProviderEnvironment>();

    private IReadOnlyList<User> users = [];
    private IReadOnlyList<ProviderConnection> connections = [];

    private CredentialInfo? ebAppIdInfo;
    private CredentialInfo? ebKeyInfo;
    private string ebAppIdInput = "";
    private string ebKeyInput = "";

    private ProviderKind newProvider = ProviderKind.Wise;
    private string newLabel = "";
    private Guid? newOwnerUserId;
    private ProviderEnvironment newEnvironment = ProviderEnvironment.Sandbox;
    private string newAspspName = "";
    private string newAspspCountry = "DE";

    private readonly Dictionary<Guid, string> wiseInputs = [];
    private readonly Dictionary<Guid, CredentialInfo?> wiseTokenInfos = [];
    private readonly Dictionary<Guid, IReadOnlyList<WiseBalance>> balanceResults = [];
    private Guid? syncingConnectionId;

    private string CallbackUrl => new Uri(new Uri(Navigation.BaseUri), "enablebanking/callback").ToString();

    protected override async Task OnInitializedAsync()
    {
        users = await UserManager.Users.Where(u => !u.Deleted).OrderBy(u => u.UserName).ToListAsync();
        await LoadAsync();
        ShowCallbackFeedback();
    }

    private async Task LoadAsync()
    {
        ebAppIdInfo = await CredentialStore.GetInfoAsync(CredentialKeys.EnableBankingApplicationId);
        ebKeyInfo = await CredentialStore.GetInfoAsync(CredentialKeys.EnableBankingPrivateKey);
        connections = (await ConnectionService.GetAllAsync())
            .OrderBy(c => c.Provider).ThenBy(c => c.Label).ToList();

        wiseTokenInfos.Clear();
        foreach (var connection in connections.Where(c => c.Provider == ProviderKind.Wise))
        {
            wiseTokenInfos[connection.Id] =
                await CredentialStore.GetInfoAsync(CredentialKeys.WiseApiToken(connection.Id));
        }
    }

    private string OwnerName(Guid? ownerUserId) =>
        ownerUserId is Guid id
            ? users.FirstOrDefault(u => u.StreamId == id)?.UserName ?? "unknown user"
            : "no owner";

    private CredentialInfo? WiseTokenInfo(Guid connectionId) =>
        wiseTokenInfos.TryGetValue(connectionId, out var info) ? info : null;

    private string WiseInput(Guid connectionId) =>
        wiseInputs.TryGetValue(connectionId, out var value) ? value : "";

    private async Task SaveGlobalCredAsync(string key, string value, Action clearInput)
    {
        var result = await MessageBus.InvokeAsync<Result>(new SaveProviderCredentialCommand(key, value));
        if (result.IsFailure)
        {
            NotificationService.Error("Saving failed", result.Error);
            return;
        }
        clearInput();
        await LoadAsync();
        NotificationService.Success("Saved", "Stored encrypted.");
    }

    private async Task AddConnectionAsync()
    {
        var result = await ConnectionService.CreateAsync(
            newProvider, newLabel, newOwnerUserId, newEnvironment, newAspspName, newAspspCountry);
        if (result.IsFailure)
        {
            NotificationService.Error("Could not add connection", result.Error);
            return;
        }
        newLabel = "";
        newOwnerUserId = null;
        newEnvironment = ProviderEnvironment.Sandbox;
        newAspspName = "";
        newAspspCountry = "DE";
        await LoadAsync();
        NotificationService.Success("Connection added", result.Value!.Label);
    }

    private async Task ChangeEnvironmentAsync(Guid connectionId, ProviderEnvironment environment)
    {
        var result = await ConnectionService.SetEnvironmentAsync(connectionId, environment);
        if (result.IsFailure)
        {
            NotificationService.Error("Could not change environment", result.Error);
            return;
        }
        await LoadAsync();
    }

    private async Task SyncBalancesAsync(Guid connectionId)
    {
        syncingConnectionId = connectionId;
        try
        {
            var result = await WiseBalanceService.SyncConnectionAsync(connectionId);
            if (result.IsFailure)
            {
                NotificationService.Error("Balance sync failed", result.Error);
                return;
            }
            balanceResults[connectionId] = result.Value!.Balances;
            NotificationService.Success(
                "Balances synced",
                $"{result.Value.Balances.Count} balance(s) fetched, {result.Value.AccountsUpdated} account(s) updated."
            );
        }
        finally
        {
            syncingConnectionId = null;
        }
    }

    private async Task DeleteConnectionAsync(ProviderConnection connection)
    {
        if (!await ConfirmService.ConfirmDeleteAsync($"the connection “{connection.Label}”"))
        {
            return;
        }
        var result = await ConnectionService.DeleteAsync(connection.Id);
        if (result.IsFailure)
        {
            NotificationService.Error("Delete failed", result.Error);
            return;
        }
        await LoadAsync();
        NotificationService.Success("Connection deleted", connection.Label);
    }

    private async Task SaveWiseTokenAsync(Guid connectionId)
    {
        var result = await ConnectionService.SaveWiseTokenAsync(connectionId, WiseInput(connectionId));
        if (result.IsFailure)
        {
            NotificationService.Error("Saving failed", result.Error);
            return;
        }
        wiseInputs[connectionId] = "";
        await LoadAsync();
        NotificationService.Success("Saved", "Wise token stored encrypted.");
    }

    private async Task ConnectAsync(Guid connectionId)
    {
        var result = await ConnectionService.StartConsentAsync(connectionId, CallbackUrl);
        if (result.IsFailure)
        {
            NotificationService.Error("Cannot connect", result.Error);
            return;
        }
        Navigation.NavigateTo(result.Value!, forceLoad: true); // leave for the bank's authorization page
    }

    private void ShowCallbackFeedback()
    {
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (!query.TryGetValue("consent", out var consent))
        {
            return;
        }
        switch (consent.ToString())
        {
            case "ok":
                NotificationService.Success("Consent authorized", "Bank accounts linked.");
                break;
            case "failed":
            case "denied":
                NotificationService.Error("Consent not completed", query["reason"].ToString());
                break;
            case "invalid":
                NotificationService.Warning("Consent callback invalid", "Missing code or state.");
                break;
        }
    }

    private static RenderFragment StateBadge(CredentialInfo? info) => builder =>
    {
        builder.OpenComponent<StatusBadge>(0);
        builder.AddAttribute(1, nameof(StatusBadge.Variant), info is null ? BadgeVariant.Warning : BadgeVariant.Success);
        builder.AddAttribute(2, nameof(StatusBadge.Text),
            info is null ? "not configured" : $"configured {(info.RotatedAt ?? info.CreatedAt).ToLocalTime():dd.MM.yyyy}");
        builder.CloseComponent();
    };

    private static RenderFragment ConsentBadge(ProviderConnection connection) => builder =>
    {
        var (variant, text) = connection switch
        {
            { ConsentStatus: ConsentStatus.Pending } => (BadgeVariant.Info, "pending"),
            { ConsentExpired: true } => (BadgeVariant.Danger, "expired"),
            { ConsentStatus: ConsentStatus.Authorized } c => (BadgeVariant.Success, $"active until {c.ConsentExpiresAt?.ToLocalTime():dd.MM.yyyy}"),
            _ => (BadgeVariant.Neutral, "not connected"),
        };
        builder.OpenComponent<StatusBadge>(0);
        builder.AddAttribute(1, nameof(StatusBadge.Variant), variant);
        builder.AddAttribute(2, nameof(StatusBadge.Text), text);
        builder.CloseComponent();
    };
}
