@page "/settings/accounts"
@attribute [Authorize]
@using AndreGoepel.FinanceApp.Domain.Exchange
@using AndreGoepel.Marten.Identity.Users
@using Microsoft.AspNetCore.Identity

@inject IQuerySession QuerySession
@inject IMessageBus MessageBus
@inject IExchangeRateProvider ExchangeRateProvider
@inject NotificationService NotificationService
@inject ConfirmService ConfirmService
@inject UserManager<User> UserManager
@implements IDisposable

<AppPageTitle Title="Accounts" Breadcrumb="Settings / Accounts" />

<PageBody>

    <PageHeader Title="Accounts">
        <Actions>
            <RadzenSwitch @bind-Value=@showDeactivated />
            <RadzenLabel Text="Show deactivated" />
        </Actions>
    </PageHeader>

    <DataCard>
        <RadzenDataGrid TItem="Account" Data=@DisplayedAccounts Density="Density.Compact">
            <Columns>
                <RadzenDataGridColumn TItem="Account" Property="Name" Title="Name" />
                <RadzenDataGridColumn TItem="Account" Property="Provider" Title="Provider" Width="100px" />
                <RadzenDataGridColumn TItem="Account" Property="Type" Title="Type" Width="110px" />
                <RadzenDataGridColumn TItem="Account" Property="Currency" Title="Currency" Width="80px" />
                <RadzenDataGridColumn TItem="Account" Title="Owner" Width="180px" Sortable="false">
                    <Template Context="account">@OwnerLabel(account)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Account" Property="SyncMethod" Title="Sync" Width="100px" />
                <RadzenDataGridColumn TItem="Account" Title="Status" Width="110px" Sortable="false">
                    <Template Context="account">
                        <StatusBadge Text="@(account.IsActive ? "Active" : "Deactivated")"
                                     Variant="@(account.IsActive ? BadgeVariant.Success : BadgeVariant.Neutral)" />
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Account" Title="" Width="170px" Sortable="false" TextAlign="TextAlign.End">
                    <Template Context="account">
                        <RowActions>
                            <IconButton Icon="edit" Title="Edit" Click=@(_ => StartEdit(account)) />
                            @if (account.IsActive)
                            {
                                <RadzenButton Icon="block" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Warning"
                                              class="ag-icon-btn" title="Deactivate" aria-label="Deactivate"
                                              Click=@(() => DeactivateAsync(account)) />
                            }
                            else
                            {
                                <RadzenButton Icon="restart_alt" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Success"
                                              class="ag-icon-btn" title="Reactivate" aria-label="Reactivate"
                                              Click=@(() => ReactivateAsync(account)) />
                            }
                            <IconButton Icon="delete" Title="Delete" Danger="true"
                                        Click=@(_ => DeleteAsync(account)) />
                            <IconButton Icon="delete_forever" Title="Delete permanently…" Danger="true"
                                        Click=@(_ => HardDeleteAsync(account)) />
                        </RowActions>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </DataCard>

    <CardForm TItem="InputModel"
              Data="form"
              Submit="SaveAsync"
              Cancel="ResetForm"
              Title="@(editingAccountId is null ? "Add account" : "Edit account")"
              SubmitText="@(editingAccountId is null ? "Add" : "Save")"
              CancelText="Cancel"
              IsBusy="isSaving"
              BusyText="Saving…">
        <div class="ag-form-grid">
            <FormField Label="Name" For="Name">
                <RadzenTextBox @bind-Value=@form.Name Name="Name" Disabled=@isSaving Style="width: 100%;" />
            </FormField>
            <FormField Label="Provider" For="Provider">
                <RadzenDropDown @bind-Value=@form.Provider Name="Provider" Data=@ProviderChoices
                                Disabled=@(editingAccountId is not null || isSaving) Style="width: 100%;" />
            </FormField>
            <FormField Label="Type" For="Type">
                <RadzenDropDown @bind-Value=@form.Type Name="Type" Data=@TypeChoices Disabled=@isSaving Style="width: 100%;" />
            </FormField>
            <FormField Label="Currency" For="Currency">
                <RadzenTextBox @bind-Value=@form.Currency Name="Currency" Disabled=@isSaving MaxLength="3" Style="width: 100%;" />
            </FormField>
        </div>

        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
            <RadzenSwitch @bind-Value=@form.IsShared Name="IsShared" Disabled=@isSaving Change=@OnSharedChanged />
            <RadzenLabel Text="Shared" Component="IsShared" />
        </RadzenStack>

        @if (form.IsShared)
        {
            <FormField Label="Owners" For="Owners">
                <RadzenDropDown TValue="IEnumerable<Guid>"
                                @bind-Value=@form.OwnerUserIds Name="Owners"
                                Data=@users ValueProperty="StreamId" TextProperty="UserName"
                                Multiple="true" AllowClear="true" Chips="true"
                                Disabled=@isSaving Placeholder="Select users" Style="width: 100%;" />
            </FormField>
        }
        else
        {
            <FormField Label="Owner" For="Owner">
                <RadzenDropDown TValue="Guid?"
                                @bind-Value=@SingleOwner Name="Owner"
                                Data=@users ValueProperty="StreamId" TextProperty="UserName"
                                AllowClear="true" Disabled=@isSaving Placeholder="Select user" Style="width: 100%;" />
            </FormField>
        }

        <div class="ag-form-grid">
            <FormField Label="Sync" For="Sync">
                <RadzenDropDown @bind-Value=@form.SyncMethod Name="Sync" Data=@SyncChoices Disabled=@isSaving Style="width: 100%;" />
            </FormField>
            @if (form.SyncMethod == SyncMethod.Api)
            {
                <FormField Label="Connection" For="Connection">
                    <RadzenDropDown TValue="Guid?"
                                    @bind-Value=@form.ConnectionId Name="Connection"
                                    Data=@ProviderConnections ValueProperty="Id" TextProperty="Label"
                                    AllowClear="true" Disabled=@isSaving
                                    Placeholder="@(ProviderConnections.Any() ? "Select connection" : "No " + form.Provider + " connection")"
                                    Style="width: 100%;" />
                </FormField>
                @if (form.Provider == ProviderKind.Wise)
                {
                    <FormField Label="Wise balance id" For="ExternalId">
                        <RadzenTextBox @bind-Value=@form.ExternalId Name="ExternalId" Disabled=@isSaving
                                       Placeholder="e.g. 306149" Style="width: 100%;" />
                    </FormField>
                }
                else
                {
                    <FormField Label="Bank account" For="IdentificationHash">
                        <RadzenDropDown TValue="string"
                                        @bind-Value=@form.IdentificationHash Name="IdentificationHash"
                                        Data=@LinkedAccounts ValueProperty="IdentificationHash"
                                        AllowClear="true" Disabled=@isSaving
                                        Placeholder="@(LinkedAccounts.Any() ? "Select account" : "Connect the consent first")"
                                        Style="width: 100%;">
                            <Template Context="linked">
                                @(((EnableBankingLinkedAccount)linked).Name ?? "account") — @(((EnableBankingLinkedAccount)linked).Currency)
                            </Template>
                        </RadzenDropDown>
                    </FormField>
                }
            }
        </div>

        <div class="ag-form-grid">
            <FormField Label="IBAN (optional)" For="Iban">
                <RadzenTextBox @bind-Value=@form.Iban Name="Iban" Disabled=@isSaving Style="width: 100%;" />
            </FormField>
            <FormField Label="@($"Current balance ({(string.IsNullOrWhiteSpace(form.Currency) ? "EUR" : form.Currency)})")" For="CurrentBalance">
                <RadzenNumeric TValue="decimal?" @bind-Value=@form.CurrentBalance Name="CurrentBalance"
                               Disabled=@isSaving Placeholder="for net worth" Style="width: 100%;" />
            </FormField>
        </div>
    </CardForm>

</PageBody>

@code {
    private static readonly ProviderKind[] ProviderChoices = Enum.GetValues<ProviderKind>();
    private static readonly AccountType[] TypeChoices = Enum.GetValues<AccountType>();
    private static readonly SyncMethod[] SyncChoices = Enum.GetValues<SyncMethod>();

    private readonly CancellationTokenSource _cts = new();

    private List<Account> accounts = [];
    private IReadOnlyList<User> users = [];
    private IReadOnlyList<ProviderConnection> connections = [];
    private Guid? editingAccountId;
    private InputModel form = new();
    private decimal? loadedBalance; // balance shown when editing, to detect a change
    private bool isSaving;
    private bool showDeactivated;

    private IEnumerable<Account> DisplayedAccounts =>
        showDeactivated ? accounts : accounts.Where(a => a.IsActive);

    // Connections are per provider; a Wise account can only link a Wise connection.
    private IEnumerable<ProviderConnection> ProviderConnections =>
        connections.Where(c => c.Provider == form.Provider);

    // Enable Banking accounts exposed by the selected connection's consent.
    private IEnumerable<EnableBankingLinkedAccount> LinkedAccounts =>
        connections.FirstOrDefault(c => c.Id == form.ConnectionId)?.LinkedAccounts
        ?? Enumerable.Empty<EnableBankingLinkedAccount>();

    private Guid? SingleOwner
    {
        get => form.OwnerUserIds.FirstOrDefault() is var id && id != Guid.Empty ? id : null;
        set => form.OwnerUserIds = value is Guid g ? [g] : [];
    }

    protected override async Task OnInitializedAsync()
    {
        users = await UserManager
            .Users.Where(u => !u.Deleted)
            .OrderBy(u => u.UserName)
            .ToListAsync(_cts.Token);
        connections = (await QuerySession.Query<ProviderConnection>().ToListAsync(_cts.Token))
            .OrderBy(c => c.Label)
            .ToList();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        accounts = (await QuerySession.Query<Account>().ToListAsync(_cts.Token))
            .OrderBy(a => a.Name)
            .ToList();
    }

    private string OwnerLabel(Account account)
    {
        var names = account
            .OwnerUserIds.Select(id => users.FirstOrDefault(u => u.StreamId == id)?.UserName ?? "?")
            .ToList();
        var joined = names.Count == 0 ? "—" : string.Join(", ", names);
        return account.IsShared ? $"{joined} (shared)" : joined;
    }

    private void OnSharedChanged()
    {
        // Collapsing to a single-owner account keeps only the first selected user.
        if (!form.IsShared)
        {
            form.OwnerUserIds = form.OwnerUserIds.Take(1).ToList();
        }
    }

    private void StartEdit(Account account)
    {
        editingAccountId = account.Id;
        form = new InputModel
        {
            Name = account.Name,
            Provider = account.Provider,
            Type = account.Type,
            Currency = account.Currency,
            IsShared = account.IsShared,
            OwnerUserIds = account.OwnerUserIds.ToList(),
            SyncMethod = account.SyncMethod,
            Iban = account.Iban ?? "",
            ConnectionId = account.ConnectionId,
            ExternalId = account.ExternalId ?? "",
            IdentificationHash = account.IdentificationHash,
            CurrentBalance = account.CurrentBalance,
        };
        loadedBalance = account.CurrentBalance;
    }

    private void ResetForm()
    {
        editingAccountId = null;
        form = new InputModel();
        loadedBalance = null;
    }

    private async Task SaveAsync()
    {
        if (isSaving)
        {
            return; // ignore double-submits while the save is in flight
        }

        isSaving = true;
        // Force the disabled state to render and flush to the browser before the
        // save round-trip runs; otherwise the UI only repaints once the whole
        // handler has completed and the disable is never visible.
        StateHasChanged();
        await Task.Yield();
        try
        {
            var owners = form.OwnerUserIds.ToList();
            // Only API accounts carry a connection / external id; drop stale values
            // if the account is set back to CSV upload.
            var isApi = form.SyncMethod == SyncMethod.Api;
            var isWise = form.Provider == ProviderKind.Wise;
            var connectionId = isApi ? form.ConnectionId : null;
            var externalId = isApi && isWise ? form.ExternalId : null;
            var identificationHash = isApi && !isWise ? form.IdentificationHash : null;
            var result = editingAccountId is Guid accountId
                ? await MessageBus.InvokeAsync<Result<Account>>(
                    new UpdateAccountCommand(
                        accountId,
                        form.Name,
                        form.Type,
                        form.Currency,
                        form.IsShared,
                        owners,
                        form.SyncMethod,
                        form.Iban,
                        connectionId,
                        externalId,
                        identificationHash
                    ),
                    _cts.Token
                )
                : await MessageBus.InvokeAsync<Result<Account>>(
                    new CreateAccountCommand(
                        form.Name,
                        form.Provider,
                        form.Type,
                        form.Currency,
                        form.IsShared,
                        owners,
                        form.SyncMethod,
                        form.Iban,
                        connectionId,
                        externalId,
                        identificationHash
                    ),
                    _cts.Token
                );

            if (result.IsFailure)
            {
                NotificationService.Error("Saving failed", result.Error);
                return;
            }

            // Persist the balance anchor (for net worth) when the user set/changed it.
            if (form.CurrentBalance is decimal balance && balance != loadedBalance)
            {
                await SaveBalanceAsync(result.Value!.Id, balance, result.Value.Currency);
            }

            ResetForm();
            await ReloadAsync();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveBalanceAsync(Guid accountId, decimal balance, string currency)
    {
        decimal? balanceEur = string.Equals(currency, "EUR", StringComparison.OrdinalIgnoreCase)
            ? balance
            : null;
        if (balanceEur is null)
        {
            var rate = await ExchangeRateProvider.GetEurRateAsync(
                currency,
                DateOnly.FromDateTime(DateTime.UtcNow),
                _cts.Token
            );
            if (rate.IsSuccess)
            {
                balanceEur = balance * rate.Value!.EurPerUnit;
            }
            else
            {
                NotificationService.Warning(
                    "Balance saved without EUR value",
                    "The exchange rate was unavailable, so this account is left out of net worth for now."
                );
            }
        }
        await MessageBus.InvokeAsync<Result>(
            new SetAccountBalanceCommand(accountId, balance, balanceEur, DateTimeOffset.UtcNow),
            _cts.Token
        );
    }

    private async Task DeactivateAsync(Account account)
    {
        var result = await MessageBus.InvokeAsync<Result<Account>>(
            new DeactivateAccountCommand(account.Id),
            _cts.Token
        );
        await AfterLifecycleAsync(result.IsFailure ? result.Error : null, "Account deactivated");
    }

    private async Task ReactivateAsync(Account account)
    {
        var result = await MessageBus.InvokeAsync<Result<Account>>(
            new ReactivateAccountCommand(account.Id),
            _cts.Token
        );
        await AfterLifecycleAsync(result.IsFailure ? result.Error : null, "Account reactivated");
    }

    private async Task DeleteAsync(Account account)
    {
        if (!await ConfirmService.ConfirmDeleteAsync(account.Name, "Delete account"))
        {
            return;
        }

        var result = await MessageBus.InvokeAsync<Result>(new DeleteAccountCommand(account.Id), _cts.Token);
        await AfterLifecycleAsync(result.IsFailure ? result.Error : null, "Account deleted");
    }

    // The blast radius is computed first and spelled out in the dialog: there is no
    // confirm button to press until the user has been told exactly what disappears.
    private async Task HardDeleteAsync(Account account)
    {
        var preview = await AccountDeletionPreview.ForAccountAsync(QuerySession, account.Id);
        if (preview.IsFailure)
        {
            NotificationService.Error("Action failed", preview.Error);
            return;
        }

        var confirmed = await ConfirmService.ConfirmAsync(
            $"Permanently delete '{account.Name}'? {preview.Value!.Describe()} This cannot be undone.",
            title: "Delete account permanently",
            okText: "Delete permanently"
        );
        if (!confirmed)
        {
            return;
        }

        var result = await MessageBus.InvokeAsync<Result<AccountDeletionImpact>>(
            new HardDeleteAccountCommand(account.Id)
        );
        await AfterLifecycleAsync(
            result.IsFailure ? result.Error : null,
            "Account permanently deleted"
        );
    }

    private async Task AfterLifecycleAsync(string? error, string successMessage)
    {
        if (error is not null)
        {
            NotificationService.Error("Action failed", error);
            return;
        }

        NotificationService.Success(successMessage);
        if (editingAccountId is not null)
        {
            ResetForm();
        }
        await ReloadAsync();
    }

    private sealed class InputModel
    {
        public string Name { get; set; } = "";
        public ProviderKind Provider { get; set; } = ProviderKind.Dkb;
        public AccountType Type { get; set; } = AccountType.Checking;
        public string Currency { get; set; } = "EUR";
        public bool IsShared { get; set; }
        public IEnumerable<Guid> OwnerUserIds { get; set; } = [];
        public SyncMethod SyncMethod { get; set; } = SyncMethod.CsvUpload;
        public string Iban { get; set; } = "";
        public Guid? ConnectionId { get; set; }
        public string ExternalId { get; set; } = "";
        public string? IdentificationHash { get; set; }
        public decimal? CurrentBalance { get; set; }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
