@page "/settings/accounts"
@attribute [Authorize]
@using AndreGoepel.Marten.Identity.Users
@using Microsoft.AspNetCore.Identity

@inject IQuerySession QuerySession
@inject IMessageBus MessageBus
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject UserManager<User> UserManager

<PageTitle>Accounts – Finance</PageTitle>

<div class="rz-p-4 rz-p-md-6">
    <RadzenStack Gap="1.5rem" Style="max-width: 78rem;">

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <RadzenText TextStyle="TextStyle.H5" TagName="TagName.H1">Accounts</RadzenText>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                <RadzenSwitch @bind-Value=@showDeactivated Change=@(_ => StateHasChanged()) />
                <RadzenLabel Text="Show deactivated" />
            </RadzenStack>
        </RadzenStack>

        <RadzenCard>
            <RadzenDataGrid TItem="Account" Data=@DisplayedAccounts Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="Account" Property="Name" Title="Name" />
                    <RadzenDataGridColumn TItem="Account" Property="Provider" Title="Provider" Width="100px" />
                    <RadzenDataGridColumn TItem="Account" Property="Type" Title="Type" Width="110px" />
                    <RadzenDataGridColumn TItem="Account" Property="Currency" Title="Currency" Width="80px" />
                    <RadzenDataGridColumn TItem="Account" Title="Owner" Width="180px" Sortable="false">
                        <Template Context="account">@OwnerLabel(account)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Account" Property="SyncMethod" Title="Sync" Width="100px" />
                    <RadzenDataGridColumn TItem="Account" Title="Status" Width="110px" Sortable="false">
                        <Template Context="account">
                            <RadzenBadge BadgeStyle="@(account.IsActive ? BadgeStyle.Success : BadgeStyle.Light)"
                                         Text="@(account.IsActive ? "Active" : "Deactivated")" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Account" Title="" Width="140px" Sortable="false">
                        <Template Context="account">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem">
                                <RadzenButton Icon="edit" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Light"
                                              title="Edit" Click=@(() => StartEdit(account)) />
                                @if (account.IsActive)
                                {
                                    <RadzenButton Icon="block" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Warning"
                                                  title="Deactivate" Click=@(() => DeactivateAsync(account)) />
                                }
                                else
                                {
                                    <RadzenButton Icon="restart_alt" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Success"
                                                  title="Reactivate" Click=@(() => ReactivateAsync(account)) />
                                }
                                <RadzenButton Icon="delete" Size="ButtonSize.ExtraSmall" ButtonStyle="ButtonStyle.Danger"
                                              title="Delete permanently" Click=@(() => DeleteAsync(account)) />
                            </RadzenStack>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </RadzenCard>

        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenText TextStyle="TextStyle.H6">@(editingAccountId is null ? "Add account" : "Edit account")</RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" Wrap="FlexWrap.Wrap" AlignItems="AlignItems.End">
                    <RadzenFormField Text="Name">
                        <RadzenTextBox @bind-Value=@form.Name Disabled=@isSaving Style="min-width: 12rem;" />
                    </RadzenFormField>
                    <RadzenFormField Text="Provider">
                        <RadzenDropDown @bind-Value=@form.Provider
                                        Data=@ProviderChoices
                                        Disabled=@(editingAccountId is not null || isSaving)
                                        Style="min-width: 9rem;" />
                    </RadzenFormField>
                    <RadzenFormField Text="Type">
                        <RadzenDropDown @bind-Value=@form.Type Data=@TypeChoices Disabled=@isSaving Style="min-width: 9rem;" />
                    </RadzenFormField>
                    <RadzenFormField Text="Currency">
                        <RadzenTextBox @bind-Value=@form.Currency Disabled=@isSaving Style="width: 5.5rem;" MaxLength="3" />
                    </RadzenFormField>
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                        <RadzenSwitch @bind-Value=@form.IsShared Disabled=@isSaving Change=@OnSharedChanged />
                        <RadzenLabel Text="Shared" />
                    </RadzenStack>
                    @if (form.IsShared)
                    {
                        <RadzenFormField Text="Owners">
                            <RadzenDropDown TValue="IEnumerable<Guid>"
                                            @bind-Value=@form.OwnerUserIds
                                            Data=@users
                                            ValueProperty="StreamId"
                                            TextProperty="UserName"
                                            Multiple="true" AllowClear="true" Chips="true"
                                            Disabled=@isSaving
                                            Placeholder="Select users"
                                            Style="min-width: 18rem;" />
                        </RadzenFormField>
                    }
                    else
                    {
                        <RadzenFormField Text="Owner">
                            <RadzenDropDown TValue="Guid?"
                                            @bind-Value=@SingleOwner
                                            Data=@users
                                            ValueProperty="StreamId"
                                            TextProperty="UserName"
                                            AllowClear="true"
                                            Disabled=@isSaving
                                            Placeholder="Select user"
                                            Style="min-width: 13rem;" />
                        </RadzenFormField>
                    }
                    <RadzenFormField Text="Sync">
                        <RadzenDropDown @bind-Value=@form.SyncMethod Data=@SyncChoices Disabled=@isSaving Style="min-width: 8rem;" />
                    </RadzenFormField>
                    @if (form.SyncMethod == SyncMethod.Api)
                    {
                        <RadzenFormField Text="Connection">
                            <RadzenDropDown TValue="Guid?"
                                            @bind-Value=@form.ConnectionId
                                            Data=@ProviderConnections
                                            ValueProperty="Id"
                                            TextProperty="Label"
                                            AllowClear="true"
                                            Disabled=@isSaving
                                            Placeholder="@(ProviderConnections.Any() ? "Select connection" : "No " + form.Provider + " connection")"
                                            Style="min-width: 15rem;" />
                        </RadzenFormField>
                        @if (form.Provider == ProviderKind.Wise)
                        {
                            <RadzenFormField Text="Wise balance id">
                                <RadzenTextBox @bind-Value=@form.ExternalId Disabled=@isSaving
                                               Placeholder="e.g. 306149" Style="min-width: 10rem;" />
                            </RadzenFormField>
                        }
                        else
                        {
                            <RadzenFormField Text="Bank account">
                                <RadzenDropDown TValue="string"
                                                @bind-Value=@form.IdentificationHash
                                                Data=@LinkedAccounts
                                                ValueProperty="IdentificationHash"
                                                AllowClear="true"
                                                Disabled=@isSaving
                                                Placeholder="@(LinkedAccounts.Any() ? "Select account" : "Connect the consent first")"
                                                Style="min-width: 15rem;">
                                    <Template Context="linked">
                                        @(((EnableBankingLinkedAccount)linked).Name ?? "account") — @(((EnableBankingLinkedAccount)linked).Currency)
                                    </Template>
                                </RadzenDropDown>
                            </RadzenFormField>
                        }
                    }
                    <RadzenFormField Text="IBAN (optional)">
                        <RadzenTextBox @bind-Value=@form.Iban Disabled=@isSaving Style="min-width: 14rem;" />
                    </RadzenFormField>
                    <RadzenButton Text="@(editingAccountId is null ? "Add" : "Save")"
                                  Icon="save"
                                  ButtonStyle="ButtonStyle.Primary"
                                  IsBusy=@isSaving
                                  BusyText="Saving…"
                                  Disabled=@isSaving
                                  Click=@SaveAsync />
                    @if (editingAccountId is not null)
                    {
                        <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Disabled=@isSaving Click=@ResetForm />
                    }
                </RadzenStack>
            </RadzenStack>
        </RadzenCard>

    </RadzenStack>
</div>

@code {
    private static readonly ProviderKind[] ProviderChoices = Enum.GetValues<ProviderKind>();
    private static readonly AccountType[] TypeChoices = Enum.GetValues<AccountType>();
    private static readonly SyncMethod[] SyncChoices = Enum.GetValues<SyncMethod>();

    private List<Account> accounts = [];
    private IReadOnlyList<User> users = [];
    private IReadOnlyList<ProviderConnection> connections = [];
    private Guid? editingAccountId;
    private InputModel form = new();
    private bool isSaving;
    private bool showDeactivated;

    private IEnumerable<Account> DisplayedAccounts =>
        showDeactivated ? accounts : accounts.Where(a => a.IsActive);

    // Connections are per provider; a Wise account can only link a Wise connection.
    private IEnumerable<ProviderConnection> ProviderConnections =>
        connections.Where(c => c.Provider == form.Provider);

    // Enable Banking accounts exposed by the selected connection's consent.
    private IEnumerable<EnableBankingLinkedAccount> LinkedAccounts =>
        connections.FirstOrDefault(c => c.Id == form.ConnectionId)?.LinkedAccounts
        ?? Enumerable.Empty<EnableBankingLinkedAccount>();

    private Guid? SingleOwner
    {
        get => form.OwnerUserIds.FirstOrDefault() is var id && id != Guid.Empty ? id : null;
        set => form.OwnerUserIds = value is Guid g ? [g] : [];
    }

    protected override async Task OnInitializedAsync()
    {
        users = await UserManager
            .Users.Where(u => !u.Deleted)
            .OrderBy(u => u.UserName)
            .ToListAsync();
        connections = (await QuerySession.Query<ProviderConnection>().ToListAsync())
            .OrderBy(c => c.Label)
            .ToList();
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        accounts = (await QuerySession.Query<Account>().ToListAsync()).OrderBy(a => a.Name).ToList();
    }

    private string OwnerLabel(Account account)
    {
        var names = account
            .OwnerUserIds.Select(id => users.FirstOrDefault(u => u.StreamId == id)?.UserName ?? "?")
            .ToList();
        var joined = names.Count == 0 ? "—" : string.Join(", ", names);
        return account.IsShared ? $"{joined} (shared)" : joined;
    }

    private void OnSharedChanged()
    {
        // Collapsing to a single-owner account keeps only the first selected user.
        if (!form.IsShared)
        {
            form.OwnerUserIds = form.OwnerUserIds.Take(1).ToList();
        }
    }

    private void StartEdit(Account account)
    {
        editingAccountId = account.Id;
        form = new InputModel
        {
            Name = account.Name,
            Provider = account.Provider,
            Type = account.Type,
            Currency = account.Currency,
            IsShared = account.IsShared,
            OwnerUserIds = account.OwnerUserIds.ToList(),
            SyncMethod = account.SyncMethod,
            Iban = account.Iban ?? "",
            ConnectionId = account.ConnectionId,
            ExternalId = account.ExternalId ?? "",
            IdentificationHash = account.IdentificationHash,
        };
    }

    private void ResetForm()
    {
        editingAccountId = null;
        form = new InputModel();
    }

    private async Task SaveAsync()
    {
        if (isSaving)
        {
            return; // ignore double-submits while the save is in flight
        }

        isSaving = true;
        // Force the disabled state to render and flush to the browser before the
        // save round-trip runs; otherwise the UI only repaints once the whole
        // handler has completed and the disable is never visible.
        StateHasChanged();
        await Task.Yield();
        try
        {
            var owners = form.OwnerUserIds.ToList();
            // Only API accounts carry a connection / external id; drop stale values
            // if the account is set back to CSV upload.
            var isApi = form.SyncMethod == SyncMethod.Api;
            var isWise = form.Provider == ProviderKind.Wise;
            var connectionId = isApi ? form.ConnectionId : null;
            var externalId = isApi && isWise ? form.ExternalId : null;
            var identificationHash = isApi && !isWise ? form.IdentificationHash : null;
            var result = editingAccountId is Guid accountId
                ? await MessageBus.InvokeAsync<Result<Account>>(
                    new UpdateAccountCommand(
                        accountId,
                        form.Name,
                        form.Type,
                        form.Currency,
                        form.IsShared,
                        owners,
                        form.SyncMethod,
                        form.Iban,
                        connectionId,
                        externalId,
                        identificationHash
                    )
                )
                : await MessageBus.InvokeAsync<Result<Account>>(
                    new CreateAccountCommand(
                        form.Name,
                        form.Provider,
                        form.Type,
                        form.Currency,
                        form.IsShared,
                        owners,
                        form.SyncMethod,
                        form.Iban,
                        connectionId,
                        externalId,
                        identificationHash
                    )
                );

            if (result.IsFailure)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Saving failed", result.Error);
                return;
            }

            ResetForm();
            await ReloadAsync();
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeactivateAsync(Account account)
    {
        var result = await MessageBus.InvokeAsync<Result<Account>>(
            new DeactivateAccountCommand(account.Id)
        );
        await AfterLifecycleAsync(result.IsFailure ? result.Error : null, "Account deactivated");
    }

    private async Task ReactivateAsync(Account account)
    {
        var result = await MessageBus.InvokeAsync<Result<Account>>(
            new ReactivateAccountCommand(account.Id)
        );
        await AfterLifecycleAsync(result.IsFailure ? result.Error : null, "Account reactivated");
    }

    private async Task DeleteAsync(Account account)
    {
        var confirmed = await DialogService.Confirm(
            $"Permanently delete “{account.Name}”? This cannot be undone.",
            "Delete account",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" }
        );
        if (confirmed != true)
        {
            return;
        }

        var result = await MessageBus.InvokeAsync<Result>(new DeleteAccountCommand(account.Id));
        await AfterLifecycleAsync(result.IsFailure ? result.Error : null, "Account deleted");
    }

    private async Task AfterLifecycleAsync(string? error, string successMessage)
    {
        if (error is not null)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Action failed", error);
            return;
        }

        NotificationService.Notify(NotificationSeverity.Success, successMessage);
        if (editingAccountId is not null)
        {
            ResetForm();
        }
        await ReloadAsync();
    }

    private sealed class InputModel
    {
        public string Name { get; set; } = "";
        public ProviderKind Provider { get; set; } = ProviderKind.Dkb;
        public AccountType Type { get; set; } = AccountType.Checking;
        public string Currency { get; set; } = "EUR";
        public bool IsShared { get; set; }
        public IEnumerable<Guid> OwnerUserIds { get; set; } = [];
        public SyncMethod SyncMethod { get; set; } = SyncMethod.CsvUpload;
        public string Iban { get; set; } = "";
        public Guid? ConnectionId { get; set; }
        public string ExternalId { get; set; } = "";
        public string? IdentificationHash { get; set; }
    }
}
