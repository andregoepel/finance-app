@page "/settings/rules"
@attribute [Authorize]

@inject IQuerySession QuerySession
@inject IMessageBus MessageBus
@inject NotificationService NotificationService
@inject ConfirmService ConfirmService
@inject IStringLocalizer<Strings> L

<AppPageTitle Title="@L["Nav.Rules"]" Breadcrumb="@L["Common.SettingsBreadcrumb", L["Nav.Rules"]]" />

<PageBody>

    <PageHeader Title="@L["Rules.PageTitle"]" Subtitle="@L["Rules.Subtitle"]" />

    @if (rules.Count == 0)
    {
        <EmptyState Icon="@("⚙")" Title="@L["Rules.EmptyTitle"]" Text="@L["Rules.EmptyText"]" />
    }
    else
    {
        <DataCard>
            <RadzenDataGrid TItem="Domain.Categories.CategoryRule" Data=@rules Density="Density.Compact" AllowPaging="true" PageSize="15">
                <Columns>
                    <RadzenDataGridColumn TItem="Domain.Categories.CategoryRule" Title="@L["Dashboard.ColCategory"]" Width="200px" Sortable="false">
                        <Template Context="rule">@CategoryLabel(rule.CategoryId)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Domain.Categories.CategoryRule" Property="CounterpartyContains" Title="@L["Rules.ColCounterpartyContains"]" />
                    <RadzenDataGridColumn TItem="Domain.Categories.CategoryRule" Property="DescriptionContains" Title="@L["Rules.ColDescriptionContains"]" />
                    <RadzenDataGridColumn TItem="Domain.Categories.CategoryRule" Title="@L["Common.Amount"]" Width="150px" Sortable="false">
                        <Template Context="rule">
                            @(rule.MinAmount?.ToString("N2") ?? "−∞") … @(rule.MaxAmount?.ToString("N2") ?? "∞")
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Domain.Categories.CategoryRule" Property="Source" Title="@L["Rules.ColSource"]" Width="170px">
                        <Template Context="rule">@L[$"Enum.CategoryRuleSource.{rule.Source}"]</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="Domain.Categories.CategoryRule" Title="" Width="80px" TextAlign="TextAlign.End" Sortable="false">
                        <Template Context="rule">
                            <RowActions>
                                <IconButton Icon="delete" Title="@L["Common.Delete"]" Danger="true" Click=@(_ => DeleteAsync(rule.Id)) />
                            </RowActions>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </DataCard>
    }

    <CardForm TItem="InputModel" Data="form" Submit="CreateAsync" Title="@L["Rules.AddRuleTitle"]" SubmitText="@L["Common.Add"]">
        <div class="ag-form-grid">
            <FormField Label="@L["Dashboard.ColCategory"]" For="Category">
                <CategoryPicker Options="@categoryOptions" Name="Category" @bind-Value=@form.CategoryId />
            </FormField>
            <FormField Label="@L["Rules.ColCounterpartyContains"]" For="Counterparty">
                <RadzenTextBox @bind-Value=@form.Counterparty Name="Counterparty" Style="width: 100%;" />
            </FormField>
            <FormField Label="@L["Rules.ColDescriptionContains"]" For="Description">
                <RadzenTextBox @bind-Value=@form.Description Name="Description" Style="width: 100%;" />
            </FormField>
            <FormField Label="@L["Rules.MinAmountLabel"]" For="MinAmount">
                <RadzenNumeric TValue="decimal?" @bind-Value=@form.MinAmount Name="MinAmount" Style="width: 100%;" />
            </FormField>
            <FormField Label="@L["Rules.MaxAmountLabel"]" For="MaxAmount">
                <RadzenNumeric TValue="decimal?" @bind-Value=@form.MaxAmount Name="MaxAmount" Style="width: 100%;" />
            </FormField>
        </div>
    </CardForm>

</PageBody>

@code {
    private List<Domain.Categories.CategoryRule> rules = [];
    private List<CategoryOption> categoryOptions = [];
    private InputModel form = new();

    protected override async Task OnInitializedAsync()
    {
        var categories = await QuerySession.Query<Category>().ToListAsync();
        categoryOptions = CategoryPaths.Build(categories.ToList());
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        rules = (
            await QuerySession
                .Query<Domain.Categories.CategoryRule>()
                .OrderByDescending(r => r.CreatedAt)
                .ToListAsync()
        ).ToList();
    }

    private string CategoryLabel(Guid categoryId) =>
        categoryOptions.FirstOrDefault(c => c.Id == categoryId)?.Path ?? "?";

    private async Task CreateAsync()
    {
        if (form.CategoryId is not Guid categoryId)
        {
            NotificationService.Warning(
                L["Rules.MissingCategoryTitle"],
                L["Rules.MissingCategoryMessage"]
            );
            return;
        }

        var result = await MessageBus.InvokeAsync<Result<Domain.Categories.CategoryRule>>(
            new CreateCategoryRuleCommand(
                categoryId,
                form.Counterparty,
                form.Description,
                form.MinAmount,
                form.MaxAmount,
                CategoryRuleSource.Manual
            )
        );
        if (result.IsFailure)
        {
            NotificationService.Error(L["Categories.CreatingFailedTitle"], result.Error);
            return;
        }

        form = new InputModel();
        await ReloadAsync();
    }

    private async Task DeleteAsync(Guid ruleId)
    {
        if (!await ConfirmService.ConfirmDeleteAsync(L["Rules.DeleteConfirmSubject"]))
        {
            return;
        }
        var result = await MessageBus.InvokeAsync<Result>(new DeleteCategoryRuleCommand(ruleId));
        if (result.IsFailure)
        {
            NotificationService.Error(L["Common.DeleteFailedTitle"], result.Error);
            return;
        }
        await ReloadAsync();
    }

    private sealed class InputModel
    {
        public Guid? CategoryId { get; set; }
        public string Counterparty { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal? MinAmount { get; set; }
        public decimal? MaxAmount { get; set; }
    }
}
