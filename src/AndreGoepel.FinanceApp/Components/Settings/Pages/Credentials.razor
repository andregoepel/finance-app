@page "/settings/credentials"
@attribute [Authorize]

@inject ICredentialStore CredentialStore
@inject IMessageBus MessageBus
@inject NotificationService NotificationService

<AppPageTitle Title="API Keys" Breadcrumb="Settings / API Keys" />

<PageBody>

    <PageHeader Title="API Keys" />
    <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color);">
        Secrets are stored encrypted in the database (DataProtection) and never
        shown again after saving. Wise and Enable Banking credentials live under
        <RadzenLink Path="settings/connections" Text="Connections" />.
    </RadzenText>

    <SectionCard Title="Claude API key">
        <Actions>
            @if (claudeInfo is not null)
            {
                <StatusBadge Variant="BadgeVariant.Success"
                             Text="@($"configured {(claudeInfo.RotatedAt ?? claudeInfo.CreatedAt).ToLocalTime():dd.MM.yyyy}")" />
            }
            else
            {
                <StatusBadge Variant="BadgeVariant.Warning" Text="not configured" />
            }
        </Actions>
        <ChildContent>
            <RadzenStack Gap="1rem">
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                    Used for AI categorization of imported transactions. Without a key,
                    uncategorized transactions simply stay in the review queue.
                </RadzenText>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                    <RadzenPassword @bind-Value=@claudeKeyInput
                                    Placeholder="@(claudeInfo is null ? "sk-ant-..." : "Enter new key to rotate")"
                                    autocomplete="off"
                                    Style="flex: 1;" />
                    <RadzenButton Text="Save"
                                  Icon="save"
                                  ButtonStyle="ButtonStyle.Primary"
                                  Disabled=@string.IsNullOrWhiteSpace(claudeKeyInput)
                                  Click=@SaveClaudeKeyAsync />
                </RadzenStack>
            </RadzenStack>
        </ChildContent>
    </SectionCard>

</PageBody>

@code {
    private CredentialInfo? claudeInfo;
    private string claudeKeyInput = "";

    protected override async Task OnInitializedAsync()
    {
        claudeInfo = await CredentialStore.GetInfoAsync(CredentialKeys.ClaudeApiKey);
    }

    private async Task SaveClaudeKeyAsync()
    {
        var result = await MessageBus.InvokeAsync<Result>(
            new SaveProviderCredentialCommand(CredentialKeys.ClaudeApiKey, claudeKeyInput)
        );
        if (result.IsFailure)
        {
            NotificationService.Error("Saving failed", result.Error);
            return;
        }

        claudeKeyInput = "";
        claudeInfo = await CredentialStore.GetInfoAsync(CredentialKeys.ClaudeApiKey);
        NotificationService.Success("Saved", "Claude API key stored encrypted.");
    }
}
