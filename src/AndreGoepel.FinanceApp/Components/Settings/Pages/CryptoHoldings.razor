@page "/settings/crypto"
@attribute [Authorize]
@rendermode InteractiveServer
@using AndreGoepel.FinanceApp.Insights

@inject IQuerySession QuerySession
@inject IMessageBus MessageBus
@inject NotificationService NotificationService
@inject ICryptoService CryptoService
@inject ConfirmService ConfirmService
@inject IStringLocalizer<Strings> L

<AppPageTitle Title="@L["Nav.Crypto"]" Breadcrumb="@L["Common.SettingsBreadcrumb", L["Nav.Crypto"]]" />

<PageBody>

    <PageHeader Title="@L["Crypto.PageTitle"]" Subtitle="@L["Crypto.Subtitle"]">
        <Actions>
            <RadzenButton Text="@L["Crypto.RefreshValues"]" Icon="refresh" ButtonStyle="ButtonStyle.Secondary"
                          Disabled=@refreshing Click=@RefreshAsync />
        </Actions>
    </PageHeader>

    @if (cryptoAccounts.Count == 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
            @L["Crypto.NoAccountPrefix"]
            <RadzenLink Path="settings/accounts" Text="@L["Nav.Accounts"]" /> @L["Crypto.NoAccountSuffix"]
        </RadzenAlert>
    }
    else
    {
        <SectionCard Title="@L["Crypto.SetHoldingTitle"]">
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                    <FormField Label="@L["Common.Account"]" For="Account">
                        <RadzenDropDown TValue="Guid?" @bind-Value=@selectedAccountId Name="Account"
                                        Data=@cryptoAccounts ValueProperty="Id" TextProperty="Name"
                                        Placeholder="@L["Import.SelectAccountPlaceholder"]" Style="min-width: 14rem;" />
                    </FormField>
                    <FormField Label="@L["Crypto.SymbolLabel"]" For="Symbol">
                        <RadzenTextBox @bind-Value=@symbolInput Name="Symbol" Placeholder="BTC" Style="width: 7rem;" />
                    </FormField>
                    <FormField Label="@L["Crypto.CoinGeckoIdLabel"]" For="CoinGeckoId">
                        <RadzenTextBox @bind-Value=@coinGeckoIdInput Name="CoinGeckoId" Placeholder="bitcoin" Style="width: 11rem;" />
                    </FormField>
                    <FormField Label="@L["Crypto.QuantityLabel"]" For="Quantity">
                        <RadzenNumeric TValue="decimal" @bind-Value=@quantityInput Name="Quantity" Min="0" Format="0.########" Style="width: 10rem;" />
                    </FormField>
                    <RadzenButton Text="@L["Common.Save"]" Icon="save" ButtonStyle="ButtonStyle.Primary"
                                  Disabled=@(!CanSave) Click=@SaveAsync />
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                    @L["Crypto.CoinGeckoIdHint"]
                </RadzenText>
            </RadzenStack>
        </SectionCard>

        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">@L["Crypto.CurrentHoldingsHeading"]</RadzenText>
        @if (overview is null || overview.Positions.Count == 0)
        {
            <EmptyState Icon="@("₿")" Title="@L["Crypto.EmptyTitle"]" Text="@L["Crypto.EmptyText"]" />
        }
        else
        {
            <DataCard>
                <RadzenDataGrid TItem="CryptoPosition" Data=@overview.Positions Density="Density.Compact" AllowPaging="false">
                    <Columns>
                        <RadzenDataGridColumn TItem="CryptoPosition" Property="AccountName" Title="@L["Common.Account"]" />
                        <RadzenDataGridColumn TItem="CryptoPosition" Property="Symbol" Title="@L["Crypto.SymbolLabel"]" Width="90px" />
                        <RadzenDataGridColumn TItem="CryptoPosition" Property="Quantity" Title="@L["Crypto.QuantityLabel"]" Width="130px" TextAlign="TextAlign.Right">
                            <Template Context="row">@row.Quantity.ToString("0.########")</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CryptoPosition" Title="@L["Crypto.ColPrice"]" Width="130px" TextAlign="TextAlign.Right">
                            <Template Context="row">
                                @if (row.EurPrice is decimal price)
                                {
                                    @Money.Eur(price)
                                }
                                else
                                {
                                    <span style="color: var(--rz-text-secondary-color);">@L["Common.NoPriceYet"]</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CryptoPosition" Title="@L["Crypto.ColValue"]" Width="130px" TextAlign="TextAlign.Right">
                            <Template Context="row">@(row.EurValue is decimal value ? Money.Eur(value) : "—")</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CryptoPosition" Title="" Width="110px" TextAlign="TextAlign.End" Sortable="false">
                            <Template Context="row">
                                <RowActions>
                                    <IconButton Icon="edit" Title="@L["Common.Edit"]" Click=@(_ => StartEdit(row)) />
                                    <IconButton Icon="delete" Title="@L["Common.Delete"]" Danger="true" Click=@(_ => DeleteAsync(row)) />
                                </RowActions>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </DataCard>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                    @if (overview.OldestPriceAt is DateTimeOffset asOf)
                    {
                        <text>@L["Crypto.PricesAsOf", Dates.ShortTime(asOf.LocalDateTime)]</text>
                    }
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">
                    @L["Crypto.Total", Money.Eur(overview.TotalEur)]
                </RadzenText>
            </RadzenStack>
        }
    }

</PageBody>

@code {
    private sealed record AccountOption(Guid Id, string Name);

    private List<AccountOption> cryptoAccounts = [];
    private CryptoOverview? overview;
    private Guid? selectedAccountId;
    private string? symbolInput;
    private string? coinGeckoIdInput;
    private decimal quantityInput;
    private bool refreshing;

    private bool CanSave =>
        selectedAccountId is not null
        && !string.IsNullOrWhiteSpace(symbolInput)
        && !string.IsNullOrWhiteSpace(coinGeckoIdInput)
        && quantityInput > 0;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        cryptoAccounts = (
            await QuerySession
                .Query<Account>()
                .Where(a => a.Type == AccountType.Crypto && a.Status == AccountStatus.Active)
                .ToListAsync()
        )
            .Select(a => new AccountOption(a.Id, a.Name))
            .OrderBy(a => a.Name)
            .ToList();
        overview = await CryptoService.GetOverviewAsync();
    }

    private void StartEdit(CryptoPosition row)
    {
        selectedAccountId = row.AccountId;
        symbolInput = row.Symbol;
        coinGeckoIdInput = row.CoinGeckoId;
        quantityInput = row.Quantity;
    }

    private async Task SaveAsync()
    {
        if (selectedAccountId is not Guid accountId)
        {
            return;
        }
        var result = await MessageBus.InvokeAsync<Result<CryptoHolding>>(
            new SetCryptoHoldingCommand(accountId, symbolInput!, coinGeckoIdInput!, quantityInput));
        if (result.IsFailure)
        {
            NotificationService.Error(L["Common.SavingFailedTitle"], result.Error);
            return;
        }
        selectedAccountId = null;
        symbolInput = null;
        coinGeckoIdInput = null;
        quantityInput = 0;
        await LoadAsync();
        NotificationService.Success(L["Crypto.HoldingSavedTitle"]);
    }

    private async Task DeleteAsync(CryptoPosition row)
    {
        // Parameterized rather than interpolated: the shared confirm template wraps this in
        // "Delete {0}? …" / "{0} löschen? …", so an English article baked into the argument
        // would read as broken German.
        if (!await ConfirmService.ConfirmDeleteAsync(L["Crypto.DeleteConfirmSubject", row.Symbol]))
        {
            return;
        }
        var result = await MessageBus.InvokeAsync<Result>(
            new DeleteCryptoHoldingCommand(row.AccountId, row.CoinGeckoId));
        if (result.IsFailure)
        {
            NotificationService.Error(L["Common.DeleteFailedTitle"], result.Error);
            return;
        }
        await LoadAsync();
        NotificationService.Success(L["Crypto.HoldingRemovedTitle"]);
    }

    private async Task RefreshAsync()
    {
        refreshing = true;
        try
        {
            var result = await MessageBus.InvokeAsync<Result<CryptoValuationSummary>>(
                new RefreshCryptoValuationsCommand());
            if (result.IsFailure)
            {
                NotificationService.Error(L["Crypto.RefreshFailedTitle"], result.Error);
                return;
            }
            var summary = result.Value!;
            if (summary.UsedCachedPrices)
            {
                NotificationService.Warning(
                    L["Crypto.PricesUnavailableTitle"],
                    L["Crypto.PricesUnavailableMessage"]
                );
            }
            else
            {
                NotificationService.Success(
                    L["Crypto.ValuesRefreshedTitle"],
                    L["Crypto.ValuesRefreshedMessage", summary.AccountsUpdated]
                );
            }
            await LoadAsync();
        }
        finally
        {
            refreshing = false;
        }
    }
}
