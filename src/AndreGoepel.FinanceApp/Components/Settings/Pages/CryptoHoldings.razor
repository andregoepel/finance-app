@page "/settings/crypto"
@attribute [Authorize]
@rendermode InteractiveServer
@using AndreGoepel.FinanceApp.Insights

@inject IQuerySession QuerySession
@inject IMessageBus MessageBus
@inject NotificationService NotificationService
@inject ICryptoService CryptoService
@inject ConfirmService ConfirmService

<AppPageTitle Title="Crypto" Breadcrumb="Settings / Crypto" />

<PageBody>

    <PageHeader Title="Crypto holdings"
                Subtitle="Track how much of each asset a crypto account holds. Values are priced in EUR via CoinGecko (daily and on refresh) and anchor the account balance for net worth. Set the crypto account's currency to EUR — its balance is the EUR sum of its holdings.">
        <Actions>
            <RadzenButton Text="Refresh values" Icon="refresh" ButtonStyle="ButtonStyle.Secondary"
                          Disabled=@refreshing Click=@RefreshAsync />
        </Actions>
    </PageHeader>

    @if (cryptoAccounts.Count == 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="false">
            No active crypto account yet — create one under
            <RadzenLink Path="settings/accounts" Text="Accounts" /> with type "Crypto" first.
        </RadzenAlert>
    }
    else
    {
        <SectionCard Title="Set a holding">
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                    <FormField Label="Account" For="Account">
                        <RadzenDropDown TValue="Guid?" @bind-Value=@selectedAccountId Name="Account"
                                        Data=@cryptoAccounts ValueProperty="Id" TextProperty="Name"
                                        Placeholder="Select account" Style="min-width: 14rem;" />
                    </FormField>
                    <FormField Label="Symbol" For="Symbol">
                        <RadzenTextBox @bind-Value=@symbolInput Name="Symbol" Placeholder="BTC" Style="width: 7rem;" />
                    </FormField>
                    <FormField Label="CoinGecko id" For="CoinGeckoId">
                        <RadzenTextBox @bind-Value=@coinGeckoIdInput Name="CoinGeckoId" Placeholder="bitcoin" Style="width: 11rem;" />
                    </FormField>
                    <FormField Label="Quantity" For="Quantity">
                        <RadzenNumeric TValue="decimal" @bind-Value=@quantityInput Name="Quantity" Min="0" Format="0.########" Style="width: 10rem;" />
                    </FormField>
                    <RadzenButton Text="Save" Icon="save" ButtonStyle="ButtonStyle.Primary"
                                  Disabled=@(!CanSave) Click=@SaveAsync />
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                    The CoinGecko id is the last part of the coin's coingecko.com URL,
                    e.g. "bitcoin" or "ethereum". An unknown id gets no price.
                </RadzenText>
            </RadzenStack>
        </SectionCard>

        <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Current holdings</RadzenText>
        @if (overview is null || overview.Positions.Count == 0)
        {
            <EmptyState Icon="@("₿")" Title="No holdings yet"
                        Text="Add a holding above to track an asset's quantity and EUR value." />
        }
        else
        {
            <DataCard>
                <RadzenDataGrid TItem="CryptoPosition" Data=@overview.Positions Density="Density.Compact" AllowPaging="false">
                    <Columns>
                        <RadzenDataGridColumn TItem="CryptoPosition" Property="AccountName" Title="Account" />
                        <RadzenDataGridColumn TItem="CryptoPosition" Property="Symbol" Title="Symbol" Width="90px" />
                        <RadzenDataGridColumn TItem="CryptoPosition" Property="Quantity" Title="Quantity" Width="130px" TextAlign="TextAlign.Right">
                            <Template Context="row">@row.Quantity.ToString("0.########")</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CryptoPosition" Title="Price" Width="130px" TextAlign="TextAlign.Right">
                            <Template Context="row">
                                @if (row.EurPrice is decimal price)
                                {
                                    @Money.Eur(price)
                                }
                                else
                                {
                                    <span style="color: var(--rz-text-secondary-color);">no price yet</span>
                                }
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CryptoPosition" Title="Value" Width="130px" TextAlign="TextAlign.Right">
                            <Template Context="row">@(row.EurValue is decimal value ? Money.Eur(value) : "—")</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="CryptoPosition" Title="" Width="110px" TextAlign="TextAlign.End" Sortable="false">
                            <Template Context="row">
                                <RowActions>
                                    <IconButton Icon="edit" Title="Edit" Click=@(_ => StartEdit(row)) />
                                    <IconButton Icon="delete" Title="Delete" Danger="true" Click=@(_ => DeleteAsync(row)) />
                                </RowActions>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </DataCard>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                    @if (overview.OldestPriceAt is DateTimeOffset asOf)
                    {
                        <text>Prices as of @asOf.LocalDateTime.ToString("dd.MM.yyyy HH:mm")</text>
                    }
                </RadzenText>
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0;">
                    Total: @Money.Eur(overview.TotalEur)
                </RadzenText>
            </RadzenStack>
        }
    }

</PageBody>

@code {
    private sealed record AccountOption(Guid Id, string Name);

    private List<AccountOption> cryptoAccounts = [];
    private CryptoOverview? overview;
    private Guid? selectedAccountId;
    private string? symbolInput;
    private string? coinGeckoIdInput;
    private decimal quantityInput;
    private bool refreshing;

    private bool CanSave =>
        selectedAccountId is not null
        && !string.IsNullOrWhiteSpace(symbolInput)
        && !string.IsNullOrWhiteSpace(coinGeckoIdInput)
        && quantityInput > 0;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        cryptoAccounts = (
            await QuerySession
                .Query<Account>()
                .Where(a => a.Type == AccountType.Crypto && a.Status == AccountStatus.Active)
                .ToListAsync()
        )
            .Select(a => new AccountOption(a.Id, a.Name))
            .OrderBy(a => a.Name)
            .ToList();
        overview = await CryptoService.GetOverviewAsync();
    }

    private void StartEdit(CryptoPosition row)
    {
        selectedAccountId = row.AccountId;
        symbolInput = row.Symbol;
        coinGeckoIdInput = row.CoinGeckoId;
        quantityInput = row.Quantity;
    }

    private async Task SaveAsync()
    {
        if (selectedAccountId is not Guid accountId)
        {
            return;
        }
        var result = await MessageBus.InvokeAsync<Result<CryptoHolding>>(
            new SetCryptoHoldingCommand(accountId, symbolInput!, coinGeckoIdInput!, quantityInput));
        if (result.IsFailure)
        {
            NotificationService.Error("Saving failed", result.Error);
            return;
        }
        selectedAccountId = null;
        symbolInput = null;
        coinGeckoIdInput = null;
        quantityInput = 0;
        await LoadAsync();
        NotificationService.Success("Holding saved");
    }

    private async Task DeleteAsync(CryptoPosition row)
    {
        if (!await ConfirmService.ConfirmDeleteAsync($"the {row.Symbol} holding"))
        {
            return;
        }
        var result = await MessageBus.InvokeAsync<Result>(
            new DeleteCryptoHoldingCommand(row.AccountId, row.CoinGeckoId));
        if (result.IsFailure)
        {
            NotificationService.Error("Delete failed", result.Error);
            return;
        }
        await LoadAsync();
        NotificationService.Success("Holding removed");
    }

    private async Task RefreshAsync()
    {
        refreshing = true;
        try
        {
            var result = await MessageBus.InvokeAsync<Result<CryptoValuationSummary>>(
                new RefreshCryptoValuationsCommand());
            if (result.IsFailure)
            {
                NotificationService.Error("Refresh failed", result.Error);
                return;
            }
            var summary = result.Value!;
            if (summary.UsedCachedPrices)
            {
                NotificationService.Warning("Prices unavailable",
                    "CoinGecko could not be reached — cached prices were used.");
            }
            else
            {
                NotificationService.Success("Values refreshed",
                    $"{summary.AccountsUpdated} account(s) updated.");
            }
            await LoadAsync();
        }
        finally
        {
            refreshing = false;
        }
    }
}
