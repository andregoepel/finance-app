@page "/sync"
@attribute [Authorize]
@rendermode InteractiveServer

@inject IQuerySession QuerySession
@inject IAccountSyncService SyncService
@inject ISyncScheduleService ScheduleService
@inject NotificationService NotificationService

<AppFoundationPageTitle Title="Sync" />

<div class="rz-p-4 rz-p-md-6">
    <RadzenStack Gap="1.5rem">

        <PageHeader Title="Sync">
            <Actions>
                <RadzenButton Text="Sync all now" Icon="sync" ButtonStyle="ButtonStyle.Primary"
                              Disabled=@(isSyncing || accounts.Count == 0) IsBusy=@isSyncing BusyText="Syncing..."
                              Click=@SyncAllAsync />
            </Actions>
        </PageHeader>

        <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color);">
            API-backed accounts sync automatically on the schedule below; trigger a manual sync
            any time here. Configure credentials and bank consents under
            <RadzenLink Path="settings/connections" Text="Settings → Connections" />.
        </RadzenText>

        @if (expiringConnections.Count > 0)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
                Consent attention needed:
                @string.Join(", ", expiringConnections.Select(c => $"{c.Label} ({(c.ConsentExpired ? "expired" : "expires " + c.ConsentExpiresAt?.ToLocalTime().ToString("dd.MM.yyyy"))})")).
            </RadzenAlert>
        }

        @* ---------- Automatic schedule ---------- *@
        <RadzenCard>
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
                    <RadzenText TextStyle="TextStyle.H6" Style="margin: 0;">Automatic schedule</RadzenText>
                    <RadzenSwitch @bind-Value=@scheduleEnabled />
                    <RadzenLabel Text="@(scheduleEnabled ? "Enabled" : "Disabled")" />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                    <FormField Label="Cron expression (Quartz)" For="Cron">
                        <RadzenTextBox @bind-Value=@cronInput Name="Cron" Disabled=@(!scheduleEnabled) Style="min-width: 16rem; font-family: monospace;" />
                    </FormField>
                    <RadzenButton Text="Save schedule" Icon="save" ButtonStyle="ButtonStyle.Primary" Click=@SaveScheduleAsync />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">Presets:</RadzenText>
                    @foreach (var preset in CronPresets)
                    {
                        <RadzenButton Text="@preset.Label" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                      Disabled=@(!scheduleEnabled) Click=@(() => cronInput = preset.Cron) />
                    }
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                    @if (!scheduleEnabled)
                    {
                        <span>Automatic sync is off — use “Sync all now” to run manually.</span>
                    }
                    else if (ScheduleService.NextRun(cronInput) is DateTimeOffset next)
                    {
                        <span>Next run: @next.ToLocalTime().ToString("dddd, dd.MM.yyyy HH:mm")</span>
                    }
                    else
                    {
                        <span style="color: var(--rz-danger);">Not a valid cron expression.</span>
                    }
                </RadzenText>
            </RadzenStack>
        </RadzenCard>

        @if (accounts.Count == 0)
        {
            <EmptyState Icon="@("🔄")" Title="No API-backed accounts yet"
                        Text="Set an account's sync method to API under Accounts to sync it here." />
        }
        else
        {
            <DataCard>
                <RadzenDataGrid TItem="AccountRow" Data=@accounts Density="Density.Compact">
                    <Columns>
                        <RadzenDataGridColumn TItem="AccountRow" Title="Account" Property="Name" />
                        <RadzenDataGridColumn TItem="AccountRow" Title="Provider" Width="120px">
                            <Template Context="row">@row.Provider</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AccountRow" Title="Last sync" Width="200px">
                            <Template Context="row">
                                @(row.LastSync is null ? "never" : row.LastSync.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm"))
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="AccountRow" Title="" Width="140px" TextAlign="TextAlign.End" Sortable="false">
                            <Template Context="row">
                                <RowActions>
                                    <RadzenButton Text="Sync now" Icon="sync" Size="ButtonSize.Small"
                                                  ButtonStyle="ButtonStyle.Secondary" Disabled=@isSyncing
                                                  Click=@(() => SyncOneAsync(row.Id)) />
                                </RowActions>
                            </Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            </DataCard>
        }

    </RadzenStack>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private sealed record AccountRow(Guid Id, string Name, ProviderKind Provider, DateTimeOffset? LastSync);

    private List<AccountRow> accounts = [];
    private List<ProviderConnection> expiringConnections = [];
    private bool isSyncing;

    private string cronInput = "0 0 3 * * ?";
    private bool scheduleEnabled = true;

    private static readonly (string Label, string Cron)[] CronPresets =
    [
        ("Daily 03:00", "0 0 3 * * ?"),
        ("Daily 06:00", "0 0 6 * * ?"),
        ("Every 6 hours", "0 0 0/6 * * ?"),
        ("Hourly", "0 0 * * * ?"),
    ];

    protected override async Task OnInitializedAsync()
    {
        var schedule = await ScheduleService.GetAsync();
        cronInput = schedule.CronExpression;
        scheduleEnabled = schedule.Enabled;
        await LoadAsync();
    }

    private async Task SaveScheduleAsync()
    {
        var result = await ScheduleService.UpdateAsync(cronInput, scheduleEnabled);
        if (result.IsFailure)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Invalid schedule", result.Error);
            return;
        }
        NotificationService.Notify(NotificationSeverity.Success, "Schedule saved",
            scheduleEnabled ? "Automatic sync rescheduled." : "Automatic sync disabled.");
    }

    private async Task LoadAsync()
    {
        var apiAccounts = (
            await QuerySession
                .Query<Account>()
                .Where(a => a.SyncMethod == SyncMethod.Api && a.Status == AccountStatus.Active)
                .ToListAsync()
        )
            .OrderBy(a => a.Name)
            .ToList();

        var rows = new List<AccountRow>(apiAccounts.Count);
        foreach (var account in apiAccounts)
        {
            var lastBatch = await QuerySession
                .Query<ImportBatch>()
                .Where(b => b.AccountId == account.Id)
                .OrderByDescending(b => b.ImportedAt)
                .FirstOrDefaultAsync();
            rows.Add(new AccountRow(account.Id, account.Name, account.Provider, lastBatch?.ImportedAt));
        }
        accounts = rows;

        var connections = await QuerySession.Query<ProviderConnection>().ToListAsync();
        expiringConnections = connections
            .Where(c => c.UsesEnableBanking
                && c.ConsentStatus == ConsentStatus.Authorized
                && (c.ConsentExpired || c.ConsentExpiresAt <= DateTimeOffset.UtcNow.AddDays(14)))
            .ToList();
    }

    private async Task<string?> CurrentUserAsync() =>
        AuthenticationState is null ? null : (await AuthenticationState).User.Identity?.Name;

    private async Task SyncOneAsync(Guid accountId)
    {
        isSyncing = true;
        try
        {
            var summary = await SyncService.SyncAccountAsync(accountId, await CurrentUserAsync());
            NotifySummary(summary);
            await LoadAsync();
        }
        finally
        {
            isSyncing = false;
        }
    }

    private async Task SyncAllAsync()
    {
        isSyncing = true;
        try
        {
            var summaries = await SyncService.SyncAllAsync(await CurrentUserAsync());
            foreach (var summary in summaries)
            {
                NotifySummary(summary);
            }
            await LoadAsync();
        }
        finally
        {
            isSyncing = false;
        }
    }

    private void NotifySummary(AccountSyncSummary summary)
    {
        if (summary.IsFailure)
        {
            NotificationService.Notify(NotificationSeverity.Warning, $"{summary.AccountName} not synced", summary.Error);
        }
        else
        {
            NotificationService.Notify(NotificationSeverity.Success, $"{summary.AccountName} synced",
                $"{summary.Imported} imported, {summary.Duplicates} duplicates.");
        }
    }
}
