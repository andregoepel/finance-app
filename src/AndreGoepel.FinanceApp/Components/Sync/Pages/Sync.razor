@page "/sync"
@attribute [Authorize]
@rendermode InteractiveServer

@inject IQuerySession QuerySession
@inject IAccountSyncService SyncService
@inject ISyncScheduleService ScheduleService
@inject NotificationService NotificationService
@inject IStringLocalizer<Strings> L

<AppPageTitle Title="@L["Nav.Sync"]" />

<PageBody>

    <PageHeader Title="@L["Nav.Sync"]">
        <Actions>
            <RadzenButton Text="@L["Sync.SyncAllNow"]" Icon="sync" ButtonStyle="ButtonStyle.Primary"
                          Disabled=@(isSyncing || accounts.Count == 0) IsBusy=@isSyncing BusyText="@L["Sync.SyncingBusyText"]"
                          Click=@SyncAllAsync />
        </Actions>
    </PageHeader>

    <RadzenText TextStyle="TextStyle.Body1" Style="color: var(--rz-text-secondary-color);">
        @L["Sync.Intro"]
        <RadzenLink Path="settings/connections" Text="@L["Sync.SettingsConnectionsLink"]" />.
    </RadzenText>

    @if (expiringConnections.Count > 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" ShowIcon="true" AllowClose="false">
            @L["Sync.ConsentAttentionNeeded"]
            @string.Join(", ", expiringConnections.Select(c => $"{c.Label} ({(c.ConsentExpired ? L["Sync.ConsentExpired"] : L["Sync.ConsentExpiresOn", Dates.Short(c.ConsentExpiresAt!.Value.ToLocalTime())])})")).
        </RadzenAlert>
    }

    @* ---------- Automatic schedule ---------- *@
    <SectionCard Title="@L["Sync.AutomaticScheduleTitle"]">
        <Actions>
            <RadzenSwitch @bind-Value=@scheduleEnabled />
            <RadzenLabel Text="@(scheduleEnabled ? L["Common.Enabled"] : L["Common.Disabled"])" />
        </Actions>
        <ChildContent>
            <RadzenStack Gap="1rem">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.End" Wrap="FlexWrap.Wrap">
                    <FormField Label="@L["Sync.CronLabel"]" For="Cron">
                        <RadzenTextBox @bind-Value=@cronInput Name="Cron" Disabled=@(!scheduleEnabled) Style="min-width: 16rem; font-family: monospace;" />
                    </FormField>
                    <RadzenButton Text="@L["Sync.SaveScheduleButton"]" Icon="save" ButtonStyle="ButtonStyle.Primary" Click=@SaveScheduleAsync />
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">@L["Sync.PresetsLabel"]</RadzenText>
                    @foreach (var preset in CronPresets)
                    {
                        <RadzenButton Text="@preset.Label" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall"
                                      Disabled=@(!scheduleEnabled) Click=@(() => cronInput = preset.Cron) />
                    }
                </RadzenStack>
                <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary-color);">
                    @if (!scheduleEnabled)
                    {
                        <span>@L["Sync.OffPrompt", L["Sync.SyncAllNow"]]</span>
                    }
                    else if (ScheduleService.NextRun(cronInput) is DateTimeOffset next)
                    {
                        <span>@L["Sync.NextRun", Dates.Long(next.ToLocalTime())]</span>
                    }
                    else
                    {
                        <span style="color: var(--rz-danger);">@L["Sync.InvalidCronExpression"]</span>
                    }
                </RadzenText>
            </RadzenStack>
        </ChildContent>
    </SectionCard>

    @if (accounts.Count == 0)
    {
        <EmptyState Icon="@("🔄")" Title="@L["Sync.EmptyTitle"]" Text="@L["Sync.EmptyText", L["Nav.Accounts"]]" />
    }
    else
    {
        <DataCard>
            <RadzenDataGrid TItem="AccountRow" Data=@accounts Density="Density.Compact">
                <Columns>
                    <RadzenDataGridColumn TItem="AccountRow" Title="@L["Common.Account"]" Property="Name" />
                    <RadzenDataGridColumn TItem="AccountRow" Title="@L["Common.Provider"]" Width="120px">
                        <Template Context="row">@row.Provider</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AccountRow" Title="@L["Sync.ColLastSync"]" Width="200px">
                        <Template Context="row">
                            @(row.LastSync is null ? L["Sync.NeverSynced"] : Dates.ShortTime(row.LastSync.Value.ToLocalTime()))
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AccountRow" Title="" Width="240px" TextAlign="TextAlign.End" Sortable="false">
                        <Template Context="row">
                            <RowActions>
                                <RadzenButton Text="@L["Sync.FullSyncButton"]" Icon="history" Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Light" Disabled=@isSyncing
                                              title="@L["Sync.FullSyncTooltip"]"
                                              Click=@(() => SyncOneAsync(row.Id, fullHistory: true)) />
                                <RadzenButton Text="@L["Sync.SyncNowButton"]" Icon="sync" Size="ButtonSize.Small"
                                              ButtonStyle="ButtonStyle.Secondary" Disabled=@isSyncing
                                              Click=@(() => SyncOneAsync(row.Id)) />
                            </RowActions>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </DataCard>
    }

</PageBody>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    private sealed record AccountRow(Guid Id, string Name, ProviderKind Provider, DateTimeOffset? LastSync);

    private List<AccountRow> accounts = [];
    private List<ProviderConnection> expiringConnections = [];
    private bool isSyncing;

    private string cronInput = "0 0 3 * * ?";
    private bool scheduleEnabled = true;

    // Instance property (not static) since the labels are localized via the injected L.
    private (string Label, string Cron)[] CronPresets =>
    [
        (L["Sync.PresetDaily3am"], "0 0 3 * * ?"),
        (L["Sync.PresetDaily6am"], "0 0 6 * * ?"),
        (L["Sync.PresetEvery6Hours"], "0 0 0/6 * * ?"),
        (L["Sync.PresetHourly"], "0 0 * * * ?"),
    ];

    protected override async Task OnInitializedAsync()
    {
        var schedule = await ScheduleService.GetAsync();
        cronInput = schedule.CronExpression;
        scheduleEnabled = schedule.Enabled;
        await LoadAsync();
    }

    private async Task SaveScheduleAsync()
    {
        var result = await ScheduleService.UpdateAsync(cronInput, scheduleEnabled);
        if (result.IsFailure)
        {
            NotificationService.Error(L["Sync.InvalidScheduleTitle"], result.Error);
            return;
        }
        NotificationService.Success(
            L["Sync.ScheduleSavedTitle"],
            scheduleEnabled ? L["Sync.RescheduledMessage"] : L["Sync.DisabledMessage"]
        );
    }

    private async Task LoadAsync()
    {
        var apiAccounts = (
            await QuerySession
                .Query<Account>()
                .Where(a => a.SyncMethod == SyncMethod.Api && a.Status == AccountStatus.Active)
                .ToListAsync()
        )
            .OrderBy(a => a.Name)
            .ToList();

        var rows = new List<AccountRow>(apiAccounts.Count);
        foreach (var account in apiAccounts)
        {
            var lastBatch = await QuerySession
                .Query<ImportBatch>()
                .Where(b => b.AccountId == account.Id)
                .OrderByDescending(b => b.ImportedAt)
                .FirstOrDefaultAsync();
            rows.Add(new AccountRow(account.Id, account.Name, account.Provider, lastBatch?.ImportedAt));
        }
        accounts = rows;

        var connections = await QuerySession.Query<ProviderConnection>().ToListAsync();
        expiringConnections = connections
            .Where(c => c.UsesEnableBanking
                && c.ConsentStatus == ConsentStatus.Authorized
                && (c.ConsentExpired || c.ConsentExpiresAt <= DateTimeOffset.UtcNow.AddDays(14)))
            .ToList();
    }

    private async Task<string?> CurrentUserAsync() =>
        AuthenticationState is null ? null : (await AuthenticationState).User.Identity?.Name;

    private async Task SyncOneAsync(Guid accountId, bool fullHistory = false)
    {
        isSyncing = true;
        try
        {
            var summary = await SyncService.SyncAccountAsync(
                accountId,
                await CurrentUserAsync(),
                fullHistory
            );
            NotifySummary(summary);
            await LoadAsync();
        }
        finally
        {
            isSyncing = false;
        }
    }

    private async Task SyncAllAsync()
    {
        isSyncing = true;
        try
        {
            var summaries = await SyncService.SyncAllAsync(await CurrentUserAsync());
            foreach (var summary in summaries)
            {
                NotifySummary(summary);
            }
            await LoadAsync();
        }
        finally
        {
            isSyncing = false;
        }
    }

    private void NotifySummary(AccountSyncSummary summary)
    {
        if (summary.IsFailure)
        {
            NotificationService.Warning(
                L["Sync.AccountNotSyncedTitle", summary.AccountName],
                summary.Error
            );
        }
        else
        {
            NotificationService.Success(
                L["Sync.AccountSyncedTitle", summary.AccountName],
                L["Sync.SyncedMessage", summary.Imported, summary.Duplicates]
            );
        }
    }
}
