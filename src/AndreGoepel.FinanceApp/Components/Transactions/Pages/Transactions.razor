@page "/transactions"
@attribute [Authorize]
@using AndreGoepel.Marten.Identity.Users
@using Microsoft.AspNetCore.Identity

@inject IQuerySession QuerySession
@inject IMessageBus MessageBus
@inject NotificationService NotificationService
@inject UserManager<User> UserManager
@inject IStringLocalizer<Strings> L
@implements IDisposable

<AppPageTitle Title="@L["Nav.Transactions"]" />

<PageBody>

    <PageHeader Title="@L["Nav.Transactions"]" />

    @if (ruleOffer is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Info" ShowIcon="true" AllowClose="true" Close=@(() => ruleOffer = null)>
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" Wrap="FlexWrap.Wrap">
                <span>
                    @L["Transactions.RuleOfferPrefix"] <strong>@ruleOffer.Counterparty</strong>
                    @L["Transactions.RuleOfferInfix"] <strong>@ruleOffer.CategoryLabel</strong>@L["Transactions.RuleOfferSuffix"]
                </span>
                <RadzenButton Text="@L["Transactions.CreateRule"]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Primary" Click=@CreateRuleFromOfferAsync />
                <RadzenButton Text="@L["Common.No"]" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click=@(() => ruleOffer = null) />
            </RadzenStack>
        </RadzenAlert>
    }

    <FilterBar OnApply="@(() => ReloadAsync(resetPage: true))" ApplyText="@L["Common.Apply"]" ApplyStyle="ButtonStyle.Primary">
        <ChildContent>
            <FormField Label="@L["Common.Account"]" For="Account">
                <RadzenDropDown TValue="Guid?"
                                @bind-Value=@accountFilter Name="Account"
                                Data=@accounts
                                TextProperty="Name"
                                ValueProperty="Id"
                                AllowClear="true"
                                Placeholder="@L["Common.AllPlaceholder"]"
                                Style="min-width: 12rem;"
                                Change=@(_ => ReloadAsync(resetPage: true)) />
            </FormField>
            <FormField Label="@L["Common.Owner"]" For="Owner">
                <RadzenDropDown TValue="Guid?"
                                @bind-Value=@ownerFilter Name="Owner"
                                Data=@users
                                ValueProperty="StreamId"
                                TextProperty="UserName"
                                AllowClear="true"
                                Placeholder="@L["Common.AllPlaceholder"]"
                                Style="min-width: 12rem;"
                                Change=@(_ => ReloadAsync(resetPage: true)) />
            </FormField>
            <FormField Label="@L["Dashboard.ColCategory"]" For="Category">
                <CategoryPicker Options="@categoryFilterOptions" Name="Category"
                                Value="@categoryFilter"
                                ValueChanged="@(v => { categoryFilter = v; return ReloadAsync(resetPage: true); })"
                                Placeholder="@L["Common.AllPlaceholder"]" Style="min-width: 13rem;" />
            </FormField>
            <FormField Label="@L["Common.From"]" For="From">
                <RadzenDatePicker TValue="DateOnly?" @bind-Value=@fromFilter Name="From" DateFormat="@Dates.ShortFormat" Change=@(_ => ReloadAsync(resetPage: true)) />
            </FormField>
            <FormField Label="@L["Common.To"]" For="To">
                <RadzenDatePicker TValue="DateOnly?" @bind-Value=@toFilter Name="To" DateFormat="@Dates.ShortFormat" Change=@(_ => ReloadAsync(resetPage: true)) />
            </FormField>
            <FormField Label="@L["Common.Search"]" For="Search">
                <RadzenTextBox @bind-Value=@textFilter Name="Search" Placeholder="@L["Transactions.SearchPlaceholder"]" Style="min-width: 14rem;"
                               Change=@(_ => ReloadAsync(resetPage: true)) />
            </FormField>
        </ChildContent>
        <Actions>
            <RadzenButton Text="@L["Transactions.LinkAsTransfer"]"
                          Icon="sync_alt"
                          ButtonStyle="ButtonStyle.Light"
                          Disabled=@(selected.Count != 2)
                          Click=@LinkSelectedAsTransferAsync />
        </Actions>
    </FilterBar>

    <RadzenDataGrid TItem="TransactionView"
                    @ref="grid"
                    Data=@transactions
                    AllowPaging="true"
                    PageSize="25"
                    AllowSorting="true"
                    SelectionMode="DataGridSelectionMode.Multiple"
                    @bind-Value=@selected
                    Density="Density.Compact">
        <Columns>
            <RadzenDataGridColumn TItem="TransactionView" Property="BookingDate" Title="@L["Common.Date"]" Width="110px">
                <Template Context="transaction">@Dates.Short(transaction.BookingDate)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="TransactionView" Title="@L["Common.Account"]" Width="140px" Sortable="false">
                <Template Context="transaction">@AccountName(transaction.AccountId)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="TransactionView" Property="Counterparty" Title="@L["Common.Counterparty"]" Width="190px" />
            <RadzenDataGridColumn TItem="TransactionView" Property="Description" Title="@L["Common.Description"]" />
            <RadzenDataGridColumn TItem="TransactionView" Property="Amount" Title="@L["Common.Amount"]" Width="130px" TextAlign="TextAlign.Right">
                <Template Context="transaction">
                    <AmountText Amount="transaction.Amount" Currency="@transaction.Currency" />
                    @if (transaction.OriginalAmount is not null)
                    {
                        <div style="font-size: 0.75rem; color: var(--rz-text-disabled-color);">
                            @transaction.OriginalAmount.Value.ToString("N2") @transaction.OriginalCurrency
                        </div>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="TransactionView" Title="@L["Dashboard.ColCategory"]" Width="260px" Sortable="false">
                <Template Context="transaction">
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" AlignItems="AlignItems.Center">
                        @if (transaction.CategoryLines.Count > 1)
                        {
                            <StatusBadge Variant="BadgeVariant.Neutral"
                                         Text="@L["Transactions.SplitBadge", transaction.CategoryLines.Count]" />
                        }
                        else
                        {
                            <CategoryPicker Options="@categoryOptions"
                                            Value="@transaction.CategoryId"
                                            ValueChanged="@(v => CategorizeAsync(transaction, v))"
                                            AllowClear="false"
                                            Placeholder="@L["Transactions.UncategorizedPlaceholder"]" />
                        }
                        <IconButton Icon="call_split"
                                    Title="@(transaction.CategoryLines.Count > 1 ? L["Transactions.EditSplitTooltip"] : L["Transactions.SplitTooltip"])"
                                    Click=@(_ => StartSplit(transaction)) />
                    </RadzenStack>
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="TransactionView" Title="" Width="110px" Sortable="false">
                <Template Context="transaction">
                    @if (transaction.IsTransfer)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" AlignItems="AlignItems.Center">
                            <StatusBadge Variant="BadgeVariant.Info" Text="@L["Transactions.TransferBadge"]" />
                            <IconButton Icon="link_off" Title="@L["Transactions.UnlinkTransfer"]"
                                        Click=@(_ => UnlinkTransferAsync(transaction)) />
                        </RadzenStack>
                    }
                    else if (transaction.CategorySource is not null)
                    {
                        <StatusBadge Variant="BadgeVariant.Neutral" Text="@L[$"Enum.CategorySource.{transaction.CategorySource}"]" />
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>

    @if (splitting is not null)
    {
        <SectionCard Title="@L["Transactions.SplitTitle"]">
            <RadzenStack Gap="0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                    <span>@splitting.Description</span>
                    <AmountText Amount="splitting.Amount" Currency="@splitting.Currency" />
                </RadzenStack>
                @foreach (var line in splitLines)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem" AlignItems="AlignItems.Center">
                        <CategoryPicker Options="@categoryOptions" Name="SplitCategory"
                                        @bind-Value=@line.CategoryId
                                        AllowClear="false"
                                        Placeholder="@L["Dashboard.ColCategory"]" Style="min-width: 15rem;" />
                        <RadzenNumeric TValue="decimal" @bind-Value=@line.Amount Style="width: 9rem;" />
                        <IconButton Icon="delete" Title="@L["Common.Delete"]" Click=@(_ => splitLines.Remove(line)) />
                    </RadzenStack>
                }
                <RadzenStack Orientation="Orientation.Horizontal" Gap="1rem" AlignItems="AlignItems.Center">
                    <RadzenButton Text="@L["Transactions.AddSplitLine"]" Icon="add" ButtonStyle="ButtonStyle.Light"
                                  Click=@(() => splitLines.Add(new SplitLine())) />
                    <span>@L["Transactions.SplitRemaining"]: <AmountText Amount="SplitRemaining" Currency="@splitting.Currency" /></span>
                </RadzenStack>
                <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                    <RadzenButton Text="@L["Common.Save"]" Icon="save" ButtonStyle="ButtonStyle.Primary"
                                  Disabled="@(!CanSaveSplit)" Click=@SaveSplitAsync />
                    <RadzenButton Text="@L["Common.Cancel"]" ButtonStyle="ButtonStyle.Light" Click=@(() => splitting = null) />
                </RadzenStack>
            </RadzenStack>
        </SectionCard>
    }

</PageBody>

@code {
    private const int MaxRows = 1000;

    /// <summary>Sentinel id for the "Uncategorized" entry in <see cref="categoryFilterOptions"/> — never a real category id, so it can't collide.</summary>
    private static readonly Guid UncategorizedFilterId = Guid.Empty;

    private readonly CancellationTokenSource _cts = new();

    private RadzenDataGrid<TransactionView> grid = null!;

    private List<Account> accounts = [];
    private IReadOnlyList<User> users = [];
    private List<CategoryOption> categoryOptions = [];
    private List<CategoryOption> categoryFilterOptions = [];
    private List<TransactionView> transactions = [];
    private IList<TransactionView> selected = [];

    private RuleOffer? ruleOffer;
    private TransactionView? splitting;
    private List<SplitLine> splitLines = [];
    private Guid? accountFilter;
    private Guid? ownerFilter;
    private Guid? categoryFilter;
    private DateOnly? fromFilter;
    private DateOnly? toFilter;
    private string textFilter = "";

    protected override async Task OnInitializedAsync()
    {
        accounts = (await QuerySession.Query<Account>().ToListAsync(_cts.Token)).OrderBy(a => a.Name).ToList();
        users = await UserManager
            .Users.Where(u => !u.Deleted)
            .OrderBy(u => u.UserName)
            .ToListAsync(_cts.Token);
        var categories = await QuerySession.Query<Category>().ToListAsync(_cts.Token);
        categoryOptions = CategoryPaths.Build(categories);
        categoryFilterOptions =
        [
            new CategoryOption(UncategorizedFilterId, L["Transactions.CategoryFilterUncategorizedOption"]),
            .. categoryOptions,
        ];
        await ReloadAsync();
    }

    private async Task ReloadAsync(bool resetPage = false)
    {
        var page = resetPage ? 0 : (grid?.CurrentPage ?? 0);

        var accountIds = FilteredAccountIds();
        var query = QuerySession.Query<TransactionView>().Where(t => t.AccountId.IsOneOf(accountIds));
        if (categoryFilter == UncategorizedFilterId)
        {
            query = query.Where(t => !t.IsCategorized);
        }
        else if (categoryFilter is Guid categoryId)
        {
            query = query.Where(t =>
                t.CategoryId == categoryId || t.CategoryLines.Any(l => l.CategoryId == categoryId)
            );
        }
        if (fromFilter is DateOnly from)
        {
            query = query.Where(t => t.BookingDate >= from);
        }
        if (toFilter is DateOnly to)
        {
            query = query.Where(t => t.BookingDate <= to);
        }

        var loaded = await query.OrderByDescending(t => t.BookingDate).Take(MaxRows).ToListAsync(_cts.Token);

        if (!string.IsNullOrWhiteSpace(textFilter))
        {
            var needle = textFilter.Trim();
            loaded = loaded
                .Where(t =>
                    t.Description.Contains(needle, StringComparison.OrdinalIgnoreCase)
                    || (t.Counterparty?.Contains(needle, StringComparison.OrdinalIgnoreCase) ?? false))
                .ToList();
        }

        transactions = loaded.ToList();
        selected = [];

        if (grid is not null)
        {
            await grid.GoToPage(page);
        }
    }

    private Guid[] FilteredAccountIds()
    {
        var candidates = accounts.AsEnumerable();
        if (ownerFilter is Guid owner)
        {
            candidates = candidates.Where(a => a.OwnerUserIds.Contains(owner));
        }
        if (accountFilter is Guid accountId)
        {
            candidates = candidates.Where(a => a.Id == accountId);
        }
        return candidates.Select(a => a.Id).ToArray();
    }

    private string AccountName(Guid accountId) =>
        accounts.FirstOrDefault(a => a.Id == accountId)?.Name ?? "?";

    private async Task CategorizeAsync(TransactionView transaction, Guid? categoryId)
    {
        if (categoryId is not Guid newCategoryId || newCategoryId == transaction.CategoryId)
        {
            return;
        }

        var result = await MessageBus.InvokeAsync<Result>(
            new CategorizeTransactionCommand(transaction.Id, newCategoryId),
            _cts.Token
        );
        if (result.IsFailure)
        {
            NotificationService.Error(L["Transactions.CategorizationFailedTitle"], result.Error);
            return;
        }

        // Corrections feed rule learning: offer a counterparty rule so the next
        // import categorizes this merchant without the AI.
        if (!string.IsNullOrWhiteSpace(transaction.Counterparty))
        {
            var label = categoryOptions.FirstOrDefault(c => c.Id == newCategoryId)?.Path ?? "?";
            ruleOffer = new RuleOffer(transaction.Counterparty, newCategoryId, label);
        }

        await ReloadAsync();
    }

    private void StartSplit(TransactionView transaction)
    {
        splitting = transaction;
        splitLines =
            transaction.CategoryLines.Count > 1
                ? transaction
                    .CategoryLines.Select(l => new SplitLine
                    {
                        CategoryId = l.CategoryId,
                        Amount = l.Amount,
                    })
                    .ToList()
                : [new SplitLine { CategoryId = transaction.CategoryId, Amount = transaction.Amount }, new()];
    }

    private decimal SplitRemaining => (splitting?.Amount ?? 0) - splitLines.Sum(l => l.Amount);

    private bool CanSaveSplit =>
        splitting is not null
        && splitLines.Count >= 2
        && splitLines.All(l => l.CategoryId is not null && l.Amount != 0)
        && SplitRemaining == 0;

    private async Task SaveSplitAsync()
    {
        if (splitting is null || !CanSaveSplit)
        {
            return;
        }

        var lines = splitLines
            .Select(l => new CategoryLine(l.CategoryId!.Value, l.Amount))
            .ToList();
        var result = await MessageBus.InvokeAsync<Result>(
            new SplitTransactionCategoryCommand(splitting.Id, lines),
            _cts.Token
        );
        if (result.IsFailure)
        {
            NotificationService.Error(L["Transactions.SplitFailedTitle"], result.Error);
            return;
        }

        NotificationService.Success(L["Transactions.SplitSavedTitle"], L["Transactions.SplitSavedMessage"]);
        splitting = null;
        await ReloadAsync();
    }

    private sealed class SplitLine
    {
        public Guid? CategoryId { get; set; }
        public decimal Amount { get; set; }
    }

    private async Task CreateRuleFromOfferAsync()
    {
        if (ruleOffer is null)
        {
            return;
        }

        var result = await MessageBus.InvokeAsync<Result<Domain.Categories.CategoryRule>>(
            new CreateCategoryRuleCommand(
                ruleOffer.CategoryId,
                ruleOffer.Counterparty,
                DescriptionContains: null,
                MinAmount: null,
                MaxAmount: null,
                CategoryRuleSource.LearnedFromCorrection
            ),
            _cts.Token
        );
        if (result.IsFailure)
        {
            NotificationService.Error(L["Transactions.RuleCreationFailedTitle"], result.Error);
        }
        else
        {
            NotificationService.Success(
                L["Transactions.RuleCreatedTitle"],
                $"'{ruleOffer.Counterparty}' → {ruleOffer.CategoryLabel}"
            );
        }
        ruleOffer = null;
    }

    private async Task LinkSelectedAsTransferAsync()
    {
        if (selected.Count != 2)
        {
            return;
        }

        var result = await MessageBus.InvokeAsync<Result>(
            new LinkTransactionsAsTransferCommand(selected[0].Id, selected[1].Id),
            _cts.Token
        );
        if (result.IsFailure)
        {
            NotificationService.Error(L["Transactions.LinkingFailedTitle"], result.Error);
            return;
        }
        NotificationService.Success(L["Transactions.LinkedTitle"], L["Transactions.LinkedMessage"]);
        await ReloadAsync();
    }

    private async Task UnlinkTransferAsync(TransactionView transaction)
    {
        var result = await MessageBus.InvokeAsync<Result>(
            new UnlinkTransferCommand(transaction.Id),
            _cts.Token
        );
        if (result.IsFailure)
        {
            NotificationService.Error(L["Transactions.UnlinkingFailedTitle"], result.Error);
            return;
        }
        await ReloadAsync();
    }

    private sealed record RuleOffer(string Counterparty, Guid CategoryId, string CategoryLabel);

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
