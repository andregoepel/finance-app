<Project Sdk="Aspire.AppHost.Sdk/13.3.5">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>3c9a7d21-5b84-4f0e-a1d6-7e8f9b0c1d2e</UserSecretsId>
    <!-- Opt out of lockfile management: the Aspire AppHost pulls RID-specific
         packages (Aspire.Dashboard.Sdk.<rid>, DCP.<rid>) so its lock would differ
         between Windows dev and Linux CI. It is dev-only orchestration and never
         shipped, so it is excluded from the locked-mode restore. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Docker" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FinanceApp\FinanceApp.csproj" />
  </ItemGroup>
</Project>
