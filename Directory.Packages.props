<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="AndreGoepel">
    <PackageVersion Include="AndreGoepel.AppFoundation" Version="2.1.0" />
    <PackageVersion Include="AndreGoepel.AppFoundation.Aspire" Version="2.1.0" />
    <PackageVersion Include="AndreGoepel.AppFoundation.Hosting" Version="2.1.0" />
    <PackageVersion Include="AndreGoepel.Core" Version="1.0.2" />
    <PackageVersion Include="AndreGoepel.Design.Blazor" Version="1.6.4" />
    <PackageVersion Include="AndreGoepel.Marten.Configuration" Version="1.2.1" />
    <PackageVersion Include="AndreGoepel.Marten.Identity.Blazor" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup Label="AndreGoepel Testing">
    <PackageVersion Include="AndreGoepel.Testing.Bunit" Version="1.2.0" />
    <PackageVersion Include="AndreGoepel.Testing.E2E" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.5.2" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.5.2" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="13.5.2" />
  </ItemGroup>

  <ItemGroup Label="Libraries">
    <PackageVersion Include="Marten" Version="9.29.0" />
    <PackageVersion Include="WolverineFx.Marten" Version="6.29.2" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="3.19.1" />
    <PackageVersion Include="Radzen.Blazor" Version="11.2.6" />
    <PackageVersion
      Include="Microsoft.Extensions.DependencyInjection.Abstractions"
      Version="10.0.11"
    />
    <PackageVersion Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.11" />
    <PackageVersion
      Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets"
      Version="1.23.0"
    />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="AndreGoepel.Marten.Testing" Version="1.2.0" />
    <PackageVersion Include="bunit" Version="2.9.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>
</Project>
